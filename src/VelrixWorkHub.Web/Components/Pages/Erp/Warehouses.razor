@page "/Erp/Warehouse"
@inject VelrixWorkHub.Application.Warehouses.WarehouseService WarehouseService
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@using VelrixWorkHub.Application.MasterData
@using VelrixWorkHub.Domain
<PageTitle>仓库与库位 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/Warehouse</p><h1>仓库与库位</h1><p class="task-page__intro">建立库存单据可引用的仓库和库位边界，先打通基础主数据。</p></div></div><section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索仓库" @bind="Keyword" @bind:event="oninput" placeholder="搜索仓库编码或名称" /></div><select aria-label="筛选仓库状态" @bind="StatusFilterText"><option value="">全部状态</option><option value="Active">启用</option><option value="Inactive">停用</option></select><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建仓库</button></section>
@if(ShowComposer||Editing is not null){<section class="task-composer" aria-label="仓库编辑"><div class="task-composer__title">@(Editing is null?"录入仓库":"编辑仓库")</div><div class="task-composer__fields"><label>仓库编码<input @bind="Code" @bind:event="oninput" placeholder="WH-002" /></label><label>仓库名称<input @bind="Name" @bind:event="oninput" placeholder="华南仓" /></label></div><label>地址<input @bind="Address" @bind:event="oninput" placeholder="仓库地址" /></label>@if(Error is not null){<div class="task-error" role="alert">@Error</div>}<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存仓库</button></div></section>}
@if(CapacityWarehouse is not null && CapacityLocation is not null){<section class="task-composer" aria-label="库位商品容量"><div class="task-composer__title">库位商品容量 · @CapacityWarehouse.Code / @CapacityLocation.Code</div><p class="task-page__intro">容量按“库位 + 商品”独立限制，不混合不同单位的商品；超出时入库、调入和正向盘点会被服务端拒绝。</p><div class="task-composer__fields"><label>商品<select @bind="CapacityProductIdText"><option value="">请选择商品</option>@foreach(var product in ProductService.List(status:ProductStatus.Active)){<option value="@product.Id">@product.Code · @product.Name（@product.Unit）</option>}</select></label><label>最大库存数量<input type="number" min="0.01" step="0.01" @bind="CapacityQuantity" /></label></div>@if(Error is not null){<div class="task-error" role="alert">@Error</div>}<div class="task-composer__actions"><button class="task-secondary-button" @onclick="CloseCapacity">取消</button><button class="task-primary-button" @onclick="SaveCapacity">保存容量</button></div></section>}
<section class="task-list">@foreach(var item in WarehouseService.List(Keyword, SelectedStatus())){var impact=Impact(item);<article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-building-o"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@(item.Status==WarehouseStatus.Active?"active":"inactive")">@(item.Status==WarehouseStatus.Active?"启用":"停用")</span><span>@item.Code</span></div><h2>@item.Name</h2><p>@(item.Address??"未填写地址") · @item.Locations.Count 个库位</p><div class="customer-note">@string.Join("、", item.Locations.Select(x=>$"{x.Code} {x.Name}"))</div>@foreach(var location in item.Locations){<div class="customer-note">@location.Code 容量：@(location.ProductCapacities.Count == 0 ? "未配置" : string.Join("；", location.ProductCapacities.Select(capacity => $"{ProductService.List().FirstOrDefault(product => product.Id == capacity.ProductId)?.Name ?? "已删除商品"} ≤ {capacity.MaxQuantity:N2}"))) <button class="task-secondary-button" @onclick="()=>OpenCapacity(item,location)">配置</button></div>}<div class="customer-note">引用：<a href="/Erp/Inventory?warehouseId=@item.Id" title="查看 @item.Name 的库存流水">库存流水 @impact.InventoryTransactionReferenceCount</a> · <a href="/Erp/Inventory?warehouseId=@item.Id" title="查看 @item.Name 的账面库存">账面库存 @impact.OnHandQuantity.ToString("N2")</a></div></div><div class="task-card__actions"><button title="编辑仓库" @onclick="()=>OpenEditor(item)"><i class="fa fa-pencil"></i></button><button title="切换状态" @onclick="()=>WarehouseService.SetActive(item,item.Status!=WarehouseStatus.Active)"><i class="fa fa-toggle-@(item.Status==WarehouseStatus.Active?"on":"off")"></i></button><button class="danger" title="@(impact.HasReferences?"仓库有历史引用，不能删除":"删除仓库")" disabled="@impact.HasReferences" @onclick="()=>WarehouseService.Remove(item)"><i class="fa fa-trash-o"></i></button></div></article>}</section></div>
@code { private string Keyword="",StatusFilterText="",Code="",Name="",Address="",CapacityProductIdText="",CapacityQuantity=""; private string? Error; private bool ShowComposer; private Warehouse? Editing; private Warehouse? CapacityWarehouse; private WarehouseLocation? CapacityLocation; private WarehouseStatus? SelectedStatus()=>Enum.TryParse<WarehouseStatus>(StatusFilterText,out var status)?status:null; private void OpenComposer(){Close();ShowComposer=true;} private void OpenEditor(Warehouse x){Close();Editing=x;Code=x.Code;Name=x.Name;Address=x.Address??"";} private void Close(){ShowComposer=false;Editing=null;Error=null;Code=Name=Address="";} private void Save(){try{if(Editing is null)WarehouseService.Create(Code,Name,Address,"{}");else WarehouseService.Edit(Editing,Code,Name,Address,Editing.OtherInfo);Close();}catch(Exception ex){Error=ex.Message;}} private void OpenCapacity(Warehouse warehouse,WarehouseLocation location){Close();CapacityWarehouse=warehouse;CapacityLocation=location;CapacityProductIdText="";CapacityQuantity="";} private void CloseCapacity(){CapacityWarehouse=null;CapacityLocation=null;CapacityProductIdText=CapacityQuantity="";Error=null;} private void SaveCapacity(){try{if(CapacityWarehouse is null||CapacityLocation is null||!Guid.TryParse(CapacityProductIdText,out var productId)||!decimal.TryParse(CapacityQuantity,out var maxQuantity))throw new InvalidOperationException("请选择商品并填写有效的最大库存数量。"); WarehouseService.SetLocationProductCapacity(CapacityWarehouse,CapacityLocation.Id,productId,maxQuantity);CloseCapacity();}catch(Exception ex){Error=ex.Message;}} }
@code { private WarehouseMasterDataImpact Impact(Warehouse item) => MasterDataImpactService.Warehouse(item.Id, InventoryService.List()); }
