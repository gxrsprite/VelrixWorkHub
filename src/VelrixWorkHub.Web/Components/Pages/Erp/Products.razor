@page "/Erp/Product"
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.PurchaseOrders.PurchaseOrderService PurchaseOrderService
@inject VelrixWorkHub.Application.SalesOrders.SalesOrderService SalesOrderService
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@using VelrixWorkHub.Application.MasterData
@using VelrixWorkHub.Domain
<PageTitle>商品主数据 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/Product</p><h1>商品主数据</h1><p class="task-page__intro">统一维护商品编码、名称、计量单位、参考售价和安全库存，供采购、销售、库存单据及首页风险提醒引用。</p></div></div>
<section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search" aria-hidden="true"></i><input aria-label="搜索商品" @bind="Keyword" @bind:event="oninput" placeholder="搜索编码或商品名称" /></div><select aria-label="筛选商品状态" @bind="StatusFilterText"><option value="">全部状态</option><option value="Active">启用</option><option value="Inactive">停用</option></select><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建商品</button></section>
@if (ShowComposer || Editing is not null) { <section class="task-composer" aria-label="商品编辑"><div class="task-composer__title">@(Editing is null ? "录入商品" : "编辑商品")</div><div class="task-composer__fields"><label>商品编码<input @bind="Code" @bind:event="oninput" placeholder="SKU-1002" /></label><label>商品名称<input @bind="Name" @bind:event="oninput" placeholder="商品名称" /></label></div><div class="task-composer__fields"><label>计量单位<input @bind="Unit" @bind:event="oninput" placeholder="件、套、箱" /></label><label>参考售价<input @bind="PriceText" @bind:event="oninput" placeholder="0.00" inputmode="decimal" /></label></div><div class="task-composer__fields"><label>单次最大采购量<input aria-label="单次最大采购量" @bind="MaxPurchaseQuantityText" @bind:event="oninput" placeholder="不限制" inputmode="decimal" /></label><label>安全库存<input aria-label="安全库存" @bind="SafetyStockText" @bind:event="oninput" placeholder="不启用提醒" inputmode="decimal" /></label></div><div class="customer-note">安全库存大于 0 且账面库存低于该值时，首页 ERP 待办会提醒；留空表示不启用。</div><label>备注<textarea @bind="Notes" @bind:event="oninput" rows="2"></textarea></label><label>扩展信息 OtherInfo JSON 对象<textarea @bind="OtherInfo" @bind:event="oninput" rows="2"></textarea></label>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存商品</button></div></section> }
<section class="task-list" aria-live="polite">@foreach (var item in ProductService.List(Keyword, SelectedStatus())) { var impact = Impact(item); <article class="task-card customer-card"><div class="customer-avatar">@item.Name.FirstOrDefault()</div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@(item.Status == ProductStatus.Active ? "active" : "inactive")">@(item.Status == ProductStatus.Active ? "启用" : "停用")</span><span>@item.Code</span></div><h2>@item.Name</h2><p>单位：@item.Unit · 参考售价：@(item.SalePrice is null ? "未设置" : $"¥{item.SalePrice:N2}") · 单次最大采购量：@(item.MaxPurchaseQuantity is null ? "不限制" : item.MaxPurchaseQuantity.Value.ToString("N2")) · 安全库存：@(item.SafetyStock is null ? "未设置" : item.SafetyStock.Value.ToString("N2"))</p><div class="customer-note">引用：采购订单 @impact.PurchaseOrderReferenceCount · 销售订单 @impact.SalesOrderReferenceCount · 库存流水 @impact.InventoryTransactionReferenceCount · 账面库存 @impact.OnHandQuantity.ToString("N2")</div><div class="customer-note">扩展信息：@item.OtherInfo</div></div><div class="task-card__actions"><button title="编辑商品" @onclick="() => OpenEditor(item)"><i class="fa fa-pencil"></i></button><button title="切换状态" @onclick="() => ProductService.SetActive(item, item.Status != ProductStatus.Active)"><i class="fa fa-toggle-@(item.Status == ProductStatus.Active ? "on" : "off")"></i></button><button class="danger" title="@(impact.HasReferences ? "商品有历史引用，不能删除" : "删除商品")" disabled="@impact.HasReferences" @onclick="() => ProductService.Remove(item)"><i class="fa fa-trash-o"></i></button></div></article> }</section></div>
@code { private string Keyword="", StatusFilterText="", Code="", Name="", Unit="", PriceText="", MaxPurchaseQuantityText="", SafetyStockText="", Notes="", OtherInfo="{}"; private string? Error; private bool ShowComposer; private Product? Editing; private ProductStatus? SelectedStatus()=>Enum.TryParse<ProductStatus>(StatusFilterText,out var status)?status:null; private void OpenComposer(){Close();ShowComposer=true;} private void OpenEditor(Product x){Close();Editing=x;Code=x.Code;Name=x.Name;Unit=x.Unit;PriceText=x.SalePrice?.ToString()??"";MaxPurchaseQuantityText=x.MaxPurchaseQuantity?.ToString()??"";SafetyStockText=x.SafetyStock?.ToString()??"";Notes=x.Notes??"";OtherInfo=x.OtherInfo;} private void Close(){ShowComposer=false;Editing=null;Error=null;Code=Name=Unit=PriceText=MaxPurchaseQuantityText=SafetyStockText=Notes="";OtherInfo="{}";} private void Save(){ if(!decimal.TryParse(string.IsNullOrWhiteSpace(PriceText)?"0":PriceText,out var price)){Error="参考售价格式不正确。";return;} decimal? maxPurchaseQuantity=null; if(!string.IsNullOrWhiteSpace(MaxPurchaseQuantityText)){if(!decimal.TryParse(MaxPurchaseQuantityText,out var parsedMax)||parsedMax<=0){Error="单次最大采购量必须是大于 0 的数字，留空表示不限制。";return;} maxPurchaseQuantity=parsedMax;} decimal? safetyStock=null; if(!string.IsNullOrWhiteSpace(SafetyStockText)){if(!decimal.TryParse(SafetyStockText,out var parsedSafety)||parsedSafety<0){Error="安全库存必须是大于或等于 0 的数字，留空表示不启用库存风险提醒。";return;} safetyStock=parsedSafety;} try { if(Editing is null) ProductService.Create(Code,Name,Unit,price,Notes,maxPurchaseQuantity,safetyStock,OtherInfo); else ProductService.Edit(Editing,Code,Name,Unit,price,Notes,maxPurchaseQuantity,safetyStock,OtherInfo); Close(); } catch(Exception ex){Error=ex.Message;} } }
@code { private ProductMasterDataImpact Impact(Product item) => MasterDataImpactService.Product(item.Id, PurchaseOrderService.List(), SalesOrderService.List(), InventoryService.List()); }
