@page "/Erp/SupplierLedger"
@page "/Erp/SupplierLedger/{SupplierId:guid}"
@inject VelrixWorkHub.Application.Suppliers.SupplierService SupplierService
@inject VelrixWorkHub.Application.PurchaseOrders.PurchaseOrderService PurchaseOrderService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.Settlements.SettlementService SettlementService
@using VelrixWorkHub.Application.Reports
@using VelrixWorkHub.Application.Settlements
@using VelrixWorkHub.Domain
<PageTitle>供应商交易视图 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/SupplierLedger</p><h1>供应商交易视图</h1><p class="task-page__intro">聚合采购订单、实际付款流水与应付余额，帮助采购人员跟踪供应商往来。</p></div></div>
<section class="task-toolbar customer-toolbar"><label>供应商<select aria-label="选择交易供应商" @bind="SupplierIdText"><option value="">请选择供应商</option>@foreach(var supplier in SupplierService.List()){<option value="@supplier.Id">@supplier.Name</option>}</select></label>@if(SelectedSupplier is not null){<a class="task-primary-button" href="/Erp/PurchaseOrder"><i class="fa fa-plus"></i> 新建采购订单</a>}</section>
@if(SelectedSupplier is null){<div class="task-empty"><i class="fa fa-line-chart"></i><strong>请选择一个供应商</strong><span>查看该供应商的采购订单、付款和应付余额。</span></div>}else{var insight=Insight();<section class="task-list" aria-label="供应商交易指标"><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>有效采购订单</span><span>ERP 采购</span></div><h2>@insight.OrderCount</h2><p>已收货 @insight.ReceivedOrderCount 笔 · 采购 ¥@insight.PurchaseAmount.ToString("N2")</p></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>已付款</span><span>核销流水</span></div><h2>¥@insight.PaidAmount.ToString("N2")</h2><p>已登记采购付款</p></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>供应商应付</span><span>采购减付款</span></div><h2>¥@insight.PayableAmount.ToString("N2")</h2><p>需继续跟进的付款余额</p></div></article></section><section class="task-list" aria-label="供应商采购订单">@foreach(var item in SupplierOrders()){var product=ProductName(item);<article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-shopping-cart"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@StatusLabel(item.Status)</span><a href="/Erp/PurchaseOrder?orderId=@item.Id">@item.OrderNo</a><span>@item.OrderDate.ToString("yyyy-MM-dd")</span></div><h2>@product</h2><p>数量 @item.Quantity.ToString("N2") · 订单金额 ¥@item.Amount.ToString("N2")</p></div></article>}</section><section class="task-list" aria-label="供应商付款流水">@foreach(var item in SupplierPayments()){<article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-money"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@(item.Status==ErpSettlementStatus.Active?"采购付款":item.Status==ErpSettlementStatus.PendingApproval?"待审批付款":item.Status==ErpSettlementStatus.Rejected?"审批拒绝":"已撤销付款")</span><a href="/Erp/Settlement?keyword=@item.ReferenceNo&partyId=@SupplierId&partyKind=Payable">@item.ReferenceNo</a><span>@item.OccurredOn.ToString("yyyy-MM-dd")</span></div><h2>¥@item.Amount.ToString("N2")</h2><p>@(item.Status is ErpSettlementStatus.Voided or ErpSettlementStatus.Rejected?$"处理原因：{item.VoidReason}":item.Notes)</p></div></article>}</section>}</div>
@code{[Parameter] public Guid? SupplierId {get;set;} private string SupplierIdText {get=>SupplierId?.ToString()??string.Empty;set=>SupplierId=Guid.TryParse(value,out var id)?id:null;} private Supplier? SelectedSupplier=>SupplierId is Guid id?SupplierService.List().FirstOrDefault(x=>x.Id==id):null; private SupplierErpInsight Insight()=>SupplierErpInsightService.Build(SupplierId!.Value,PurchaseOrderService.List(),SettlementService.List()); private IEnumerable<PurchaseOrder> SupplierOrders()=>PurchaseOrderService.List().Where(x=>x.SupplierId==SupplierId&&x.Status!=PurchaseOrderStatus.Cancelled).OrderByDescending(x=>x.OrderDate); private IEnumerable<ErpSettlement> SupplierPayments()=>SettlementService.List(ErpSettlementKind.Payable).Where(x=>x.PartyId==SupplierId); private string ProductName(PurchaseOrder item)=>ProductService.List().FirstOrDefault(x=>x.Id==item.ProductId)?.Name??"未知商品"; private static string StatusLabel(PurchaseOrderStatus status)=>status switch{PurchaseOrderStatus.Draft=>"草稿",PurchaseOrderStatus.Submitted=>"已提交",PurchaseOrderStatus.Received=>"已收货",_=>"已取消"};}
