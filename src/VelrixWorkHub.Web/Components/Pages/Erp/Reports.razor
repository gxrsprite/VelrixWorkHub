@page "/Erp/Report"
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@inject VelrixWorkHub.Application.PurchaseOrders.PurchaseOrderService PurchaseOrderService
@inject VelrixWorkHub.Application.SalesOrders.SalesOrderService SalesOrderService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.Suppliers.SupplierService SupplierService
@inject VelrixWorkHub.Application.Customers.CustomerService CustomerService
@inject VelrixWorkHub.Application.Settlements.SettlementService SettlementService
@inject VelrixWorkHub.Application.PmpProjects.PmpProjectService PmpProjectService
@inject VelrixWorkHub.Application.Contracts.SalesContractService SalesContractService
@using VelrixWorkHub.Domain
@using VelrixWorkHub.Application.Reports
<PageTitle>ERP 基础报表 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/Report</p><h1>ERP 基础报表</h1><p class="task-page__intro">汇总库存流水和订单金额，所有数据均可回溯到原始单据。</p></div></div>
<section class="task-toolbar customer-toolbar"><label>开始日期<input type="date" aria-label="报表开始日期" @bind="StartDate" /></label><label>结束日期<input type="date" aria-label="报表结束日期" @bind="EndDate" /></label><button class="task-secondary-button" @onclick="ClearDates">清除日期</button></section>
@if (InvalidDateRange) { <div class="task-error" role="alert">报表开始日期不能晚于结束日期。</div> }
@if (!InvalidDateRange && !HasData()) { <div class="task-error" role="status">当前筛选范围暂无可汇总数据。</div> }
<section class="task-list" aria-label="ERP 报表指标"><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>入库数量</span><span>库存流水</span></div><h2>@InboundQuantity().ToString("N2")</h2></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>出库数量</span><span>库存流水</span></div><h2>@OutboundQuantity().ToString("N2")</h2></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>调整净额</span><span>盘点/调整</span></div><h2>@AdjustmentQuantity().ToString("+0.00;-0.00;0.00")</h2></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>采购金额</span><span>有效订单汇总</span></div><h2><a href="@PurchaseOrderHref()">¥@PurchaseOrders().Sum(x=>x.Amount).ToString("N2")</a></h2></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>销售金额</span><span>有效订单汇总</span></div><h2><a href="@SalesOrderHref()">¥@SalesOrders().Sum(x=>x.Amount).ToString("N2")</a></h2></div></article></section>
<section class="task-list" aria-label="商品库存变动汇总">@foreach(var group in ProductMovements()){var product=ProductService.List().FirstOrDefault(x=>x.Id==group.ProductId);<article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>商品库存变动</span><span>流水汇总</span></div><h2>@(product?.Name??"未知商品")</h2><p>入库 @group.Inbound.ToString("N2") · 出库 @group.Outbound.ToString("N2") · 调整 @group.Adjustment.ToString("+0.00;-0.00;0.00") · 净变动 @group.Net.ToString("+0.00;-0.00;0.00")</p></div></article>}</section>
<section class="task-list" aria-label="供应商采购汇总">@foreach(var group in PurchaseSummary()){var supplier=SupplierService.List().FirstOrDefault(x=>x.Id==group.Key);var balance=SupplierBalance(group.Key);<article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>供应商采购汇总</span><span>@group.Count() 条订单</span></div><h2>@if(supplier is not null){<a href="/Erp/SupplierLedger/@supplier.Id">@supplier.Name</a>}else{<span>未知供应商</span>}</h2><p>采购金额：¥@group.Sum(x=>x.Amount).ToString("N2") · 已核销 ¥@((balance?.SettledAmount ?? 0).ToString("N2")) · 剩余应付 ¥@((balance?.OutstandingAmount ?? 0).ToString("N2"))</p></div></article>}</section><section class="task-list" aria-label="客户销售汇总">@foreach(var group in SalesSummary()){var customer=CustomerService.List().FirstOrDefault(x=>x.Id==group.Key);var balance=CustomerBalance(group.Key);<article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>客户销售汇总</span><span>@group.Count() 条订单</span></div><h2>@if(customer is not null){<a href="/Crm/CustomerLedger/@customer.Id">@customer.Name</a>}else{<span>未知客户</span>}</h2><p>销售金额：¥@group.Sum(x=>x.Amount).ToString("N2") · 已核销 ¥@((balance?.SettledAmount ?? 0).ToString("N2")) · 剩余应收 ¥@((balance?.OutstandingAmount ?? 0).ToString("N2"))</p></div></article>}</section>
<section class="task-list" aria-label="采购销售对账"><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>采购对账</span><span>@PurchaseReconciliation().Count(x=>x.Status==ErpReconciliationStatus.Matched) / @PurchaseReconciliation().Count(x=>x.Status!=ErpReconciliationStatus.NotApplicable) 已匹配</span></div>@foreach(var item in PurchaseReconciliation().Where(x=>x.Status!=ErpReconciliationStatus.NotApplicable)){<p><span class="task-status customer-status--@(item.Status==ErpReconciliationStatus.Matched?"active":"inactive")">@(item.Status==ErpReconciliationStatus.Matched?"已匹配":"待核对")</span> <a href="/Erp/PurchaseOrder?orderId=@item.OrderId">@item.OrderNo</a> · 订单 @item.OrderQuantity.ToString("N2") · 入库 @item.TransactionQuantity.ToString("N2") · 差异 @item.Difference.ToString("+0.00;-0.00;0.00")</p>}</div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>销售对账</span><span>@SalesReconciliation().Count(x=>x.Status==ErpReconciliationStatus.Matched) / @SalesReconciliation().Count(x=>x.Status!=ErpReconciliationStatus.NotApplicable) 已匹配</span></div>@foreach(var item in SalesReconciliation().Where(x=>x.Status!=ErpReconciliationStatus.NotApplicable)){<p><span class="task-status customer-status--@(item.Status==ErpReconciliationStatus.Matched?"active":"inactive")">@(item.Status==ErpReconciliationStatus.Matched?"已匹配":"待核对")</span> <a href="/Erp/SalesOrder?orderId=@item.OrderId">@item.OrderNo</a> · 订单 @item.OrderQuantity.ToString("N2") · 出库 @item.TransactionQuantity.ToString("N2") · 差异 @item.Difference.ToString("+0.00;-0.00;0.00")</p>}</div></article></section>
<section class="task-list" aria-label="往来余额汇总"><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>供应商应付</span><span>有效采购订单</span></div><h2><a href="@PurchaseOrderHref()">¥@SupplierPayables().Sum(x=>x.OutstandingAmount).ToString("N2")</a></h2><p>@SupplierPayables().Sum(x=>x.OrderCount) 笔采购订单 · 已核销 ¥@SupplierPayables().Sum(x=>x.SettledAmount).ToString("N2") · 已收货 ¥@SupplierPayables().Sum(x=>x.CompletedAmount).ToString("N2")</p></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>客户应收</span><span>有效销售订单</span></div><h2><a href="@SalesOrderHref()">¥@CustomerReceivables().Sum(x=>x.OutstandingAmount).ToString("N2")</a></h2><p>@CustomerReceivables().Sum(x=>x.OrderCount) 笔销售订单 · 已核销 ¥@CustomerReceivables().Sum(x=>x.SettledAmount).ToString("N2") · 已发货 ¥@CustomerReceivables().Sum(x=>x.CompletedAmount).ToString("N2")</p></div></article></section>
<section class="task-list" aria-label="PMP 项目经营汇总">
    @foreach (var row in PmpProjectSummary())
    {
        var customer = row.Project.CustomerId is Guid customerId ? CustomerService.List().FirstOrDefault(x => x.Id == customerId) : null;
        <article class="task-card customer-card">
            <div class="task-card__body">
                <div class="task-card__meta"><span>PMP 项目经营汇总</span><span>@row.Project.Code · @(customer?.Name ?? "未关联客户")</span></div>
                <h2><a href="/Pmp/Project?customerId=@row.Project.CustomerId">@row.Project.Name</a></h2>
                <p>合同 ¥@row.Commercial.ActiveContractAmount.ToString("N2") · 已承接 ¥@row.Commercial.ContractedOrderAmount.ToString("N2") · 待承接 ¥@row.Commercial.UnorderedContractAmount.ToString("N2")</p>
                <p>销售订单 @row.Commercial.SalesOrderCount 笔 · 销售额 ¥@row.Commercial.SalesOrderAmount.ToString("N2") · 已收 ¥@row.Commercial.ReceivedAmount.ToString("N2") · 应收 ¥@row.Commercial.ReceivableAmount.ToString("N2")</p>
                <a href="@ProjectSalesOrderHref(row)">查看项目销售订单</a>
            </div>
        </article>
    }
</section></div>
@code { private DateOnly? StartDate; private DateOnly? EndDate; private bool InvalidDateRange => StartDate.HasValue && EndDate.HasValue && StartDate.Value > EndDate.Value; private sealed record ProductMovement(Guid ProductId, decimal Inbound, decimal Outbound, decimal Adjustment) { public decimal Net => Inbound - Outbound + Adjustment; } private void ClearDates(){StartDate=null;EndDate=null;} private bool InRange(DateOnly date) => !InvalidDateRange && (StartDate is null || date >= StartDate) && (EndDate is null || date <= EndDate); private string DateRangeQuery()=>string.Concat(StartDate is DateOnly startDate?$"&startDate={startDate:yyyy-MM-dd}":string.Empty,EndDate is DateOnly endDate?$"&endDate={endDate:yyyy-MM-dd}":string.Empty); private string PurchaseOrderHref()=>InvalidDateRange?"/Erp/PurchaseOrder":$"/Erp/PurchaseOrder?activeOnly=true{DateRangeQuery()}"; private string SalesOrderHref()=>InvalidDateRange?"/Erp/SalesOrder":$"/Erp/SalesOrder?activeOnly=true{DateRangeQuery()}"; private IEnumerable<InventoryTransaction> Transactions()=>InventoryService.List().Where(x=>InRange(x.OccurredOn)); private IEnumerable<PurchaseOrder> PurchaseOrders()=>PurchaseOrderService.List().Where(x=>x.Status != PurchaseOrderStatus.Cancelled && InRange(x.OrderDate)); private IEnumerable<SalesOrder> SalesOrders()=>SalesOrderService.List().Where(x=>x.Status != SalesOrderStatus.Cancelled && InRange(x.OrderDate)); private IEnumerable<ErpSettlement> Settlements()=>SettlementService.List().Where(x=>InRange(x.OccurredOn)); private IReadOnlyList<ErpReconciliationItem> PurchaseReconciliation()=>ErpReconciliationService.Purchase(PurchaseOrders(),Transactions()); private IReadOnlyList<ErpReconciliationItem> SalesReconciliation()=>ErpReconciliationService.Sales(SalesOrders(),Transactions()); private IReadOnlyList<ErpSettlementBalance> SupplierPayables()=>ErpSettlementService.SupplierPayables(PurchaseOrders(),Settlements()); private IReadOnlyList<ErpSettlementBalance> CustomerReceivables()=>ErpSettlementService.CustomerReceivables(SalesOrders(),Settlements()); private ErpSettlementBalance? SupplierBalance(Guid supplierId)=>SupplierPayables().FirstOrDefault(x=>x.PartyId==supplierId); private ErpSettlementBalance? CustomerBalance(Guid customerId)=>CustomerReceivables().FirstOrDefault(x=>x.PartyId==customerId); private bool HasData()=>Transactions().Any()||PurchaseOrders().Any()||SalesOrders().Any(); private decimal InboundQuantity()=>Transactions().Where(x=>x.Kind==InventoryTransactionKind.Inbound).Sum(x=>x.Quantity); private decimal OutboundQuantity()=>Transactions().Where(x=>x.Kind==InventoryTransactionKind.Outbound).Sum(x=>x.Quantity); private decimal AdjustmentQuantity()=>Transactions().Where(x=>x.Kind==InventoryTransactionKind.Adjustment).Sum(x=>x.SignedQuantity); private IEnumerable<ProductMovement> ProductMovements()=>Transactions().GroupBy(x=>x.ProductId).Select(x=>new ProductMovement(x.Key,x.Where(y=>y.Kind==InventoryTransactionKind.Inbound).Sum(y=>y.Quantity),x.Where(y=>y.Kind==InventoryTransactionKind.Outbound).Sum(y=>y.Quantity),x.Where(y=>y.Kind==InventoryTransactionKind.Adjustment).Sum(y=>y.SignedQuantity))); private IEnumerable<IGrouping<Guid, PurchaseOrder>> PurchaseSummary()=>PurchaseOrders().GroupBy(x=>x.SupplierId); private IEnumerable<IGrouping<Guid, SalesOrder>> SalesSummary()=>SalesOrders().GroupBy(x=>x.CustomerId); private IReadOnlyList<PmpProjectErpReportRow> PmpProjectSummary()=>PmpProjectErpReportService.Build(PmpProjectService.List(),SalesOrders(),Settlements(),SalesContractService.List()); private static string ProjectSalesOrderHref(PmpProjectErpReportRow row)=>row.Project.CustomerId is not Guid customerId?"/Erp/SalesOrder":row.Commercial.HasProjectScopedOrders?$"/Erp/SalesOrder?projectId={row.Project.Id}&activeOnly=true":$"/Erp/SalesOrder?customerId={customerId}&activeOnly=true"; }
