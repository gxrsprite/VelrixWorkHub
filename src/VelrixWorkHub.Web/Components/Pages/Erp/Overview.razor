@page "/Erp/Overview"
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@inject VelrixWorkHub.Application.PurchaseOrders.PurchaseOrderService PurchaseOrderService
@inject VelrixWorkHub.Application.SalesOrders.SalesOrderService SalesOrderService
@inject VelrixWorkHub.Application.Warehouses.WarehouseService WarehouseService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.Settlements.SettlementService SettlementService
@inject VelrixWorkHub.Web.Localization.UiLocalizationService L
@implements IDisposable
@using VelrixWorkHub.Domain
@using VelrixWorkHub.Application.Reports

<PageTitle>@L.Text("ERP 运营概览") - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">@L.Text("企业资源 · ERP/Overview")</p><h1>@L.Text("ERP 运营概览")</h1><p class="task-page__intro">@L.Text("从库存、采购、销售和仓库四个维度查看当前业务状态。")</p></div></div>
<section class="task-list" aria-label="@L.Text("ERP 核心指标")"><article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-cubes"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("库存余额")</span><span>@L.Text("商品/仓库汇总")</span></div><h2>@Operations.InventoryQuantity.ToString("N2")</h2><p>@L.Text("当前可追溯库存数量")</p></div></article><article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-shopping-cart"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("待处理采购")</span><span>@L.Text("草稿/已提交")</span></div><h2>@Operations.PendingPurchaseOrderCount</h2><p>@L.Text("订单金额") ¥@Operations.PendingPurchaseAmount.ToString("N2")</p></div></article><article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-truck"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("待处理销售")</span><span>@L.Text("草稿/已提交")</span></div><h2>@Operations.PendingSalesOrderCount</h2><p>@L.Text("订单金额") ¥@Operations.PendingSalesAmount.ToString("N2")</p></div></article><article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-building-o"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("启用仓库")</span><span>@L.Text("仓库主数据")</span></div><h2>@WarehouseService.List().Count(x => x.Status == WarehouseStatus.Active)</h2><p>@L.Text("可用于收货、发货和调拨")</p></div></article></section>
<section class="task-list" aria-label="@L.Text("ERP 经营待处理")"><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("应付余额")</span><span>@L.Text("采购核销")</span></div><h2>¥@Operations.PayableAmount.ToString("N2")</h2><p><a href="/Erp/Settlement?partyKind=Payable">@L.Text("查看付款核销")</a></p></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("应收余额")</span><span>@L.Text("销售核销")</span></div><h2>¥@Operations.ReceivableAmount.ToString("N2")</h2><p><a href="/Erp/Settlement?partyKind=Receivable">@L.Text("查看收款核销")</a></p></div></article><article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("库存风险")</span><span>@L.Text("提交订单可用量不足")</span></div><h2>@Operations.InventoryRisks.Count</h2>@if (Operations.InventoryRisks.Count == 0) { <p>@L.Text("当前没有库存不足风险")</p> } else { @foreach (var risk in Operations.InventoryRisks.Take(3)) { var product = ProductService.List().FirstOrDefault(x => x.Id == risk.ProductId); <p>@(product?.Name ?? L.Text("未知商品")) · @L.Text("可用") @risk.AvailableQuantity.ToString("N2")</p> } }</div></article></section>
<section class="task-list" aria-label="@L.Text("库存余额概览")">@foreach(var balance in InventoryService.Balances()){var product=ProductService.List().FirstOrDefault(x=>x.Id==balance.ProductId);var warehouse=WarehouseService.List().FirstOrDefault(x=>x.Id==balance.WarehouseId);<article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("库存余额")</span><span>@(warehouse?.Code??L.Text("未知仓库"))</span></div><h2>@(product?.Name??L.Text("未知商品"))</h2><p>@(warehouse?.Name??L.Text("未知仓库")) · @L.Text("结存") @balance.Quantity.ToString("N2")</p></div></article>}</section>
<section class="task-list" aria-label="@L.Text("最近库存流水")">@foreach(var item in InventoryService.List().Take(6)){var product=ProductService.List().FirstOrDefault(x=>x.Id==item.ProductId);<article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@KindLabel(item.Kind)</span><span>@item.SourceNo</span><span>@item.OccurredOn.ToString("yyyy-MM-dd")</span></div><h2>@(product?.Name??L.Text("未知商品"))</h2><p>@L.Text("库存变动")：@(item.SignedQuantity>=0?"+":"")@item.SignedQuantity.ToString("N2")</p></div></article>}</section></div>
@code {
    private ErpOperationsSnapshot Operations => ErpOperationsSnapshotService.Build(PurchaseOrderService.List(), SalesOrderService.List(), InventoryService.Balances(), SettlementService.List());
    private string KindLabel(InventoryTransactionKind kind) => kind switch { InventoryTransactionKind.Inbound => L.Text("入库"), InventoryTransactionKind.Outbound => L.Text("出库"), _ => L.Text("调整") };
    protected override void OnInitialized() => L.Changed += OnLanguageChanged;
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnLanguageChanged;
}
