@page "/Erp/InventoryTransfer"
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.Warehouses.WarehouseService WarehouseService
@using VelrixWorkHub.Domain
<PageTitle>库存调拨 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/InventoryTransfer</p><h1>库存调拨</h1><p class="task-page__intro">调拨由一条出库流水和一条入库流水组成，余额变化可完整追溯。</p></div></div>
<section class="task-composer" aria-label="登记库存调拨"><div class="task-composer__title">登记库存调拨</div><div class="task-composer__fields"><label>商品<select aria-label="调拨商品" @bind="ProductIdText"><option value="">请选择商品</option>@foreach(var x in ProductService.List()){<option value="@x.Id">@x.Code · @x.Name</option>}</select></label><label>数量<input aria-label="调拨数量" @bind="QuantityText" @bind:event="oninput" placeholder="10" /></label></div><div class="task-composer__fields"><label>调出仓库<select aria-label="调出仓库" @bind="SourceWarehouseIdText"><option value="">请选择仓库</option>@foreach(var x in WarehouseService.List()){<option value="@x.Id">@x.Code · @x.Name</option>}</select></label><label>调入仓库<select aria-label="调入仓库" @bind="TargetWarehouseIdText"><option value="">请选择仓库</option>@foreach(var x in WarehouseService.List()){<option value="@x.Id">@x.Code · @x.Name</option>}</select></label></div><div class="task-composer__fields"><label>调出库位<select aria-label="调出库位" @bind="SourceLocationIdText"><option value="">不指定库位</option>@foreach(var x in SourceLocations()){<option value="@x.Id">@x.Code · @x.Name</option>}</select></label><label>调入库位<select aria-label="调入库位" @bind="TargetLocationIdText"><option value="">不指定库位</option>@foreach(var x in TargetLocations()){<option value="@x.Id">@x.Code · @x.Name</option>}</select></label></div><div class="task-composer__fields"><label>批次号<input aria-label="调拨批次号" @bind="BatchNo" @bind:event="oninput" placeholder="LOT-20260715-001" /></label><label>保质期<input aria-label="调拨保质期" type="date" @bind="ExpiryDateValue" /></label></div><label>序列号<input aria-label="调拨序列号" @bind="SerialNo" @bind:event="oninput" placeholder="SN-20260715-001" /></label><label>调拨单号<input aria-label="调拨单号" @bind="TransferNo" @bind:event="oninput" placeholder="TR-20260712-001" /></label>@if(Error is not null){<div class="task-error" role="alert">@Error</div>}<div class="task-composer__actions"><button class="task-primary-button" @onclick="Save">保存调拨</button></div></section>
<section class="task-list" aria-label="最近调拨流水">@foreach(var item in InventoryService.List().Where(x=>x.SourceNo.StartsWith("TR-",StringComparison.OrdinalIgnoreCase)).Take(12)){var product=ProductService.List().FirstOrDefault(x=>x.Id==item.ProductId);var warehouse=WarehouseService.List().FirstOrDefault(x=>x.Id==item.WarehouseId);<article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-exchange"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@item.SourceNo</span><span>@item.OccurredOn.ToString("yyyy-MM-dd")</span></div><h2>@(product?.Name??"未知商品")</h2><p>@(warehouse?.Name??"未知仓库") · @(item.Kind==InventoryTransactionKind.Outbound?"调出":"调入") · 数量 @item.Quantity.ToString("N2")</p></div></article>}</section></div>
@code{private IEnumerable<WarehouseLocation> SourceLocations()=>WarehouseService.List().FirstOrDefault(x=>x.Id==(Guid.TryParse(SourceWarehouseIdText,out var id)?id:Guid.Empty))?.Locations??[];private IEnumerable<WarehouseLocation> TargetLocations()=>WarehouseService.List().FirstOrDefault(x=>x.Id==(Guid.TryParse(TargetWarehouseIdText,out var id)?id:Guid.Empty))?.Locations??[];private string ProductIdText=string.Empty,SourceWarehouseIdText=string.Empty,TargetWarehouseIdText=string.Empty,SourceLocationIdText=string.Empty,TargetLocationIdText=string.Empty,QuantityText=string.Empty,TransferNo=string.Empty,BatchNo=string.Empty,SerialNo=string.Empty;private DateTime? ExpiryDateValue;private string? Error;private void Save(){if(!Guid.TryParse(ProductIdText,out var productId)||!Guid.TryParse(SourceWarehouseIdText,out var sourceWarehouseId)||!Guid.TryParse(TargetWarehouseIdText,out var targetWarehouseId)||!decimal.TryParse(QuantityText,out var quantity)||string.IsNullOrWhiteSpace(TransferNo)){Error="请选择商品、调出/调入仓库并输入有效数量和调拨单号。";return;}Guid? sourceLocationId=Guid.TryParse(SourceLocationIdText,out var sl)?sl:null;Guid? targetLocationId=Guid.TryParse(TargetLocationIdText,out var tl)?tl:null;DateOnly? expiryDate=ExpiryDateValue is DateTime value?DateOnly.FromDateTime(value):null;try{InventoryService.Transfer(productId,sourceWarehouseId,sourceLocationId,targetWarehouseId,targetLocationId,quantity,TransferNo,DateOnly.FromDateTime(DateTime.Today),BatchNo,expiryDate,SerialNo);Error="调拨已保存，已生成调出和调入流水。";}catch(Exception ex){Error=ex.Message;}}}
