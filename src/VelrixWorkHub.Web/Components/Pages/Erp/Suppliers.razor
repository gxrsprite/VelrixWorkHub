@page "/Erp/Supplier"
@inject VelrixWorkHub.Application.Suppliers.SupplierService SupplierService
@inject VelrixWorkHub.Application.PurchaseOrders.PurchaseOrderService PurchaseOrderService
@inject VelrixWorkHub.Application.Settlements.SettlementService SettlementService
@using VelrixWorkHub.Application.MasterData
@using VelrixWorkHub.Domain
<PageTitle>供应商主数据 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/Supplier</p><h1>供应商主数据</h1><p class="task-page__intro">维护采购和应付业务引用的供应商基础信息，与 CRM 客户主数据保持独立边界。</p></div></div>
<section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索供应商" @bind="Keyword" @bind:event="oninput" placeholder="搜索编码、名称或联系人" /></div><select aria-label="筛选供应商状态" @bind="StatusFilterText"><option value="">全部状态</option><option value="Active">启用</option><option value="Inactive">停用</option></select><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建供应商</button></section>
@if(ShowComposer||Editing is not null){<section class="task-composer" aria-label="供应商编辑"><div class="task-composer__title">@(Editing is null?"录入供应商":"编辑供应商")</div><div class="task-composer__fields"><label>供应商编码<input aria-label="供应商编码" @bind="Code" @bind:event="oninput" placeholder="SUP-002" /></label><label>供应商名称<input aria-label="供应商名称" @bind="Name" @bind:event="oninput" placeholder="供应商名称" /></label></div><div class="task-composer__fields"><label>联系人<input aria-label="供应商联系人" @bind="Contact" @bind:event="oninput" /></label><label>联系电话<input aria-label="供应商电话" @bind="Phone" @bind:event="oninput" /></label></div><label>备注<textarea aria-label="供应商备注" @bind="Notes" @bind:event="oninput" rows="2"></textarea></label>@if(Error is not null){<div class="task-error" role="alert">@Error</div>}<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存供应商</button></div></section>}
<section class="task-list" aria-live="polite">@foreach(var item in SupplierService.List(Keyword, SelectedStatus())){var impact=Impact(item);<article class="task-card customer-card"><div class="customer-avatar">@item.Name.FirstOrDefault()</div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@(item.Status==SupplierStatus.Active?"active":"inactive")">@(item.Status==SupplierStatus.Active?"启用":"停用")</span><span class="task-status customer-status--@(item.QualificationStatus==SupplierQualificationStatus.Qualified?"active":"inactive")">@QualificationLabel(item.QualificationStatus)</span><span>@item.Code</span></div><h2>@item.Name</h2><p>@(item.ContactName??"暂无联系人") · @(item.Phone??"暂无电话")</p><div class="customer-note">引用：<a href="/Erp/PurchaseOrder?supplierId=@item.Id" title="查看 @item.Name 的采购订单">采购订单 @impact.PurchaseOrderReferenceCount</a> · <a href="/Erp/Settlement?partyId=@item.Id&partyKind=Payable" title="查看 @item.Name 的付款核销">核销 @impact.SettlementReferenceCount</a></div>@if(!string.IsNullOrWhiteSpace(item.Notes)){<div class="customer-note">@item.Notes</div>}<AttachmentPanel BusinessType="Supplier" BusinessId="@item.Id" Actor="admin" /></div><div class="task-card__actions"><button title="编辑供应商" @onclick="()=>OpenEditor(item)"><i class="fa fa-pencil"></i></button><button title="切换启停状态" @onclick="()=>SupplierService.SetActive(item,item.Status!=SupplierStatus.Active)"><i class="fa fa-toggle-@(item.Status==SupplierStatus.Active?"on":"off")"></i></button><button title="@(item.QualificationStatus==SupplierQualificationStatus.Qualified?"暂停采购准入":"恢复采购准入")" @onclick="()=>ToggleQualification(item)"><i class="fa fa-certificate"></i></button><button class="danger" disabled="@impact.HasReferences" title="@(impact.HasReferences?"存在业务引用，不能删除供应商":"删除供应商")" @onclick="()=>SupplierService.Remove(item)"><i class="fa fa-trash-o"></i></button></div></article>}</section></div>
@code { private string Keyword="",StatusFilterText="",Code="",Name="",Contact="",Phone="",Notes=""; private string? Error; private bool ShowComposer; private Supplier? Editing; private SupplierStatus? SelectedStatus()=>Enum.TryParse<SupplierStatus>(StatusFilterText,out var status)?status:null; private void OpenComposer(){Close();ShowComposer=true;} private void OpenEditor(Supplier x){Close();Editing=x;Code=x.Code;Name=x.Name;Contact=x.ContactName??"";Phone=x.Phone??"";Notes=x.Notes??"";} private void Close(){ShowComposer=false;Editing=null;Error=null;Code=Name=Contact=Phone=Notes="";} private void Save(){try{if(Editing is null)SupplierService.Create(Code,Name,Contact,Phone,Notes,"{}");else SupplierService.Edit(Editing,Code,Name,Contact,Phone,Notes,Editing.OtherInfo);Close();}catch(Exception ex){Error=ex.Message;}} private void ToggleQualification(Supplier item){try{SupplierService.SetQualification(item,item.QualificationStatus==SupplierQualificationStatus.Qualified?SupplierQualificationStatus.Suspended:SupplierQualificationStatus.Qualified);Error=null;}catch(Exception ex){Error=ex.Message;}} private static string QualificationLabel(SupplierQualificationStatus status)=>status switch{SupplierQualificationStatus.Qualified=>"已准入",SupplierQualificationStatus.Pending=>"待准入",_=>"已暂停准入"}; private SupplierMasterDataImpact Impact(Supplier item)=>MasterDataImpactService.Supplier(item.Id,PurchaseOrderService.List(),SettlementService.List()); }
