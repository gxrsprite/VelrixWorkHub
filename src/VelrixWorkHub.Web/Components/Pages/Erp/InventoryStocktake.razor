@page "/Erp/InventoryStocktake"
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.Warehouses.WarehouseService WarehouseService
@using VelrixWorkHub.Domain
<PageTitle>库存盘点 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/InventoryStocktake</p><h1>库存盘点</h1><p class="task-page__intro">录入实际盘点数量，系统只生成差异调整流水，不覆盖历史库存记录。</p></div></div>
<section class="task-composer" aria-label="登记库存盘点"><div class="task-composer__title">登记库存盘点</div><div class="task-composer__fields"><label>商品<select aria-label="盘点商品" @bind="ProductIdText"><option value="">请选择商品</option>@foreach(var x in ProductService.List()){<option value="@x.Id">@x.Code · @x.Name</option>}</select></label><label>仓库<select aria-label="盘点仓库" @bind="WarehouseIdText"><option value="">请选择仓库</option>@foreach(var x in WarehouseService.List()){<option value="@x.Id">@x.Code · @x.Name</option>}</select></label></div><div class="task-composer__fields"><label>库位<select aria-label="盘点库位" @bind="LocationIdText"><option value="">按仓库总余额盘点</option>@foreach(var x in StocktakeLocations()){<option value="@x.Id">@x.Code · @x.Name</option>}</select></label><label>实盘数量<input aria-label="实盘数量" @bind="ActualQuantityText" @bind:event="oninput" placeholder="25" /></label></div><label>盘点单号<input aria-label="盘点单号" @bind="SourceNo" @bind:event="oninput" placeholder="ST-20260712-001" /></label>@if(Error is not null){<div class="task-error" role="alert">@Error</div>}<div class="task-composer__actions"><button class="task-primary-button" @onclick="Save">保存盘点</button></div></section>
<section class="task-list" aria-label="盘点调整流水">@foreach(var item in InventoryService.List(kind:InventoryTransactionKind.Adjustment)){var product=ProductService.List().FirstOrDefault(x=>x.Id==item.ProductId);var warehouse=WarehouseService.List().FirstOrDefault(x=>x.Id==item.WarehouseId);<article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-check-square-o"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@item.SourceNo</span><span>@item.OccurredOn.ToString("yyyy-MM-dd")</span></div><h2>@(product?.Name??"未知商品")</h2><p>@(warehouse?.Name??"未知仓库") · 调整数量 @(item.SignedQuantity>=0?"+":"")@item.SignedQuantity.ToString("N2")</p><div class="customer-note">@item.Notes</div></div></article>}</section></div>
@code{private string ProductIdText=string.Empty,WarehouseIdText=string.Empty,LocationIdText=string.Empty,ActualQuantityText=string.Empty,SourceNo=string.Empty;private string? Error;private IEnumerable<WarehouseLocation> StocktakeLocations()=>WarehouseService.List().FirstOrDefault(x=>x.Id==(Guid.TryParse(WarehouseIdText,out var id)?id:Guid.Empty))?.Locations??[];private void Save(){if(!Guid.TryParse(ProductIdText,out var productId)||!Guid.TryParse(WarehouseIdText,out var warehouseId)||!decimal.TryParse(ActualQuantityText,out var actualQuantity)||string.IsNullOrWhiteSpace(SourceNo)){Error="请选择商品、仓库并输入有效实盘数量和盘点单号。";return;}Guid? locationId=Guid.TryParse(LocationIdText,out var parsedLocationId)?parsedLocationId:null;try{InventoryService.Stocktake(productId,warehouseId,actualQuantity,SourceNo,DateOnly.FromDateTime(DateTime.Today),locationId);Error="盘点完成，差异调整流水已生成。";}catch(Exception ex){Error=ex.Message;}}}
