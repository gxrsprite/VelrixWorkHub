@page "/Erp/PurchaseOrder"
@inject VelrixWorkHub.Application.PurchaseOrders.PurchaseOrderService OrderService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.Suppliers.SupplierService SupplierService
@inject VelrixWorkHub.Application.Settlements.SettlementService SettlementService
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@inject VelrixWorkHub.Application.Workflow.WorkflowBindingService WorkflowBindingService
@inject VelrixWorkHub.Application.Workflow.WorkflowApprovalService WorkflowApprovalService
@inject IAdminContext Admin
@using VelrixWorkHub.Domain
@using VelrixWorkHub.Application.Inventory
@using VelrixWorkHub.Application.Workflow
<PageTitle>采购订单 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/PurchaseOrder</p><h1>采购订单</h1><p class="task-page__intro">引用供应商和商品主数据，登记单行采购数量、单价和订单状态；提交前完成审批，收货后自动生成入库流水。</p></div></div>
<section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索采购订单" @bind="Keyword" @bind:event="oninput" placeholder="搜索订单号或来源单号" /></div><select aria-label="筛选采购订单状态" @bind="StatusFilterText"><option value="">全部状态</option><option value="Draft">草稿</option><option value="Submitted">已提交</option><option value="Received">已收货</option><option value="Closed">已关闭</option><option value="Cancelled">已取消</option></select><select aria-label="筛选采购来源" @bind="SourceKindFilterText"><option value="">全部来源</option><option value="Manual">手工录入</option><option value="Requisition">请购单</option><option value="Contract">采购合同</option><option value="Planning">需求计划</option><option value="ReorderPoint">ROP 补货</option></select><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建采购订单</button></section>
@if (ShowComposer) { <section class="task-composer" aria-label="新建采购订单"><div class="task-composer__title">新建采购订单</div><div class="task-composer__fields"><label>订单号<input aria-label="采购订单号" @bind="OrderNo" @bind:event="oninput" placeholder="PO-20260712-002" /></label><label>供应商<select aria-label="采购供应商" @bind="SupplierIdText"><option value="">请选择供应商</option>@foreach (var supplier in SupplierService.List()) { <option value="@supplier.Id">@supplier.Code · @supplier.Name</option> }</select></label></div><div class="task-composer__fields"><label>商品<select aria-label="采购商品" @bind="ProductIdText"><option value="">请选择商品</option>@foreach (var product in ProductService.List()) { <option value="@product.Id">@product.Code · @product.Name</option> }</select></label><label>数量<input aria-label="采购数量" @bind="QuantityText" @bind:event="oninput" placeholder="10" /></label></div><div class="task-composer__fields"><label>采购来源<select aria-label="采购来源" @bind="SourceKindText"><option value="Manual">手工录入</option><option value="Requisition">请购单</option><option value="Contract">采购合同</option><option value="Planning">需求计划</option><option value="ReorderPoint">ROP 补货</option></select></label><label>来源单号<input aria-label="采购来源单号" @bind="SourceDocumentNo" @bind:event="oninput" placeholder="手工录入可留空" /></label></div><div class="task-composer__fields"><label>采购单价<input aria-label="采购单价" @bind="UnitPriceText" @bind:event="oninput" placeholder="1280.00" /></label><label>付款到期日<input aria-label="付款到期日" @bind="DueDateText" @bind:event="oninput" placeholder="2026-08-18" /></label></div><div class="customer-note">默认订单日期后 30 天；不能早于订单日期。</div><div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存订单</button></div></section> }
@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }
<PurchaseOrderLockPanel Orders="FilteredOrders().ToArray()" />
@if (FilteredOrders().Any(x => x.IsLocked)) { <div class="customer-note" aria-label="采购订单锁定提示">当前筛选结果包含已锁定采购订单，锁定订单不能推进或取消。</div> }
<section class="task-list" aria-live="polite">@foreach (var item in FilteredOrders()) { var supplier = SupplierService.List().FirstOrDefault(x => x.Id == item.SupplierId); var product = ProductService.List().FirstOrDefault(x => x.Id == item.ProductId); var balance = SettlementService.GetOrderBalance(ErpSettlementKind.Payable, item.Id); var availability = Availability(item.ProductId); var workflow = WorkflowApprovalService.Latest(WorkflowBindingCodes.PurchaseOrderApproval, nameof(PurchaseOrder), item.Id); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-shopping-cart"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Status.ToString().ToLowerInvariant()">@StatusLabel(item.Status)</span><span>@item.OrderNo</span><span>@item.OrderDate.ToString("yyyy-MM-dd")</span></div><h2>@if (supplier is not null) { <a href="/Erp/SupplierLedger/@supplier.Id">@supplier.Name</a> } else { <span>未知供应商</span> }</h2><p>@(product?.Name ?? "未知商品") · 数量 @item.Quantity · 单价 ¥@item.UnitPrice.ToString("N2")</p><div class="customer-note">来源：@SourceLabel(item.SourceKind)@if (!string.IsNullOrWhiteSpace(item.SourceDocumentNo)) { <span> · @item.SourceDocumentNo</span> }</div><div class="customer-note">订单金额：¥@item.Amount.ToString("N2")@if(balance is not null){<span> · 已付 ¥@balance.SettledAmount.ToString("N2") · 待付 ¥@balance.RemainingAmount.ToString("N2")@if(balance.PendingAmount > 0){<span> · 待审批 ¥@balance.PendingAmount.ToString("N2")</span>} · </span><a href="/Erp/Settlement?orderId=@item.Id">核销明细</a>}</div><div class="customer-note">库存 @availability.OnHandQuantity.ToString("N2") · 待收货 @availability.SubmittedQuantity.ToString("N2") · 收货后预计 @availability.ProjectedQuantity.ToString("N2") · 审批 @(workflow is null ? "未发起" : workflow.Status switch { WorkflowInstanceStatus.Running => "审批中", WorkflowInstanceStatus.Completed => "已完成", WorkflowInstanceStatus.Rejected => "已拒绝", _ => "已撤回" })</div><AttachmentPanel BusinessType="PurchaseOrder" BusinessId="@item.Id" Actor="admin" /></div><div class="task-card__actions">@if (item.Status == PurchaseOrderStatus.Draft && (workflow is null || workflow.Status is WorkflowInstanceStatus.Rejected or WorkflowInstanceStatus.Cancelled)) { <button title="发起采购订单审批" @onclick="() => StartApproval(item)"><i class="fa fa-send-o"></i></button> } @if ((item.Status == PurchaseOrderStatus.Draft && workflow?.Status == WorkflowInstanceStatus.Completed) || item.Status is PurchaseOrderStatus.Submitted or PurchaseOrderStatus.Received or PurchaseOrderStatus.Closed) { <button title="@AdvanceTitle(item.Status)" @onclick="() => Advance(item)"><i class="fa fa-forward"></i></button> } @if ((item.Status is PurchaseOrderStatus.Draft or PurchaseOrderStatus.Submitted) && workflow?.Status != WorkflowInstanceStatus.Running) { <button class="danger" title="取消采购订单" @onclick="() => Cancel(item)"><i class="fa fa-ban"></i></button> }</div></article> }</section></div>
@code { [SupplyParameterFromQuery(Name="orderId")] public Guid? OrderId { get; set; } private string Keyword = string.Empty, StatusFilterText = string.Empty, SourceKindFilterText = string.Empty, OrderNo = string.Empty, SupplierIdText = string.Empty, ProductIdText = string.Empty, QuantityText = string.Empty, UnitPriceText = string.Empty, DueDateText = string.Empty, SourceKindText = nameof(PurchaseOrderSourceKind.Manual), SourceDocumentNo = string.Empty; private string? Error; private bool ShowComposer; private string CurrentActor => Admin.User?.Username?.Trim() ?? string.Empty; private PurchaseOrderInventoryAvailability Availability(Guid productId) => PurchaseOrderInventoryService.Get(productId, InventoryService.Balances(), OrderService.List()); private IEnumerable<PurchaseOrder> FilteredOrders() { var sourceKind = Enum.TryParse<PurchaseOrderSourceKind>(SourceKindFilterText, out var parsedSourceKind) ? parsedSourceKind : (PurchaseOrderSourceKind?)null; IEnumerable<PurchaseOrder> orders = OrderService.List(Keyword, sourceKind); if (OrderId is Guid id) { orders = orders.Where(x => x.Id == id); } return orders.Where(x => !Enum.TryParse<PurchaseOrderStatus>(StatusFilterText, out var status) || x.Status == status); } private void OpenComposer() { Error = null; DueDateText = DateTime.Today.AddDays(30).ToString("yyyy-MM-dd"); ShowComposer = true; } private void Close() { ShowComposer = false; Error = null; OrderNo = SupplierIdText = ProductIdText = QuantityText = UnitPriceText = DueDateText = SourceDocumentNo = string.Empty; SourceKindText = nameof(PurchaseOrderSourceKind.Manual); } private void Save() { if (!Guid.TryParse(SupplierIdText, out var supplierId) || !Guid.TryParse(ProductIdText, out var productId) || !decimal.TryParse(QuantityText, out var quantity) || !decimal.TryParse(UnitPriceText, out var unitPrice) || !DateOnly.TryParse(DueDateText, out var dueDate) || !Enum.TryParse<PurchaseOrderSourceKind>(SourceKindText, out var sourceKind)) { Error = "请选择供应商、商品、采购来源并输入有效数量、单价和付款到期日。"; return; } try { OrderService.Create(OrderNo, supplierId, productId, DateOnly.FromDateTime(DateTime.Today), quantity, unitPrice, sourceKind, SourceDocumentNo, dueDate); Close(); } catch (Exception ex) { Error = ex.Message; } } private void Advance(PurchaseOrder item) { try { if (item.Status == PurchaseOrderStatus.Draft) OrderService.SetStatus(item, PurchaseOrderStatus.Submitted); else if (item.Status == PurchaseOrderStatus.Submitted) OrderService.Receive(item); else if (item.Status == PurchaseOrderStatus.Received) OrderService.SetStatus(item, PurchaseOrderStatus.Closed); else if (item.Status == PurchaseOrderStatus.Closed) OrderService.SetStatus(item, PurchaseOrderStatus.Received); Error = null; } catch (Exception ex) { Error = ex.Message; } } private void StartApproval(PurchaseOrder item) { try { WorkflowBindingService.StartOrGet(WorkflowBindingCodes.PurchaseOrderApproval, nameof(PurchaseOrder), item.Id, startedBy: CurrentActor); Error = null; } catch (Exception ex) { Error = ex.Message; } } private void Cancel(PurchaseOrder item) { try { OrderService.SetStatus(item, PurchaseOrderStatus.Cancelled); Error = null; } catch (Exception ex) { Error = ex.Message; } } private static string AdvanceTitle(PurchaseOrderStatus status) => status switch { PurchaseOrderStatus.Received => "关闭采购订单", PurchaseOrderStatus.Closed => "打开采购订单", _ => "推进订单状态" }; private static string StatusLabel(PurchaseOrderStatus status) => status switch { PurchaseOrderStatus.Draft => "草稿", PurchaseOrderStatus.Submitted => "已提交", PurchaseOrderStatus.Received => "已收货", PurchaseOrderStatus.Cancelled => "已取消", PurchaseOrderStatus.Closed => "已关闭", _ => status.ToString() }; private static string SourceLabel(PurchaseOrderSourceKind kind) => kind switch { PurchaseOrderSourceKind.Manual => "手工录入", PurchaseOrderSourceKind.Requisition => "请购单", PurchaseOrderSourceKind.Contract => "采购合同", PurchaseOrderSourceKind.Planning => "需求计划", PurchaseOrderSourceKind.ReorderPoint => "ROP 补货", _ => kind.ToString() }; }
