@page "/Erp/Inventory"
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.Warehouses.WarehouseService WarehouseService
@using VelrixWorkHub.Application.Inventory
@using VelrixWorkHub.Domain
<PageTitle>库存流水 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/Inventory</p><h1>库存流水</h1><p class="task-page__intro">库存余额由不可变流水汇总，页面不直接修改库存数量。</p></div></div>
<section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索库存流水" @bind="Keyword" @bind:event="oninput" placeholder="搜索流水号或备注" /></div><div class="customer-search"><i class="fa fa-barcode"></i><input aria-label="筛选库存批次" @bind="BatchNoFilter" @bind:event="oninput" placeholder="批次号精确筛选" /></div><div class="customer-search"><i class="fa fa-barcode"></i><input aria-label="筛选库存序列号" @bind="SerialNoFilter" @bind:event="oninput" placeholder="序列号精确筛选" /></div><select aria-label="筛选流水类型" @bind="KindFilterText"><option value="">全部类型</option><option value="Inbound">入库</option><option value="Outbound">出库</option><option value="Adjustment">调整</option></select><select aria-label="筛选库存商品" @bind="ProductFilterText"><option value="">全部商品</option>@foreach(var item in ProductService.List()){<option value="@item.Id">@item.Code · @item.Name</option>}</select><select aria-label="筛选库存仓库" @bind="WarehouseFilterText"><option value="">全部仓库</option>@foreach(var item in WarehouseService.List()){<option value="@item.Id">@item.Code · @item.Name</option>}</select><select aria-label="筛选库存库位" @bind="LocationFilterText"><option value="">全部库位</option><option value="__none">未指定库位</option>@foreach(var item in WarehouseService.List().SelectMany(x=>x.Locations)){<option value="@item.Id">@item.Code · @item.Name</option>}</select><span>当前余额：@FilteredBalances().Sum(x => x.Quantity).ToString("N2")</span><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 登记库存流水</button></section>
<section class="task-list" aria-label="库存余额"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--active">实时余额</span><span>按商品 / 仓库汇总</span></div>@foreach (var balance in FilteredBalances()) { var product = ProductService.List().FirstOrDefault(x => x.Id == balance.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == balance.WarehouseId); <p>@(product?.Name ?? "未知商品") · @(warehouse?.Name ?? "未知仓库") · 结存 @balance.Quantity.ToString("N2")</p> }</div></div></section>
<section class="task-list" aria-label="库位余额"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--active">库位余额</span><span>按商品 / 仓库 / 库位汇总</span></div>@foreach (var balance in FilteredLocationBalances()) { var product = ProductService.List().FirstOrDefault(x => x.Id == balance.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == balance.WarehouseId); var location = warehouse?.Locations.FirstOrDefault(x => x.Id == balance.LocationId); <p>@(product?.Name ?? "未知商品") · @(warehouse?.Name ?? "未知仓库") · @(location?.Name ?? "未指定库位") · 结存 @balance.Quantity.ToString("N2")</p> }</div></div></section>
<section class="task-list" aria-label="批次余额"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--active">批次余额</span><span>按商品 / 仓库 / 库位 / 批次汇总</span></div>@foreach (var balance in FilteredBatchBalances()) { var product = ProductService.List().FirstOrDefault(x => x.Id == balance.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == balance.WarehouseId); var location = warehouse?.Locations.FirstOrDefault(x => x.Id == balance.LocationId); <p>@(product?.Name ?? "未知商品") · @(warehouse?.Name ?? "未知仓库") · @(location?.Name ?? "未指定库位") · 批次 @balance.BatchNo · 结存 @balance.Quantity.ToString("N2")@(balance.ExpiryDate is DateOnly expiryDate ? $" · 保质期 {expiryDate:yyyy-MM-dd}" : string.Empty)</p> }</div></div></section>
<section class="task-list" aria-label="序列号在库"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--active">序列号在库</span><span>按商品 / 仓库 / 库位 / 序列号追溯</span></div>@foreach (var balance in FilteredSerialBalances()) { var product = ProductService.List().FirstOrDefault(x => x.Id == balance.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == balance.WarehouseId); var location = warehouse?.Locations.FirstOrDefault(x => x.Id == balance.LocationId); <p>@(product?.Name ?? "未知商品") · @(warehouse?.Name ?? "未知仓库") · @(location?.Name ?? "未指定库位") · 序列号 @balance.SerialNo · 结存 @balance.Quantity.ToString("N2")</p> }</div></div></section>
<section class="task-list" aria-label="超储预警"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--pending">超储预警</span><span>所有仓库账面库存超过商品最大库存</span></div>@foreach (var alert in FilteredOverstockAlerts()) { <p><span class="task-status customer-status--pending">超储</span> @alert.ProductName · 当前 @alert.Quantity.ToString("N2") / 上限 @alert.MaxInventoryQuantity.ToString("N2") · 超出 @(alert.Quantity - alert.MaxInventoryQuantity).ToString("N2")</p> }</div></div></section>
<section class="task-list" aria-label="批次保质期预警"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--pending">批次保质期预警</span><span>已过期或未来 30 天到期</span></div>@foreach (var alert in FilteredExpiryAlerts()) { var product = ProductService.List().FirstOrDefault(x => x.Id == alert.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == alert.WarehouseId); var location = warehouse?.Locations.FirstOrDefault(x => x.Id == alert.LocationId); <p><span class="task-status customer-status--@(alert.IsExpired ? "rejected" : "pending")">@(alert.IsExpired ? "已过期" : "临期")</span> @(product?.Name ?? "未知商品") · @(warehouse?.Name ?? "未知仓库") · @(location?.Name ?? "未指定库位") · 批次 @alert.BatchNo · 结存 @alert.Quantity.ToString("N2") · 到期 @alert.ExpiryDate.ToString("yyyy-MM-dd")</p> }</div></div></section>
<section class="task-list" aria-label="呆滞批次预警"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--pending">呆滞批次预警</span><span>正余额且 180 天无流水</span></div>@foreach (var alert in FilteredStagnantBatchAlerts()) { var product = ProductService.List().FirstOrDefault(x => x.Id == alert.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == alert.WarehouseId); var location = warehouse?.Locations.FirstOrDefault(x => x.Id == alert.LocationId); <p><span class="task-status customer-status--pending">呆滞</span> @(product?.Name ?? "未知商品") · @(warehouse?.Name ?? "未知仓库") · @(location?.Name ?? "未指定库位") · 批次 @alert.BatchNo · 结存 @alert.Quantity.ToString("N2") · 最后流水 @alert.LastOccurredOn.ToString("yyyy-MM-dd")</p> }</div></div></section>
@if (ShowComposer) { <section class="task-composer" aria-label="登记库存流水"><div class="task-composer__title">登记库存流水</div><div class="task-composer__fields"><label>商品<select aria-label="库存商品" @bind="ProductIdText"><option value="">请选择商品</option>@foreach (var item in ProductService.List()) { <option value="@item.Id">@item.Code · @item.Name</option> }</select></label><label>仓库<select aria-label="库存仓库" @bind="WarehouseIdText"><option value="">请选择仓库</option>@foreach (var item in WarehouseService.List()) { <option value="@item.Id">@item.Code · @item.Name</option> }</select></label></div><div class="task-composer__fields"><label>库位<select aria-label="库存库位" @bind="LocationIdText"><option value="">不指定库位</option>@foreach (var location in ComposerLocations()) { <option value="@location.Id">@location.Code · @location.Name</option> }</select></label><label>流水类型<select aria-label="库存流水类型" @bind="KindText"><option value="Inbound">入库</option><option value="Outbound">出库</option><option value="Adjustment">调整</option></select></label></div><div class="task-composer__fields"><label>数量<input aria-label="库存数量" @bind="QuantityText" @bind:event="oninput" placeholder="10" /></label><label>流水单号<input aria-label="库存流水单号" @bind="SourceNo" @bind:event="oninput" placeholder="INV-20260712-002" /></label></div><div class="task-composer__fields"><label>批次号<input aria-label="库存批次号" @bind="BatchNo" @bind:event="oninput" placeholder="LOT-20260715-001" /></label><label>保质期<input aria-label="库存保质期" type="date" @bind="ExpiryDateValue" /></label></div><label>序列号<input aria-label="库存序列号" @bind="SerialNo" @bind:event="oninput" placeholder="SN-20260715-001" /></label>@if (KindText == "Outbound" && string.IsNullOrWhiteSpace(BatchNo) && string.IsNullOrWhiteSpace(SerialNo)) { <label class="task-check"><input aria-label="按先进先出自动分配批次" type="checkbox" @bind="UseFifoOutbound" /> 未指定批次和序列号时，按最早保质期自动分配（FIFO）</label> }@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存流水</button></div></section> }
<section class="task-list" aria-live="polite">@foreach (var item in FilteredTransactions()) { var product = ProductService.List().FirstOrDefault(x => x.Id == item.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == item.WarehouseId); var location = warehouse?.Locations.FirstOrDefault(x => x.Id == item.LocationId); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-cubes"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@(item.SignedQuantity >= 0 ? "active" : "inactive")">@KindLabel(item.Kind)</span><span>@item.SourceNo</span><span>@item.OccurredOn.ToString("yyyy-MM-dd")</span></div><h2>@(product?.Name ?? "未知商品")</h2><p>@(warehouse?.Name ?? "未知仓库") · @(location?.Name ?? "未指定库位") · 数量 @item.Quantity.ToString("N2")</p><div class="customer-note">库存变动：@(item.SignedQuantity >= 0 ? "+" : "")@item.SignedQuantity.ToString("N2")@if (!string.IsNullOrWhiteSpace(item.BatchNo)) { <span> · 批次 @item.BatchNo</span> }@if (item.ExpiryDate is DateOnly expiryDate) { <span> · 保质期 @expiryDate.ToString("yyyy-MM-dd")</span> }</div></div></article> }</section></div>
@code {
    [SupplyParameterFromQuery(Name = "warehouseId")] public Guid? WarehouseQueryId { get; set; }
    [SupplyParameterFromQuery(Name = "productId")] public Guid? ProductQueryId { get; set; }
    [SupplyParameterFromQuery(Name = "batchNo")] public string? BatchNoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "serialNo")] public string? SerialNoQuery { get; set; }

    private string Keyword = string.Empty, BatchNoFilter = string.Empty, SerialNoFilter = string.Empty, KindFilterText = string.Empty, ProductFilterText = string.Empty, WarehouseFilterText = string.Empty, LocationFilterText = string.Empty, ProductIdText = string.Empty, WarehouseIdText = string.Empty, LocationIdText = string.Empty, KindText = "Inbound", QuantityText = string.Empty, SourceNo = string.Empty, BatchNo = string.Empty, SerialNo = string.Empty;
    private DateTime? ExpiryDateValue;
    private string? Error;
    private bool ShowComposer, UseFifoOutbound;

    protected override void OnParametersSet()
    {
        if (WarehouseQueryId is Guid warehouseId)
        {
            WarehouseFilterText = warehouseId.ToString();
        }

        if (ProductQueryId is Guid productId)
        {
            ProductFilterText = productId.ToString();
        }

        if (!string.IsNullOrWhiteSpace(BatchNoQuery))
        {
            BatchNoFilter = BatchNoQuery.Trim();
        }

        if (!string.IsNullOrWhiteSpace(SerialNoQuery))
        {
            SerialNoFilter = SerialNoQuery.Trim();
        }
    }

    private IEnumerable<WarehouseLocation> ComposerLocations() => WarehouseService.List().FirstOrDefault(x => x.Id == (Guid.TryParse(WarehouseIdText, out var id) ? id : Guid.Empty))?.Locations ?? [];
    private InventoryTransactionKind? SelectedKind() => Enum.TryParse<InventoryTransactionKind>(KindFilterText, out var value) ? value : null;
    private Guid? SelectedProduct() => Guid.TryParse(ProductFilterText, out var value) ? value : null;
    private Guid? SelectedWarehouse() => Guid.TryParse(WarehouseFilterText, out var value) ? value : null;
    private IEnumerable<InventoryBalance> FilteredBalances() => InventoryService.Balances().Where(x => (SelectedProduct() is null || x.ProductId == SelectedProduct()) && (SelectedWarehouse() is null || x.WarehouseId == SelectedWarehouse()));
    private IEnumerable<InventoryLocationBalance> FilteredLocationBalances() => InventoryService.LocationBalances().Where(x => (SelectedProduct() is null || x.ProductId == SelectedProduct()) && (SelectedWarehouse() is null || x.WarehouseId == SelectedWarehouse()));
    private bool MatchesBatch(string batchNo) => string.IsNullOrWhiteSpace(BatchNoFilter) || batchNo.Equals(BatchNoFilter.Trim(), StringComparison.OrdinalIgnoreCase);
    private bool MatchesSerial(string serialNo) => string.IsNullOrWhiteSpace(SerialNoFilter) || serialNo.Equals(SerialNoFilter.Trim(), StringComparison.OrdinalIgnoreCase);
    private IEnumerable<InventoryBatchBalance> FilteredBatchBalances() => InventoryService.BatchBalances().Where(x => MatchesBatch(x.BatchNo) && (SelectedProduct() is null || x.ProductId == SelectedProduct()) && (SelectedWarehouse() is null || x.WarehouseId == SelectedWarehouse()) && (LocationFilterText == "" || LocationFilterText == "__none" && x.LocationId is null || Guid.TryParse(LocationFilterText, out var locationId) && x.LocationId == locationId));
    private IEnumerable<InventorySerialBalance> FilteredSerialBalances() => InventoryService.SerialBalances().Where(x => MatchesSerial(x.SerialNo) && (SelectedProduct() is null || x.ProductId == SelectedProduct()) && (SelectedWarehouse() is null || x.WarehouseId == SelectedWarehouse()) && (LocationFilterText == "" || LocationFilterText == "__none" && x.LocationId is null || Guid.TryParse(LocationFilterText, out var locationId) && x.LocationId == locationId));
    private IEnumerable<InventoryOverstockAlert> FilteredOverstockAlerts() => InventoryService.OverstockAlerts().Where(x => SelectedProduct() is null || x.ProductId == SelectedProduct());
    private IEnumerable<InventoryBatchExpiryAlert> FilteredExpiryAlerts() => InventoryService.ExpiryAlerts(DateOnly.FromDateTime(DateTime.Today)).Where(x => MatchesBatch(x.BatchNo) && (SelectedProduct() is null || x.ProductId == SelectedProduct()) && (SelectedWarehouse() is null || x.WarehouseId == SelectedWarehouse()) && (LocationFilterText == "" || LocationFilterText == "__none" && x.LocationId is null || Guid.TryParse(LocationFilterText, out var locationId) && x.LocationId == locationId));
    private IEnumerable<InventoryBatchStagnancyAlert> FilteredStagnantBatchAlerts() => InventoryService.StagnantBatchAlerts(DateOnly.FromDateTime(DateTime.Today)).Where(x => MatchesBatch(x.BatchNo) && (SelectedProduct() is null || x.ProductId == SelectedProduct()) && (SelectedWarehouse() is null || x.WarehouseId == SelectedWarehouse()) && (LocationFilterText == "" || LocationFilterText == "__none" && x.LocationId is null || Guid.TryParse(LocationFilterText, out var locationId) && x.LocationId == locationId));
    private IEnumerable<InventoryTransaction> FilteredTransactions() { var query = InventoryService.List(Keyword, SelectedKind(), SelectedWarehouse(), BatchNoFilter, SerialNoFilter).AsEnumerable(); if (SelectedProduct() is Guid productId) query = query.Where(x => x.ProductId == productId); if (LocationFilterText == "__none") query = query.Where(x => x.LocationId is null); else if (Guid.TryParse(LocationFilterText, out var locationId)) query = query.Where(x => x.LocationId == locationId); return query; }
    private void OpenComposer() { Error = null; ShowComposer = true; }
    private void Close() { ShowComposer = false; Error = null; ProductIdText = WarehouseIdText = LocationIdText = QuantityText = SourceNo = BatchNo = SerialNo = string.Empty; ExpiryDateValue = null; KindText = "Inbound"; UseFifoOutbound = false; }
    private void Save() { if (!Guid.TryParse(ProductIdText, out var productId) || !Guid.TryParse(WarehouseIdText, out var warehouseId) || !decimal.TryParse(QuantityText, out var quantity) || !Enum.TryParse<InventoryTransactionKind>(KindText, out var kind)) { Error = "请选择商品、仓库、流水类型并输入有效数量。"; return; } Guid? locationId = Guid.TryParse(LocationIdText, out var parsedLocationId) ? parsedLocationId : null; DateOnly? expiryDate = ExpiryDateValue is DateTime expiryValue ? DateOnly.FromDateTime(expiryValue) : null; try { if (kind == InventoryTransactionKind.Outbound && UseFifoOutbound && string.IsNullOrWhiteSpace(BatchNo) && string.IsNullOrWhiteSpace(SerialNo)) InventoryService.OutboundByFifo(productId, warehouseId, locationId, quantity, SourceNo, DateOnly.FromDateTime(DateTime.Today), null); else InventoryService.Create(productId, warehouseId, kind, quantity, SourceNo, DateOnly.FromDateTime(DateTime.Today), null, locationId, BatchNo, expiryDate, SerialNo); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private static string KindLabel(InventoryTransactionKind kind) => kind switch { InventoryTransactionKind.Inbound => "入库", InventoryTransactionKind.Outbound => "出库", _ => "调整" };
}
