@page "/Erp/Inventory"
@inject VelrixWorkHub.Application.Inventory.InventoryService InventoryService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject VelrixWorkHub.Application.Warehouses.WarehouseService WarehouseService
@using VelrixWorkHub.Domain
<PageTitle>库存流水 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">企业资源 · ERP/Inventory</p><h1>库存流水</h1><p class="task-page__intro">库存余额由不可变流水汇总，页面不直接修改库存数量。</p></div></div>
<section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索库存流水" @bind="Keyword" @bind:event="oninput" placeholder="搜索流水号或备注" /></div><select aria-label="筛选流水类型" @bind="KindFilterText"><option value="">全部类型</option><option value="Inbound">入库</option><option value="Outbound">出库</option><option value="Adjustment">调整</option></select><select aria-label="筛选库存仓库" @bind="WarehouseFilterText"><option value="">全部仓库</option>@foreach(var item in WarehouseService.List()){<option value="@item.Id">@item.Code · @item.Name</option>}</select><select aria-label="筛选库存库位" @bind="LocationFilterText"><option value="">全部库位</option><option value="__none">未指定库位</option>@foreach(var item in WarehouseService.List().SelectMany(x=>x.Locations)){<option value="@item.Id">@item.Code · @item.Name</option>}</select><span>当前余额：@InventoryService.Balances().Sum(x => x.Quantity).ToString("N2")</span><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 登记库存流水</button></section>
<section class="task-list" aria-label="库存余额"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--active">实时余额</span><span>按商品 / 仓库汇总</span></div>@foreach (var balance in InventoryService.Balances()) { var product = ProductService.List().FirstOrDefault(x => x.Id == balance.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == balance.WarehouseId); <p>@(product?.Name ?? "未知商品") · @(warehouse?.Name ?? "未知仓库") · 结存 @balance.Quantity.ToString("N2")</p> }</div></div></section>
<section class="task-list" aria-label="库位余额"><div class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--active">库位余额</span><span>按商品 / 仓库 / 库位汇总</span></div>@foreach (var balance in InventoryService.LocationBalances()) { var product = ProductService.List().FirstOrDefault(x => x.Id == balance.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == balance.WarehouseId); var location = warehouse?.Locations.FirstOrDefault(x => x.Id == balance.LocationId); <p>@(product?.Name ?? "未知商品") · @(warehouse?.Name ?? "未知仓库") · @(location?.Name ?? "未指定库位") · 结存 @balance.Quantity.ToString("N2")</p> }</div></div></section>
@if (ShowComposer) { <section class="task-composer" aria-label="登记库存流水"><div class="task-composer__title">登记库存流水</div><div class="task-composer__fields"><label>商品<select aria-label="库存商品" @bind="ProductIdText"><option value="">请选择商品</option>@foreach (var item in ProductService.List()) { <option value="@item.Id">@item.Code · @item.Name</option> }</select></label><label>仓库<select aria-label="库存仓库" @bind="WarehouseIdText"><option value="">请选择仓库</option>@foreach (var item in WarehouseService.List()) { <option value="@item.Id">@item.Code · @item.Name</option> }</select></label></div><div class="task-composer__fields"><label>库位<select aria-label="库存库位" @bind="LocationIdText"><option value="">不指定库位</option>@foreach (var location in ComposerLocations()) { <option value="@location.Id">@location.Code · @location.Name</option> }</select></label><label>流水类型<select aria-label="库存流水类型" @bind="KindText"><option value="Inbound">入库</option><option value="Outbound">出库</option><option value="Adjustment">调整</option></select></label></div><div class="task-composer__fields"><label>数量<input aria-label="库存数量" @bind="QuantityText" @bind:event="oninput" placeholder="10" /></label><label>流水单号<input aria-label="库存流水单号" @bind="SourceNo" @bind:event="oninput" placeholder="INV-20260712-002" /></label></div><div class="task-composer__fields"><label>批次号<input aria-label="库存批次号" @bind="BatchNo" @bind:event="oninput" placeholder="LOT-20260715-001" /></label><label>保质期<input aria-label="库存保质期" type="date" @bind="ExpiryDateValue" /></label></div>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存流水</button></div></section> }
<section class="task-list" aria-live="polite">@foreach (var item in FilteredTransactions()) { var product = ProductService.List().FirstOrDefault(x => x.Id == item.ProductId); var warehouse = WarehouseService.List().FirstOrDefault(x => x.Id == item.WarehouseId); var location = warehouse?.Locations.FirstOrDefault(x => x.Id == item.LocationId); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-cubes"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@(item.SignedQuantity >= 0 ? "active" : "inactive")">@KindLabel(item.Kind)</span><span>@item.SourceNo</span><span>@item.OccurredOn.ToString("yyyy-MM-dd")</span></div><h2>@(product?.Name ?? "未知商品")</h2><p>@(warehouse?.Name ?? "未知仓库") · @(location?.Name ?? "未指定库位") · 数量 @item.Quantity.ToString("N2")</p><div class="customer-note">库存变动：@(item.SignedQuantity >= 0 ? "+" : "")@item.SignedQuantity.ToString("N2")@if (!string.IsNullOrWhiteSpace(item.BatchNo)) { <span> · 批次 @item.BatchNo</span> }@if (item.ExpiryDate is DateOnly expiryDate) { <span> · 保质期 @expiryDate.ToString("yyyy-MM-dd")</span> }</div></div></article> }</section></div>
@code { private string Keyword = string.Empty, KindFilterText = string.Empty, WarehouseFilterText = string.Empty, LocationFilterText = string.Empty, ProductIdText = string.Empty, WarehouseIdText = string.Empty, LocationIdText = string.Empty, KindText = "Inbound", QuantityText = string.Empty, SourceNo = string.Empty, BatchNo = string.Empty; private DateTime? ExpiryDateValue; private string? Error; private bool ShowComposer; private IEnumerable<WarehouseLocation> ComposerLocations() => WarehouseService.List().FirstOrDefault(x => x.Id == (Guid.TryParse(WarehouseIdText, out var id) ? id : Guid.Empty))?.Locations ?? []; private InventoryTransactionKind? SelectedKind() => Enum.TryParse<InventoryTransactionKind>(KindFilterText, out var value) ? value : null; private Guid? SelectedWarehouse() => Guid.TryParse(WarehouseFilterText, out var value) ? value : null; private IEnumerable<InventoryTransaction> FilteredTransactions() { var query = InventoryService.List(Keyword, SelectedKind(), SelectedWarehouse()).AsEnumerable(); if (LocationFilterText == "__none") query = query.Where(x => x.LocationId is null); else if (Guid.TryParse(LocationFilterText, out var locationId)) query = query.Where(x => x.LocationId == locationId); return query; } private void OpenComposer() { Error = null; ShowComposer = true; } private void Close() { ShowComposer = false; Error = null; ProductIdText = WarehouseIdText = LocationIdText = QuantityText = SourceNo = BatchNo = string.Empty; ExpiryDateValue = null; KindText = "Inbound"; } private void Save() { if (!Guid.TryParse(ProductIdText, out var productId) || !Guid.TryParse(WarehouseIdText, out var warehouseId) || !decimal.TryParse(QuantityText, out var quantity) || !Enum.TryParse<InventoryTransactionKind>(KindText, out var kind)) { Error = "请选择商品、仓库、流水类型并输入有效数量。"; return; } Guid? locationId = Guid.TryParse(LocationIdText, out var parsedLocationId) ? parsedLocationId : null; DateOnly? expiryDate = ExpiryDateValue is DateTime expiryValue ? DateOnly.FromDateTime(expiryValue) : null; try { InventoryService.Create(productId, warehouseId, kind, quantity, SourceNo, DateOnly.FromDateTime(DateTime.Today), null, locationId, BatchNo, expiryDate); Close(); } catch (Exception ex) { Error = ex.Message; } } private static string KindLabel(InventoryTransactionKind kind) => kind switch { InventoryTransactionKind.Inbound => "入库", InventoryTransactionKind.Outbound => "出库", _ => "调整" }; }
