@page "/Mom/Operations"
@implements IDisposable
@inject AdminBlazor.IAdminContext Admin
@inject VelrixWorkHub.Web.Localization.UiLocalizationService L
@inject VelrixWorkHub.Application.Mom.MomOperationExecutionService OperationService
@inject VelrixWorkHub.Application.Mom.MomWorkOrderService WorkOrderService
@inject VelrixWorkHub.Application.Mom.MomWorkCenterService WorkCenterService
@inject VelrixWorkHub.Application.Mom.MomEquipmentService EquipmentService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@using VelrixWorkHub.Application.Mom
@using VelrixWorkHub.Domain

<PageTitle>@L.Text("工序执行与报工") - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">@L.Text("MOM 制造运营 · Mom/Operations")</p><h1>@L.Text("工序执行与报工")</h1><p class="task-page__intro">@L.Text("从已发布 BOM 的工序顺序冻结工单工序，按前序门禁受理、执行、暂停/恢复、报工和完工。工序状态与工单状态独立维护。")</p></div></div>
    <section class="task-composer" aria-label='@L.Text("选择生产工单")'>
        <div class="task-composer__title">@L.Text("选择生产工单")</div>
        <div class="task-composer__fields">
            <label>@L.Text("生产工单")<select aria-label='@L.Text("生产工单")' @bind="WorkOrderIdText"><option value="">@L.Text("请选择已下达或执行中的工单")</option>@foreach (var item in WorkOrders()) { var product = ProductService.List().FirstOrDefault(x => x.Id == item.ProductId); <option value="@item.Id">@item.WorkOrderNo · @(product?.Code ?? item.ProductId.ToString())</option> }</select></label>
            <div class="task-composer__actions">@if (Admin.AuthButton("Mom/Operations/Ensure")) { <button class="task-primary-button" @onclick="Ensure">@L.Text("生成/查看工序")</button> }</div>
        </div>
        @if (Error is not null) { <div class="task-error" role="alert">@Error</div> }
    </section>

    @if (OperationItems.Count > 0)
    {
        <section class="task-list" aria-label='@L.Text("工序列表")'>
            @foreach (var operation in OperationItems)
            {
                var center = WorkCenterService.List().FirstOrDefault(x => x.Id == operation.WorkCenterId);
                var workLogs = OperationService.ListWorkLogs(operation.Id);
                <article class="task-card customer-card">
                    <div class="customer-avatar"><i class="fa fa-gears"></i></div>
                    <div class="task-card__body">
                        <div class="task-card__meta"><span class="task-status customer-status--@operation.Status.ToString().ToLowerInvariant()">@StatusLabel(operation.Status)</span><span>@operation.OperationCode</span><span>@L.Text("工序") @operation.OperationSequence</span></div>
                        <h2>@L.Text("工序") @operation.OperationSequence</h2>
                        <p>@L.Text("工作中心")：@(center?.Code ?? operation.WorkCenterId.ToString()) · @L.Text("计划数量") @operation.PlannedQuantity.ToString("N6") · @L.Text("已报工") @operation.ReportedQuantity.ToString("N6") · @L.Text("良品") @operation.GoodQuantity.ToString("N6") · @L.Text("不良品") @operation.ScrapQuantity.ToString("N6") · @L.Text("剩余") @operation.RemainingQuantity.ToString("N6")</p>
                        <div class="customer-note">@L.Text("标准工时") @operation.StandardHours.ToString("N2") @L.Text("小时")（@L.Text("准备") @operation.StandardSetupHours.ToString("N2") @L.Text("小时") + @L.Text("单位运行") @operation.StandardRunHoursPerUnit.ToString("N4") @L.Text("小时/件")） · @L.Text("实际工时") @workLogs.Sum(x => x.Hours).ToString("N2") @L.Text("小时")</div>
                        @if (operation.AcceptedOn is DateTime accepted) { <div class="customer-note">@L.Text("受理")：@operation.AcceptedBy · @accepted.ToString("yyyy-MM-dd HH:mm")</div> }
                        @foreach (var report in OperationService.ListReports(operation.Id).Take(5))
                        {
                            <div class="customer-note">@L.Text("报工")：@report.Quantity.ToString("N6")（@L.Text("良品") @report.GoodQuantity.ToString("N6") / @L.Text("不良品") @report.ScrapQuantity.ToString("N6")）· @report.Actor · @report.OccurredOn.ToString("yyyy-MM-dd HH:mm")</div>
                            @if ((operation.Status is MomOperationStatus.InProgress or MomOperationStatus.Completed) && Admin.AuthButton("Mom/Operations/CorrectReport")) { <button class="btn btn-sm btn-link" @onclick="() => OpenCorrection(report)">@L.Text("更正报工")</button> }
                            @foreach (var correction in OperationService.ListCorrections(operation.Id).Where(x => x.ReportId == report.Id).Take(5)) { <div class="customer-note">@L.Text("报工更正")：-@correction.Quantity.ToString("N6")（@L.Text("良品") -@correction.GoodQuantity.ToString("N6") / @L.Text("不良品") -@correction.ScrapQuantity.ToString("N6")）· @correction.Actor · @correction.OccurredOn.ToString("yyyy-MM-dd HH:mm")</div> }
                        }
                        <div class="customer-note"><strong>@L.Text("工时记录")</strong> · @workLogs.Sum(x => x.Hours).ToString("N2") @L.Text("小时")</div>
                        @if (workLogs.Count == 0) { <div class="customer-note">@L.Text("暂无工时记录")</div> } else { @foreach (var workLog in workLogs.Take(5)) { <div class="customer-note">@workLog.OperatorName · @(workLog.EquipmentName ?? L.Text("历史记录无设备")) · @workLog.Hours.ToString("N2") @L.Text("小时") · @workLog.StartedOn.ToString("yyyy-MM-dd HH:mm") → @workLog.EndedOn.ToString("yyyy-MM-dd HH:mm") · @workLog.SourceNo</div> } }
                    </div>
                    <div class="task-card__actions">
                        @if (operation.Status == MomOperationStatus.Pending && Admin.AuthButton("Mom/Operations/Accept")) { <button title='@L.Text("受理工序")' @onclick="() => Accept(operation)"><i class="fa fa-check"></i></button> }
                        @if (operation.Status == MomOperationStatus.Ready && Admin.AuthButton("Mom/Operations/Start")) { <button title='@L.Text("开始工序")' @onclick="() => Start(operation)"><i class="fa fa-play"></i></button> }
                        @if (operation.Status == MomOperationStatus.InProgress && Admin.AuthButton("Mom/Operations/Pause")) { <button title='@L.Text("暂停工序")' @onclick="() => Pause(operation)"><i class="fa fa-pause"></i></button> }
                        @if (operation.Status == MomOperationStatus.Paused && Admin.AuthButton("Mom/Operations/Resume")) { <button title='@L.Text("恢复工序")' @onclick="() => Resume(operation)"><i class="fa fa-play-circle"></i></button> }
                        @if (operation.Status == MomOperationStatus.InProgress && Admin.AuthButton("Mom/Operations/Report")) { <button title='@L.Text("工序报工")' @onclick="() => OpenReport(operation)"><i class="fa fa-pencil"></i></button> }
                        @if (operation.Status == MomOperationStatus.InProgress && Admin.AuthButton("Mom/Operations/WorkLog")) { <button title='@L.Text("登记工时")' @onclick="() => OpenWorkLog(operation)"><i class="fa fa-clock-o"></i></button> }
                        @if (operation.Status == MomOperationStatus.InProgress && operation.RemainingQuantity <= 0 && Admin.AuthButton("Mom/Operations/Complete")) { <button title='@L.Text("工序完工")' @onclick="() => Complete(operation)"><i class="fa fa-flag-checkered"></i></button> }
                    </div>
                </article>
            }
        </section>
    }

    @if (ReportOperation is not null)
    {
        <section class="task-composer" aria-label='@L.Text("工序报工")'>
            <div class="task-composer__title">@L.Text("工序报工") · @ReportOperation.OperationCode</div>
            <div class="task-composer__fields"><label>@L.Text("良品数量")<input type="number" min="0" step="0.000001" @bind="GoodQuantityText" @bind:event="oninput" /></label><label>@L.Text("不良品数量")<input type="number" min="0" step="0.000001" @bind="ScrapQuantityText" @bind:event="oninput" /></label></div>
            <div class="task-composer__fields"><label>@L.Text("报工备注")<input @bind="ReportNotes" @bind:event="oninput" /></label><div class="task-composer__actions"><button class="task-secondary-button" @onclick="CloseReport">@L.Text("取消")</button>@if (Admin.AuthButton("Mom/Operations/Report")) { <button class="task-primary-button" @onclick="SaveReport">@L.Text("保存报工")</button> }</div></div>
        </section>
    }

    @if (CorrectionReport is not null)
    {
        <section class="task-composer" aria-label='@L.Text("更正报工")'>
            <div class="task-composer__title">@L.Text("更正报工") · @CorrectionReport.SourceNo</div>
            <div class="task-composer__fields"><label>@L.Text("更正良品数量")<input type="number" min="0" step="0.000001" @bind="CorrectionGoodQuantityText" @bind:event="oninput" /></label><label>@L.Text("更正不良品数量")<input type="number" min="0" step="0.000001" @bind="CorrectionScrapQuantityText" @bind:event="oninput" /></label></div>
            <div class="task-composer__fields"><label>@L.Text("更正备注")<input @bind="CorrectionNotes" @bind:event="oninput" /></label><div class="task-composer__actions"><button class="task-secondary-button" @onclick="CloseCorrection">@L.Text("取消")</button>@if (Admin.AuthButton("Mom/Operations/CorrectReport")) { <button class="task-primary-button" @onclick="SaveCorrection">@L.Text("保存报工更正")</button> }</div></div>
        </section>
    }

    @if (WorkLogOperation is not null)
    {
        <section class="task-composer" aria-label='@L.Text("登记工时")'>
            <div class="task-composer__title">@L.Text("登记工时") · @WorkLogOperation.OperationCode</div>
            <div class="task-composer__fields"><label>@L.Text("员工")<select aria-label='@L.Text("员工")' @bind="OperatorUserIdText"><option value="">@L.Text("请选择在职员工")</option>@foreach (var item in OperationService.ListActiveOperators()) { <option value="@item.UserId">@item.DisplayName · @item.Username</option> }</select></label><label>@L.Text("设备")<select aria-label='@L.Text("设备")' @bind="EquipmentIdText"><option value="">@L.Text("请选择启用设备")</option>@foreach (var item in EquipmentService.ListActive(WorkLogOperation.WorkCenterId)) { <option value="@item.Id">@item.Code · @item.Name@(string.IsNullOrWhiteSpace(item.Model) ? string.Empty : $" · {item.Model}")</option> }</select></label></div>
            <div class="task-composer__fields"><label>@L.Text("开始时间")<input type="datetime-local" @bind="WorkLogStarted" /></label><label>@L.Text("结束时间")<input type="datetime-local" @bind="WorkLogEnded" /></label></div>
            <div class="task-composer__fields"><label class="task-composer__field--full">@L.Text("工时备注")<input @bind="WorkLogNotes" @bind:event="oninput" /></label></div>
            <div class="task-composer__actions"><button class="task-secondary-button" @onclick="CloseWorkLog">@L.Text("取消")</button>@if (Admin.AuthButton("Mom/Operations/WorkLog")) { <button class="task-primary-button" @onclick="SaveWorkLog">@L.Text("保存工时")</button> }</div>
        </section>
    }
</div>

@code {
    private string WorkOrderIdText = string.Empty, GoodQuantityText = "0", ScrapQuantityText = "0", ReportNotes = string.Empty;
    private string CorrectionGoodQuantityText = "0", CorrectionScrapQuantityText = "0", CorrectionNotes = string.Empty;
    private string OperatorUserIdText = string.Empty, EquipmentIdText = string.Empty, WorkLogNotes = string.Empty;
    private DateTime WorkLogStarted, WorkLogEnded;
    private string? Error;
    private IReadOnlyList<MomWorkOrderOperation> OperationItems = [];
    private MomWorkOrderOperation? ReportOperation;
    private MomWorkOrderOperationReport? CorrectionReport;
    private MomWorkOrderOperation? WorkLogOperation;

    protected override async Task OnInitializedAsync() { L.Changed += OnLanguageChanged; await Admin.InitAsync(); }
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    private IReadOnlyList<MomWorkOrder> WorkOrders() => WorkOrderService.List().Where(x => x.Status is MomWorkOrderStatus.Released or MomWorkOrderStatus.InProgress or MomWorkOrderStatus.Completed).ToArray();
    private void Ensure()
    {
        try { OperationItems = OperationService.EnsureOperations(ParseRequired(WorkOrderIdText, "请选择生产工单")); Error = null; }
        catch (Exception ex) { Error = L.Text(ex.Message); }
    }
    private void Accept(MomWorkOrderOperation operation) { Execute(() => OperationService.Accept(operation.Id, Actor)); }
    private void Start(MomWorkOrderOperation operation) { Execute(() => OperationService.Start(operation.Id)); }
    private void Pause(MomWorkOrderOperation operation) { Execute(() => OperationService.Pause(operation.Id)); }
    private void Resume(MomWorkOrderOperation operation) { Execute(() => OperationService.Resume(operation.Id)); }
    private void Complete(MomWorkOrderOperation operation) { Execute(() => OperationService.Complete(operation.Id)); }
    private void Execute(Action action) { try { action(); Reload(); Error = null; } catch (Exception ex) { Error = L.Text(ex.Message); } }
    private void OpenReport(MomWorkOrderOperation operation) { ReportOperation = operation; GoodQuantityText = "0"; ScrapQuantityText = "0"; ReportNotes = string.Empty; Error = null; }
    private void CloseReport() => ReportOperation = null;
    private void OpenCorrection(MomWorkOrderOperationReport report) { CorrectionReport = report; CorrectionGoodQuantityText = "0"; CorrectionScrapQuantityText = "0"; CorrectionNotes = string.Empty; Error = null; }
    private void CloseCorrection() => CorrectionReport = null;
    private void OpenWorkLog(MomWorkOrderOperation operation)
    {
        WorkLogOperation = operation; var end = DateTime.Now; var start = end.AddHours(-1);
        OperatorUserIdText = OperationService.ListActiveOperators().FirstOrDefault(x => x.UserId == Admin.User?.Id)?.UserId.ToString() ?? string.Empty;
        EquipmentIdText = EquipmentService.ListActive(operation.WorkCenterId).FirstOrDefault()?.Id.ToString() ?? string.Empty;
        WorkLogStarted = start; WorkLogEnded = end; WorkLogNotes = string.Empty; Error = null;
    }
    private void CloseWorkLog() => WorkLogOperation = null;
    private void SaveReport()
    {
        if (ReportOperation is null) return;
        try
        {
            if (!decimal.TryParse(GoodQuantityText, out var good) || !decimal.TryParse(ScrapQuantityText, out var scrap)) throw new InvalidOperationException(L.Text("报工数量格式不正确。"));
            OperationService.Report(ReportOperation.Id, good, scrap, Actor, notes: ReportNotes);
            ReportOperation = null; Reload(); Error = null;
        }
        catch (Exception ex) { Error = L.Text(ex.Message); }
    }
    private void SaveCorrection()
    {
        if (CorrectionReport is null) return;
        try
        {
            if (!decimal.TryParse(CorrectionGoodQuantityText, out var good) || !decimal.TryParse(CorrectionScrapQuantityText, out var scrap)) throw new InvalidOperationException(L.Text("报工更正数量格式不正确。"));
            OperationService.CorrectReport(CorrectionReport.Id, good, scrap, Actor, notes: CorrectionNotes);
            CorrectionReport = null; Reload(); Error = null;
        }
        catch (Exception ex) { Error = L.Text(ex.Message); }
    }
    private void SaveWorkLog()
    {
        if (WorkLogOperation is null) return;
        try
        {
            if (!Guid.TryParse(OperatorUserIdText, out var operatorUserId)) throw new InvalidOperationException(L.Text("请选择在职员工"));
            if (!Guid.TryParse(EquipmentIdText, out var equipmentId)) throw new InvalidOperationException(L.Text("请选择启用设备"));
            OperationService.LogWork(WorkLogOperation.Id, operatorUserId, equipmentId, WorkLogStarted, WorkLogEnded, WorkLogNotes);
            WorkLogOperation = null; Reload(); Error = null;
        }
        catch (Exception ex) { Error = L.Text(ex.Message); }
    }
    private void Reload() => OperationItems = Guid.TryParse(WorkOrderIdText, out var id) ? OperationService.List(id) : [];
    private string Actor => Admin.User?.Username?.Trim() ?? string.Empty;
    private string StatusLabel(MomOperationStatus status) => L.Text(status switch { MomOperationStatus.Pending => "待受理", MomOperationStatus.Ready => "已受理", MomOperationStatus.InProgress => "执行中", MomOperationStatus.Paused => "已暂停", MomOperationStatus.Completed => "已完工", MomOperationStatus.Cancelled => "已取消", _ => status.ToString() });
    private Guid ParseRequired(string value, string key) => Guid.TryParse(value, out var id) ? id : throw new InvalidOperationException(L.Text(key));
    public void Dispose() => L.Changed -= OnLanguageChanged;
}
