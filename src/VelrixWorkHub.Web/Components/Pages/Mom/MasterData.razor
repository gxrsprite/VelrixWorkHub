@page "/Mom/MasterData"
@implements IDisposable
@inject AdminBlazor.IAdminContext Admin
@inject VelrixWorkHub.Web.Localization.UiLocalizationService L
@inject VelrixWorkHub.Application.Mom.MomFactoryService FactoryService
@inject VelrixWorkHub.Application.Mom.MomWorkCenterService WorkCenterService
@inject VelrixWorkHub.Application.Mom.MomEquipmentService EquipmentService
@using VelrixWorkHub.Domain

<PageTitle>@L.Text("制造基础主数据") - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">@L.Text("MOM 制造运营 · Mom/MasterData")</p><h1>@L.Text("制造基础主数据")</h1><p class="task-page__intro">@L.Text("维护工厂与工作中心，为工单发布、工序执行和后续排产提供可执行资源。")</p></div></div>
    <div class="task-composer__fields">
        <section class="task-composer" aria-label="@L.Text("工厂")"><div class="task-composer__title">@L.Text("工厂")</div><div class="task-composer__fields"><label>@L.Text("工厂编码")<input aria-label='@L.Text("工厂编码")' @bind="FactoryCode" @bind:event="oninput" placeholder="FACTORY-SH" /></label><label>@L.Text("工厂名称")<input aria-label='@L.Text("工厂名称")' @bind="FactoryName" @bind:event="oninput" placeholder="Velrix 上海工厂" /></label></div>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-primary-button" @onclick="CreateFactory">@L.Text("新增工厂")</button></div></section>
        <section class="task-composer" aria-label="@L.Text("工作中心")"><div class="task-composer__title">@L.Text("工作中心")</div><div class="task-composer__fields"><label>@L.Text("绑定工厂")<select aria-label='@L.Text("绑定工厂")' @bind="WorkCenterFactoryIdText"><option value="">@L.Text("请先创建启用工厂")</option>@foreach (var factory in ActiveFactories()) { <option value="@factory.Id">@factory.Code · @factory.Name</option> }</select></label><label>@L.Text("工作中心编码")<input aria-label='@L.Text("工作中心编码")' @bind="WorkCenterCode" @bind:event="oninput" placeholder="WC-ASSEMBLY-01" /></label></div><div class="task-composer__fields"><label>@L.Text("工作中心名称")<input aria-label='@L.Text("工作中心名称")' @bind="WorkCenterName" @bind:event="oninput" placeholder="总装一线" /></label><label>@L.Text("工作中心类型")<select @bind="WorkCenterTypeText">@foreach (var type in Enum.GetValues<MomWorkCenterType>()) { <option value="@type">@TypeLabel(type)</option> }</select></label></div><div class="task-composer__fields"><label>@L.Text("生产线名称")<input aria-label='@L.Text("生产线名称")' @bind="ProductionLineName" /></label><label>@L.Text("标准日工时")<input aria-label='@L.Text("标准日工时")' type="number" min="0.1" max="24" step="0.1" @bind="StandardHoursText" @bind:event="oninput" /></label></div><div class="task-composer__actions"><button class="task-primary-button" @onclick="CreateWorkCenter">@L.Text("新增工作中心")</button></div></section>
        <section class="task-composer" aria-label="@L.Text("设备")"><div class="task-composer__title">@L.Text("设备")</div><div class="task-composer__fields"><label>@L.Text("绑定工作中心")<select aria-label='@L.Text("绑定工作中心")' @bind="EquipmentWorkCenterIdText"><option value="">@L.Text("请选择启用工作中心")</option>@foreach (var center in ActiveWorkCenters()) { <option value="@center.Id">@center.Code · @center.Name</option> }</select></label><label>@L.Text("设备编码")<input aria-label='@L.Text("设备编码")' @bind="EquipmentCode" @bind:event="oninput" placeholder="EQ-ASM-01" /></label></div><div class="task-composer__fields"><label>@L.Text("设备名称")<input aria-label='@L.Text("设备名称")' @bind="EquipmentName" @bind:event="oninput" placeholder="一号装配台" /></label><label>@L.Text("设备型号")<input aria-label='@L.Text("设备型号")' @bind="EquipmentModel" @bind:event="oninput" placeholder="MODEL-100" /></label></div><div class="task-composer__actions"><button class="task-primary-button" @onclick="CreateEquipment">@L.Text("新增设备")</button></div></section>
    </div>
    <div class="task-list">
        <section class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-building"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("工厂")</span><span>@ActiveFactories().Count</span></div>@foreach (var factory in FactoryService.List()) { <div class="customer-note"><strong>@factory.Code · @factory.Name</strong> · @StatusLabel(factory.Status) <button class="btn btn-sm btn-link" @onclick="() => ToggleFactory(factory)">@L.Text(factory.Status == MomMasterDataStatus.Active ? "停用" : "启用")</button></div> }</div></section>
        <section class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-cogs"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("工作中心")</span><span>@WorkCenterService.List().Count</span></div>@foreach (var center in WorkCenterService.List()) { var factory = FactoryService.List().FirstOrDefault(x => x.Id == center.FactoryId); <div class="customer-note"><strong>@center.Code · @center.Name</strong> · @(factory?.Code ?? "-") · @TypeLabel(center.Type) · @L.Text("标准日工时") @center.StandardHoursPerDay.ToString("N1") · @StatusLabel(center.Status)<button class="btn btn-sm btn-link" @onclick="() => ToggleWorkCenter(center)">@L.Text(center.Status == MomMasterDataStatus.Active ? "停用" : "启用")</button></div> }</div></section>
        <section class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-wrench"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("设备")</span><span>@EquipmentService.List().Count</span></div>@foreach (var equipment in EquipmentService.List()) { var center = WorkCenterService.List().FirstOrDefault(x => x.Id == equipment.WorkCenterId); <div class="customer-note"><strong>@equipment.Code · @equipment.Name</strong> · @(center?.Code ?? "-") · @(equipment.Model ?? L.Text("未填写")) · @StatusLabel(equipment.Status)<button class="btn btn-sm btn-link" @onclick="() => ToggleEquipment(equipment)">@L.Text(equipment.Status == MomMasterDataStatus.Active ? "停用" : "启用")</button></div> }</div></section>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync() { L.Changed += OnLanguageChanged; await Admin.InitAsync(); }
    private string FactoryCode = string.Empty, FactoryName = string.Empty, WorkCenterFactoryIdText = string.Empty, WorkCenterCode = string.Empty, WorkCenterName = string.Empty, WorkCenterTypeText = nameof(MomWorkCenterType.Assembly), ProductionLineName = string.Empty, StandardHoursText = "8";
    private string EquipmentWorkCenterIdText = string.Empty, EquipmentCode = string.Empty, EquipmentName = string.Empty, EquipmentModel = string.Empty;
    private string? Error;
    private IReadOnlyList<MomFactory> ActiveFactories() => FactoryService.List(MomMasterDataStatus.Active);
    private IReadOnlyList<MomWorkCenter> ActiveWorkCenters() => WorkCenterService.List(status: MomMasterDataStatus.Active);
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    private void CreateFactory() { try { FactoryService.Create(FactoryCode, FactoryName); FactoryCode = FactoryName = string.Empty; Error = null; } catch (Exception ex) { Error = L.Text(ex.Message); } }
    private void CreateWorkCenter() { try { if (!Guid.TryParse(WorkCenterFactoryIdText, out var factoryId)) throw new InvalidOperationException(L.Text("请先创建启用工厂")); if (!Enum.TryParse<MomWorkCenterType>(WorkCenterTypeText, out var type)) throw new InvalidOperationException(L.Text("工作中心类型无效。")); if (!decimal.TryParse(StandardHoursText, out var hours)) throw new InvalidOperationException(L.Text("标准日工时格式不正确。")); WorkCenterService.Create(factoryId, WorkCenterCode, WorkCenterName, type, hours, ProductionLineName); WorkCenterCode = WorkCenterName = ProductionLineName = string.Empty; Error = null; } catch (Exception ex) { Error = L.Text(ex.Message); } }
    private void CreateEquipment() { try { if (!Guid.TryParse(EquipmentWorkCenterIdText, out var workCenterId)) throw new InvalidOperationException(L.Text("请选择启用工作中心")); EquipmentService.Create(workCenterId, EquipmentCode, EquipmentName, EquipmentModel); EquipmentCode = EquipmentName = EquipmentModel = string.Empty; Error = null; } catch (Exception ex) { Error = L.Text(ex.Message); } }
    private void ToggleFactory(MomFactory factory) { try { FactoryService.SetActive(factory, factory.Status != MomMasterDataStatus.Active); Error = null; } catch (Exception ex) { Error = L.Text(ex.Message); } }
    private void ToggleWorkCenter(MomWorkCenter center) { try { WorkCenterService.SetActive(center, center.Status != MomMasterDataStatus.Active); Error = null; } catch (Exception ex) { Error = L.Text(ex.Message); } }
    private void ToggleEquipment(MomEquipment equipment) { try { EquipmentService.SetActive(equipment, equipment.Status != MomMasterDataStatus.Active); Error = null; } catch (Exception ex) { Error = L.Text(ex.Message); } }
    private string StatusLabel(MomMasterDataStatus status) => L.Text(status == MomMasterDataStatus.Active ? "启用" : "停用");
    private string TypeLabel(MomWorkCenterType type) => L.Text(type switch { MomWorkCenterType.ProductionLine => "生产线", MomWorkCenterType.Assembly => "装配", MomWorkCenterType.Machining => "机加工", MomWorkCenterType.Testing => "测试", MomWorkCenterType.Warehouse => "仓储", MomWorkCenterType.Outsourced => "外协", _ => type.ToString() });
    public void Dispose() => L.Changed -= OnLanguageChanged;
}
