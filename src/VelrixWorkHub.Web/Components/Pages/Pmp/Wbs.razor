@page "/Pmp/Wbs"
@inject VelrixWorkHub.Application.PmpProjects.PmpWbsTaskService WbsService
@inject VelrixWorkHub.Application.PmpProjects.PmpProjectService ProjectService
@using VelrixWorkHub.Domain

<PageTitle>项目 WBS - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMP 项目管理 · Pmp/Wbs</p><h1>WBS 任务树</h1><p class="task-page__intro">按父子层级拆解项目工作包，维护负责人、工期、里程碑和完成度。</p></div></div>
    <section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索 WBS 任务" @bind="Keyword" @bind:event="oninput" placeholder="搜索任务或负责人" /></div><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建 WBS 任务</button></section>
    @if (SelectedProject is not null)
    {
        <div class="task-context-note" role="status">当前项目：@SelectedProject.Code · @SelectedProject.Name（来自项目组合上下文）</div>
    }
    @if (ShowComposer || Editing is not null)
    {
        <section class="task-composer" aria-label="WBS 任务编辑"><div class="task-composer__title">@(Editing is null ? "新建 WBS 任务" : "编辑 WBS 任务")</div>
            <div class="task-composer__fields"><label>所属项目<select aria-label="所属项目" @bind="ProjectIdText"><option value="">请选择项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select></label><label>父任务<select aria-label="父任务" @bind="ParentIdText"><option value="">根任务</option>@foreach (var parent in WbsService.List(Guid.TryParse(ProjectIdText, out var pid) ? pid : null).Where(x => x.Id != Editing?.Id)) { <option value="@parent.Id">@parent.Title</option> }</select></label></div>
            <div class="task-composer__fields"><label>任务名称<input aria-label="任务名称" @bind="Title" @bind:event="oninput" placeholder="确认客户需求" /></label><label>负责人<input aria-label="负责人" @bind="Assignee" @bind:event="oninput" placeholder="项目经理" /></label></div>
            <div class="task-composer__fields"><label>顺序<input aria-label="顺序" type="number" min="1" @bind="SequenceText" @bind:event="oninput" /><span><input aria-label="是否里程碑" type="checkbox" @bind="IsMilestone" /> 里程碑</span></label><label>计划开始<input aria-label="计划开始" @bind="StartText" @bind:event="oninput" placeholder="2026-07-12" /></label></div>
            <label>计划结束<input aria-label="计划结束" @bind="EndText" @bind:event="oninput" placeholder="2026-07-26" /></label>
            @if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存任务</button></div>
        </section>
    }
    <section class="task-list" aria-live="polite">@foreach (var item in VisibleTasks()) { var project = ProjectService.List().FirstOrDefault(x => x.Id == item.ProjectId); <article class="task-card customer-card" style="margin-left:@(Depth(item) * 28)px"><div class="customer-avatar"><i class="fa @(item.IsMilestone ? "fa-flag" : "fa-tasks")"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Status.ToString().ToLowerInvariant()">@(item.IsMilestone ? "里程碑" : StatusLabel(item.Status))</span><span>@(project?.Code ?? "未知项目") · 顺序 @item.Sequence</span></div><h2>@item.Title</h2><p>@(item.AssigneeName ?? "未指定负责人") · @item.PlannedStart.ToString() 至 @item.PlannedEnd.ToString()</p><div class="customer-note">@StatusLabel(item.Status) · 完成度 @item.PercentComplete%</div></div><div class="task-card__actions"><button title="编辑" @onclick="() => OpenEditor(item)"><i class="fa fa-pencil"></i></button><button title="推进状态" @onclick="() => Advance(item)"><i class="fa fa-forward"></i></button><button class="danger" title="删除" @onclick="() => WbsService.Remove(item)"><i class="fa fa-trash-o"></i></button></div></article> }</section>
</div>
@code {
    [SupplyParameterFromQuery(Name = "projectId")] public Guid? ProjectFilterId { get; set; }
    private string Keyword = string.Empty, ProjectIdText = string.Empty, ParentIdText = string.Empty, Title = string.Empty, Assignee = string.Empty, SequenceText = "1", StartText = DateTime.Today.ToString("yyyy-MM-dd"), EndText = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
    private bool IsMilestone; private string? Error; private bool ShowComposer; private PmpWbsTask? Editing;
    private PmpProject? SelectedProject => ProjectFilterId is null ? null : ProjectService.List().FirstOrDefault(x => x.Id == ProjectFilterId.Value);
    private IEnumerable<PmpWbsTask> VisibleTasks() => WbsService.List(ProjectFilterId, Keyword).Where(x => ProjectIdText.Length == 0 || x.ProjectId.ToString() == ProjectIdText);
    private int Depth(PmpWbsTask item) { var all = WbsService.List(item.ProjectId); var depth = 0; var parent = item.ParentId; while (parent is not null && depth < 20) { depth++; parent = all.FirstOrDefault(x => x.Id == parent)?.ParentId; } return depth; }
    private void OpenComposer() { Close(); ShowComposer = true; }
    private void OpenEditor(PmpWbsTask x) { Close(); Editing = x; ProjectIdText = x.ProjectId.ToString(); ParentIdText = x.ParentId?.ToString() ?? string.Empty; Title = x.Title; Assignee = x.AssigneeName ?? string.Empty; SequenceText = x.Sequence.ToString(); IsMilestone = x.IsMilestone; StartText = x.PlannedStart.ToString(); EndText = x.PlannedEnd.ToString(); }
    private void Close() { ShowComposer = false; Editing = null; Error = null; ProjectIdText = ParentIdText = Title = Assignee = string.Empty; SequenceText = "1"; IsMilestone = false; StartText = DateTime.Today.ToString("yyyy-MM-dd"); EndText = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd"); }
    private void Save() { if (!Guid.TryParse(ProjectIdText, out var projectId) || !DateOnly.TryParse(StartText, out var start) || !DateOnly.TryParse(EndText, out var end) || !int.TryParse(SequenceText, out var sequence)) { Error = "项目、顺序或计划日期格式不正确。"; return; } try { Guid? parent = Guid.TryParse(ParentIdText, out var parentId) ? parentId : null; if (Editing is null) WbsService.Create(projectId, parent, Title, Assignee, sequence, start, end, IsMilestone); else WbsService.Edit(Editing, parent, Title, Assignee, sequence, start, end, IsMilestone); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private void Advance(PmpWbsTask x) { var next = x.Status switch { PmpWbsTaskStatus.Todo => PmpWbsTaskStatus.InProgress, PmpWbsTaskStatus.InProgress => PmpWbsTaskStatus.Done, _ => x.Status }; WbsService.SetStatus(x, next); }
    private static string StatusLabel(PmpWbsTaskStatus status) => status switch { PmpWbsTaskStatus.Todo => "待开始", PmpWbsTaskStatus.InProgress => "进行中", PmpWbsTaskStatus.Done => "已完成", _ => status.ToString() };
}
