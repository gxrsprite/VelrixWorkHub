@page "/Pmp/Issue"
@inject VelrixWorkHub.Application.PmpProjects.PmpProjectIssueService IssueService
@inject VelrixWorkHub.Application.PmpProjects.PmpProjectService ProjectService
@using VelrixWorkHub.Domain
<PageTitle>项目风险与问题 - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMP 项目管理 · Pmp/Issue</p><h1>风险与问题</h1><p class="task-page__intro">集中登记项目风险和问题，跟踪优先级、责任人、截止日期与处理状态。</p></div></div>
    <section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索风险问题" @bind="Keyword" @bind:event="oninput" placeholder="搜索标题或责任人" /></div><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建记录</button></section>
    @if (SelectedProject is not null)
    {
        <div class="task-context-note" role="status">当前项目：@SelectedProject.Code · @SelectedProject.Name（来自项目组合上下文）</div>
    }
    @if (ShowComposer || Editing is not null)
    {
        <section class="task-composer" aria-label="风险问题编辑"><div class="task-composer__title">@(Editing is null ? "新建风险/问题" : "编辑风险/问题")</div>
            <div class="task-composer__fields"><label>所属项目<select aria-label="所属项目" @bind="ProjectIdText"><option value="">请选择项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select></label><label>类型<select aria-label="风险问题类型" @bind="KindText"><option value="Risk">风险</option><option value="Issue">问题</option></select></label></div>
            <div class="task-composer__fields"><label>标题<input aria-label="风险问题标题" @bind="Title" @bind:event="oninput" placeholder="客户需求确认延期风险" /></label><label>责任人<input aria-label="责任人" @bind="Owner" @bind:event="oninput" placeholder="项目经理" /></label></div>
            <div class="task-composer__fields"><label>优先级<select aria-label="优先级" @bind="PriorityText"><option value="Low">低</option><option value="Medium">中</option><option value="High">高</option><option value="Critical">紧急</option></select></label><label>截止日期<input aria-label="截止日期" @bind="DueText" @bind:event="oninput" placeholder="2026-07-19" /></label></div>
            <label>描述<textarea aria-label="描述" @bind="Description" @bind:event="oninput" rows="2"></textarea></label>
            @if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存记录</button></div>
        </section>
    }
    <section class="task-list" aria-live="polite">@foreach (var item in IssueService.List(ProjectFilterId, Keyword)) { var project = ProjectService.List().FirstOrDefault(x => x.Id == item.ProjectId); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa @(item.Kind == PmpProjectIssueKind.Risk ? "fa-warning" : "fa-exclamation-circle")"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Status.ToString().ToLowerInvariant()">@KindLabel(item.Kind) · @PriorityLabel(item.Priority)</span><span>@(project?.Code ?? "未知项目")</span></div><h2>@item.Title</h2><p>@(item.OwnerName ?? "未指定责任人") · 截止 @(item.DueDate?.ToString() ?? "未设置")</p><div class="customer-note">@StatusLabel(item.Status) · @(item.Description ?? "无描述")</div><AttachmentPanel BusinessType="PmpProjectIssue" BusinessId="@item.Id" Actor="admin" /></div><div class="task-card__actions"><button title="推进状态" @onclick="() => Advance(item)"><i class="fa fa-forward"></i></button><button title="编辑" @onclick="() => OpenEditor(item)"><i class="fa fa-pencil"></i></button><button class="danger" title="删除" @onclick="() => IssueService.Remove(item)"><i class="fa fa-trash-o"></i></button></div></article> }</section>
</div>
@code {
    [SupplyParameterFromQuery(Name = "projectId")] public Guid? ProjectFilterId { get; set; }
    private PmpProject? SelectedProject => ProjectFilterId is null ? null : ProjectService.List().FirstOrDefault(x => x.Id == ProjectFilterId.Value);
    private string Keyword = string.Empty, ProjectIdText = string.Empty, KindText = "Risk", Title = string.Empty, Description = string.Empty, Owner = string.Empty, PriorityText = "Medium", DueText = string.Empty; private string? Error; private bool ShowComposer; private PmpProjectIssue? Editing;
    private void OpenComposer() { Close(); ShowComposer = true; }
    private void OpenEditor(PmpProjectIssue x) { Close(); Editing = x; ProjectIdText = x.ProjectId.ToString(); KindText = x.Kind.ToString(); Title = x.Title; Description = x.Description ?? string.Empty; Owner = x.OwnerName ?? string.Empty; PriorityText = x.Priority.ToString(); DueText = x.DueDate?.ToString() ?? string.Empty; }
    private void Close() { ShowComposer = false; Editing = null; Error = null; ProjectIdText = Title = Description = Owner = DueText = string.Empty; KindText = "Risk"; PriorityText = "Medium"; }
    private void Save() { if (!Guid.TryParse(ProjectIdText, out var projectId) || (!string.IsNullOrWhiteSpace(DueText) && !DateOnly.TryParse(DueText, out _))) { Error = "请选择项目或检查截止日期格式。"; return; } try { var kind = Enum.Parse<PmpProjectIssueKind>(KindText); var priority = Enum.Parse<PmpProjectIssuePriority>(PriorityText); DateOnly? due = DateOnly.TryParse(DueText, out var date) ? date : null; if (Editing is null) IssueService.Create(projectId, kind, Title, Description, Owner, priority, due); else IssueService.Edit(Editing, kind, Title, Description, Owner, priority, due); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private void Advance(PmpProjectIssue x) { var next = x.Status switch { PmpProjectIssueStatus.Open => PmpProjectIssueStatus.InProgress, PmpProjectIssueStatus.InProgress => PmpProjectIssueStatus.Resolved, PmpProjectIssueStatus.Resolved => PmpProjectIssueStatus.Closed, _ => x.Status }; IssueService.SetStatus(x, next); }
    private static string KindLabel(PmpProjectIssueKind kind) => kind == PmpProjectIssueKind.Risk ? "风险" : "问题";
    private static string PriorityLabel(PmpProjectIssuePriority priority) => priority switch { PmpProjectIssuePriority.Low => "低", PmpProjectIssuePriority.Medium => "中", PmpProjectIssuePriority.High => "高", PmpProjectIssuePriority.Critical => "紧急", _ => priority.ToString() };
    private static string StatusLabel(PmpProjectIssueStatus status) => status switch { PmpProjectIssueStatus.Open => "开放", PmpProjectIssueStatus.InProgress => "处理中", PmpProjectIssueStatus.Resolved => "已解决", PmpProjectIssueStatus.Closed => "已关闭", _ => status.ToString() };
}
