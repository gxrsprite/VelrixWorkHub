@page "/Pmp/Project"
@inject AdminBlazor.IAdminContext Admin
@inject VelrixWorkHub.Application.PmpProjects.PmpProjectService ProjectService
@inject VelrixWorkHub.Application.Customers.CustomerService CustomerService
@inject VelrixWorkHub.Application.Contracts.SalesContractService ContractService
@inject VelrixWorkHub.Application.SalesOrders.SalesOrderService SalesOrderService
@inject VelrixWorkHub.Application.PmpProjects.PmpWbsTaskService WbsService
@inject VelrixWorkHub.Application.PmpProjects.PmpProjectIssueService IssueService
@inject VelrixWorkHub.Application.PmpProjects.PmpEvmService EvmService
@inject VelrixWorkHub.Application.Settlements.SettlementService SettlementService
@using VelrixWorkHub.Domain
@using VelrixWorkHub.Application.Customers
@using VelrixWorkHub.Application.PmpProjects
<PageTitle>项目管理 - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMP 项目管理 · Pmp/Project</p><h1>项目管理</h1><p class="task-page__intro">维护项目主数据，为阶段、里程碑、WBS 任务和项目流程提供根节点。</p></div></div>
    <section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索项目" @bind="Keyword" @bind:event="oninput" placeholder="搜索项目编号、名称或经理" /></div><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建项目</button></section>
    @if (ShowComposer || Editing is not null)
    {
        <section class="task-composer" aria-label="项目编辑"><div class="task-composer__title">@(Editing is null ? "新建项目" : "编辑项目") · 立项信息</div><div class="task-composer__fields"><label>项目编号<input aria-label="项目编号" @bind="Code" @bind:event="oninput" placeholder="PRJ-002" /></label><label>项目名称<input aria-label="项目名称" @bind="Name" @bind:event="oninput" placeholder="项目名称" /></label></div><div class="task-composer__fields"><label>立项类型<select @bind="InitiationMode"><option value="PreInitiation">预立项</option><option value="FormalInitiation">正式立项</option></select></label><label>项目别称<input @bind="ProjectAlias" /></label></div><div class="task-composer__fields"><label>项目中文名称<input @bind="ProjectChineseName" /></label><label>项目英文名称<input @bind="ProjectEnglishName" /></label></div><div class="task-composer__fields"><label>产品名称<input @bind="ProductName" /></label><label>项目阶段<input @bind="ProjectStage" placeholder="需求/开发/交付" /></label></div><div class="task-composer__fields"><label>所属产品线<input @bind="ProductLine" /></label><label>项目大类<input @bind="ProjectCategory" /></label></div><div class="task-composer__fields"><label>项目小类<input @bind="ProjectSubcategory" /></label><label>项目小类代号<input @bind="ProjectSubcategoryCode" /></label></div><div class="task-composer__fields"><label>版本类型<input @bind="VersionType" /></label><label>项目版本<input @bind="ProjectVersion" /></label></div><div class="task-composer__fields"><label>客户<select aria-label="项目客户" @bind="CustomerIdText"><option value="">不关联客户</option>@foreach (var customer in CustomerService.List(filter: CustomerFilter.Active)) { <option value="@customer.Id">@customer.Name</option> }</select></label><label>项目经理<input aria-label="项目经理" @bind="Manager" @bind:event="oninput" /></label></div><div class="task-composer__fields"><label>预计立项时间<input type="date" @bind="ExpectedInitiationDate" /></label><label>实际立项时间<input type="date" @bind="ActualInitiationDate" /></label></div><div class="task-composer__fields"><label>计划开始<input aria-label="计划开始" type="text" @bind="StartText" @bind:event="oninput" placeholder="2026-07-12" /></label><label>计划结束<input aria-label="计划结束" type="text" @bind="EndText" @bind:event="oninput" placeholder="2026-09-12" /></label></div><div class="task-composer__fields"><label>开发方式<input @bind="DevelopmentMode" /></label><label>所属部门<input @bind="DepartmentName" /></label></div><div class="task-composer__fields"><label>研发领域经理<input @bind="DomainManagerName" placeholder="支持多人，逗号分隔" /></label><label>业务发起方<input @bind="BusinessInitiatorName" placeholder="支持多人，逗号分隔" /></label></div><div class="task-composer__fields"><label class="task-composer__field--full">项目概况<textarea @bind="Overview"></textarea></label></div><div class="task-composer__fields"><label class="task-composer__field--full">项目目标<textarea @bind="Objective"></textarea></label></div>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存项目</button></div></section>
    }
    @if (StatusEditing is not null)
    {
        <section class="task-composer" aria-label="项目状态变更"><div class="task-composer__title">变更项目状态 · @StatusEditing.Code</div><div class="task-composer__fields"><label>当前状态<input value="@StatusLabel(StatusEditing.Status)" readonly /></label><label>目标状态<select @bind="DraftStatus">@foreach (var status in Enum.GetValues<PmpProjectStatus>()) { <option value="@status">@StatusLabel(status)</option> }</select></label></div><div class="task-composer__fields"><label class="task-composer__field--full">变更说明<textarea @bind="StatusReason" placeholder="请说明状态变更原因、影响和后续动作"></textarea></label></div>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="CloseStatusEditor">取消</button><button class="task-primary-button" @onclick="SaveStatus">保存状态</button></div></section>
    }
    <section class="task-list" aria-live="polite">
        @foreach (var item in FilteredProjects())
        {
            var contracts = ContractService.List().Where(x => x.CustomerId == item.CustomerId && x.Status == ContractStatus.Active).ToArray();
            var commercial = PmpProjectCommercialInsightService.Build(item, SalesOrderService.List(), SettlementService.List(), ContractService.List()); var fulfillmentOrders = PmpProjectCommercialInsightService.Orders(item, SalesOrderService.List(), SettlementService.List());
            var wbs = WbsService.List(item.Id); var openIssues = IssueService.List(item.Id).Count(x => x.Status is not PmpProjectIssueStatus.Resolved and not PmpProjectIssueStatus.Closed); var evm = EvmService.List().FirstOrDefault(x => x.Project.Id == item.Id);
            <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-briefcase"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Status.ToString().ToLowerInvariant()">@StatusLabel(item.Status)</span><span>@item.Code</span><span>@(item.InitiationMode == PmpProjectInitiationMode.FormalInitiation ? "正式立项" : "预立项")</span></div><h2>@item.Name</h2><p>@(item.ProjectAlias ?? item.ProjectChineseName ?? "未填写中文名称") · @(item.ManagerName ?? "未指定经理") · @item.PlannedStart.ToString() 至 @item.PlannedEnd.ToString()</p><div class="customer-note">产品 @(@item.ProductName ?? "未填写") · 版本 @(@item.ProjectVersion ?? "未填写") · 产品线 @(@item.ProductLine ?? "未填写") · 完成度 @item.PercentComplete% · WBS @wbs.Count · 未关闭风险问题 @openIssues@if (evm is not null) { <span> · SPI @evm.SchedulePerformanceIndex.ToString("N2")</span> }@if (contracts.Length > 0) { <span> · </span><a href="/Crm/Contract?customerId=@item.CustomerId">生效合同 @contracts.Length 份 · ¥@commercial.ActiveContractAmount.ToString("N2") · 已承接 ¥@commercial.ContractedOrderAmount.ToString("N2") · 待承接 ¥@commercial.UnorderedContractAmount.ToString("N2")</a> }@if (commercial.SalesOrderCount > 0) { <span> · </span><a href="@SalesOrderHref(item, commercial)">销售订单 @commercial.SalesOrderCount 笔 · ¥@commercial.SalesOrderAmount.ToString("N2") · 已收 ¥@commercial.ReceivedAmount.ToString("N2") · 应收 ¥@commercial.ReceivableAmount.ToString("N2")</a> }</div><div class="customer-note">履约：已发货 @commercial.ShippedOrderCount 笔 / 待发货 @commercial.PendingShipmentOrderCount 笔 · 数量已发货 @commercial.ShippedOrderQuantity.ToString("N2") / 待发货 @commercial.PendingShipmentQuantity.ToString("N2") · 已发货金额 ¥@commercial.ShippedOrderAmount.ToString("N2") · 待发货金额 ¥@commercial.PendingShipmentAmount.ToString("N2")</div>@if (fulfillmentOrders.Length > 0) { <div class="customer-note">订单明细：@foreach (var fulfillment in fulfillmentOrders.Take(5)) { <span> · <a href="/Erp/SalesOrder?orderId=@fulfillment.Order.Id">@fulfillment.Order.OrderNo</a> @SalesOrderStatusLabel(fulfillment.Order.Status) 数量 @fulfillment.Order.Quantity.ToString("N2") · ¥@fulfillment.Order.Amount.ToString("N2") · 已收 ¥@fulfillment.ReceivedAmount.ToString("N2") · 应收 ¥@fulfillment.ReceivableAmount.ToString("N2")</span> }@if (fulfillmentOrders.Length > 5) { <span> · 其余 @(fulfillmentOrders.Length - 5) 笔进入销售订单明细</span> }</div> }@foreach (var history in ProjectService.ListStatusHistory(item.Id).Take(3)) { <div class="customer-note">状态：@StatusLabel(history.FromStatus) → @StatusLabel(history.ToStatus) · @history.ActorName · @history.Reason</div> }<AttachmentPanel BusinessType="PmpProject" BusinessId="@item.Id" Actor="admin" /><div class="customer-note"><a href="/Pmp/Wbs?projectId=@item.Id">WBS</a> · <a href="/Pmp/Issue?projectId=@item.Id">风险问题</a> · <a href="/Pmp/Evm?projectId=@item.Id">EVM</a></div></div><div class="task-card__actions"><button title="编辑项目" @onclick="() => OpenEditor(item)"><i class="fa fa-pencil"></i></button>@if (Admin.AuthButton("Pmp/Project/Status")) { <button title="变更项目状态" @onclick="() => OpenStatusEditor(item)"><i class="fa fa-forward"></i></button> }<button class="danger" title="删除项目" @onclick="() => ProjectService.Remove(item)"><i class="fa fa-trash-o"></i></button></div></article>
        }
    </section>
</div>
@code {
    protected override async Task OnInitializedAsync() => await Admin.InitAsync();

    private string Keyword = string.Empty, Code = string.Empty, Name = string.Empty, CustomerIdText = string.Empty, Manager = string.Empty;
    private string ProjectAlias = string.Empty, ProjectChineseName = string.Empty, ProjectEnglishName = string.Empty, ProductName = string.Empty, ProjectStage = string.Empty, ProductLine = string.Empty, ProjectCategory = string.Empty, ProjectSubcategory = string.Empty, ProjectSubcategoryCode = string.Empty, VersionType = string.Empty, ProjectVersion = string.Empty, DevelopmentMode = string.Empty, DepartmentName = string.Empty, DomainManagerName = string.Empty, BusinessInitiatorName = string.Empty, Overview = string.Empty, Objective = string.Empty, OtherInfo = "{}";
    private PmpProjectInitiationMode InitiationMode = PmpProjectInitiationMode.PreInitiation;
    private DateTime? ExpectedInitiationDate, ActualInitiationDate;
    private string StartText = DateTime.Today.ToString("yyyy-MM-dd"), EndText = DateTime.Today.AddDays(30).ToString("yyyy-MM-dd");
    private string? Error; private bool ShowComposer; private PmpProject? Editing; private PmpProject? StatusEditing; private PmpProjectStatus DraftStatus; private string StatusReason = string.Empty;
    [SupplyParameterFromQuery(Name = "customerId")] public Guid? CustomerFilterId { get; set; }
    [SupplyParameterFromQuery(Name = "projectId")] public Guid? ProjectFilterId { get; set; }
    private IEnumerable<PmpProject> FilteredProjects() => ProjectService.List(Keyword).Where(item => (CustomerFilterId is null || item.CustomerId == CustomerFilterId) && (ProjectFilterId is null || item.Id == ProjectFilterId));
    private void OpenComposer() { Close(); ShowComposer = true; }
    private void OpenEditor(PmpProject x) { Close(); Editing = x; Code = x.Code; Name = x.Name; CustomerIdText = x.CustomerId?.ToString() ?? string.Empty; Manager = x.ManagerName ?? string.Empty; StartText = x.PlannedStart.ToString("yyyy-MM-dd"); EndText = x.PlannedEnd.ToString("yyyy-MM-dd"); InitiationMode = x.InitiationMode; ProjectAlias = x.ProjectAlias ?? string.Empty; ProjectChineseName = x.ProjectChineseName ?? string.Empty; ProjectEnglishName = x.ProjectEnglishName ?? string.Empty; ProductName = x.ProductName ?? string.Empty; ProjectStage = x.ProjectStage ?? string.Empty; ProductLine = x.ProductLine ?? string.Empty; ProjectCategory = x.ProjectCategory ?? string.Empty; ProjectSubcategory = x.ProjectSubcategory ?? string.Empty; ProjectSubcategoryCode = x.ProjectSubcategoryCode ?? string.Empty; VersionType = x.VersionType ?? string.Empty; ProjectVersion = x.ProjectVersion ?? string.Empty; DevelopmentMode = x.DevelopmentMode ?? string.Empty; DepartmentName = x.DepartmentName ?? string.Empty; DomainManagerName = x.DomainManagerName ?? string.Empty; BusinessInitiatorName = x.BusinessInitiatorName ?? string.Empty; Overview = x.Overview ?? string.Empty; Objective = x.Objective ?? string.Empty; OtherInfo = x.OtherInfo; ExpectedInitiationDate = x.ExpectedInitiationDate?.ToDateTime(TimeOnly.MinValue); ActualInitiationDate = x.ActualInitiationDate?.ToDateTime(TimeOnly.MinValue); }
    private void Close() { ShowComposer = false; Editing = null; Error = null; Code = Name = CustomerIdText = Manager = string.Empty; ProjectAlias = ProjectChineseName = ProjectEnglishName = ProductName = ProjectStage = ProductLine = ProjectCategory = ProjectSubcategory = ProjectSubcategoryCode = VersionType = ProjectVersion = DevelopmentMode = DepartmentName = DomainManagerName = BusinessInitiatorName = Overview = Objective = string.Empty; OtherInfo = "{}"; InitiationMode = PmpProjectInitiationMode.PreInitiation; ExpectedInitiationDate = ActualInitiationDate = null; StartText = DateTime.Today.ToString("yyyy-MM-dd"); EndText = DateTime.Today.AddDays(30).ToString("yyyy-MM-dd"); }
    private void Save() { if (!DateOnly.TryParse(StartText, out var start) || !DateOnly.TryParse(EndText, out var end)) { Error = "计划日期格式不正确。"; return; } try { Guid? customer = Guid.TryParse(CustomerIdText, out var id) ? id : null; DateOnly? expected = ExpectedInitiationDate is DateTime expectedDate ? DateOnly.FromDateTime(expectedDate) : null; DateOnly? actual = ActualInitiationDate is DateTime actualDate ? DateOnly.FromDateTime(actualDate) : null; if (Editing is null) ProjectService.CreateDetailed(Code, Name, customer, Manager, start, end, InitiationMode, ProjectAlias, ProjectChineseName, ProjectEnglishName, ProductName, ProjectStage, ProductLine, ProjectCategory, ProjectSubcategory, ProjectSubcategoryCode, VersionType, ProjectVersion, expected, actual, DevelopmentMode, DepartmentName, DomainManagerName, BusinessInitiatorName, Overview, Objective, OtherInfo); else ProjectService.EditDetailed(Editing, Code, Name, customer, Manager, start, end, InitiationMode, ProjectAlias, ProjectChineseName, ProjectEnglishName, ProductName, ProjectStage, ProductLine, ProjectCategory, ProjectSubcategory, ProjectSubcategoryCode, VersionType, ProjectVersion, expected, actual, DevelopmentMode, DepartmentName, DomainManagerName, BusinessInitiatorName, Overview, Objective, OtherInfo); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private void OpenStatusEditor(PmpProject x) { Close(); StatusEditing = x; DraftStatus = x.Status; StatusReason = string.Empty; Error = null; }
    private void CloseStatusEditor() { StatusEditing = null; StatusReason = string.Empty; Error = null; }
    private void SaveStatus() { if (StatusEditing is null) return; try { if (!Admin.AuthButton("Pmp/Project/Status")) throw new UnauthorizedAccessException("没有项目状态变更权限。"); ProjectService.ChangeStatus(StatusEditing, DraftStatus, StatusReason, Admin.User?.Username ?? string.Empty); CloseStatusEditor(); } catch (Exception ex) { Error = ex.Message; } }
    private static string SalesOrderHref(PmpProject project, PmpProjectCommercialInsight commercial) => project.CustomerId is not Guid customerId ? "/Erp/SalesOrder" : commercial.HasProjectScopedOrders ? $"/Erp/SalesOrder?projectId={project.Id}&activeOnly=true" : $"/Erp/SalesOrder?customerId={customerId}&activeOnly=true";
    private static string StatusLabel(PmpProjectStatus status) => status switch { PmpProjectStatus.Draft => "草稿", PmpProjectStatus.Active => "进行中", PmpProjectStatus.OnHold => "暂停", PmpProjectStatus.Completed => "已完成", PmpProjectStatus.Cancelled => "已取消", _ => status.ToString() };
    private static string SalesOrderStatusLabel(SalesOrderStatus status) => status switch { SalesOrderStatus.Draft => "草稿", SalesOrderStatus.Submitted => "已提交", SalesOrderStatus.Shipped => "已发货", SalesOrderStatus.Cancelled => "已取消", _ => status.ToString() };
}
