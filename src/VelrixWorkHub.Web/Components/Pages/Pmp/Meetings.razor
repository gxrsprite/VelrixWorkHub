@page "/Pmp/Meeting"
@using VelrixWorkHub.Application.PmpProjects
@using VelrixWorkHub.Domain
@inject AdminBlazor.IAdminContext Admin
@inject NavigationManager Navigation
@inject PmpProjectMeetingService MeetingService
@inject PmpProjectService ProjectService
@inject PmpProjectWorkItemService WorkItemService

<PageTitle>项目会议 - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMP 项目管理 · Pmp/Meeting</p><h1>项目会议</h1><p class="task-page__intro">记录会议纪要和决定项，并把会议行动项可追溯地关联到项目工作项。</p></div><div class="task-page__summary"><strong>@MeetingItems.Count</strong><span>场会议</span></div></div>
    <section class="task-toolbar customer-toolbar"><label class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索会议" @bind="Keyword" @bind:event="oninput" placeholder="主题或主持人" /></label>@if (CanCreate) { <button class="task-primary-button" @onclick="OpenCreate"><i class="fa fa-plus"></i> 新建会议</button> }</section>
    @if (ShowComposer) { <section class="task-composer" aria-label="会议编辑"><div class="task-composer__title">@(Editing is null ? "新建会议" : "编辑会议")</div><div class="task-composer__fields"><label>所属项目<select aria-label="所属项目" @bind="ProjectIdText" disabled="@(Editing is not null)"><option value="">请选择项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select></label><label>会议类型<select aria-label="会议类型" @bind="MeetingTypeText"><option value="Internal">内部会议</option><option value="Customer">客户会议</option><option value="Steering">指导委员会</option><option value="Review">评审会议</option><option value="Other">其他</option></select></label></div><div class="task-composer__fields"><label>会议主题<input aria-label="会议主题" @bind="Title" @bind:event="oninput" /></label><label>主持人<input aria-label="主持人" @bind="Host" @bind:event="oninput" /></label></div><div class="task-composer__fields"><label>开始时间<input aria-label="开始时间" @bind="StartText" placeholder="2026-07-21 09:00" /></label><label>结束时间<input aria-label="结束时间" @bind="EndText" placeholder="2026-07-21 10:00" /></label></div><div class="task-composer__fields"><label>地点或会议方式<input aria-label="地点或会议方式" @bind="Location" @bind:event="oninput" placeholder="会议室 A / 线上会议" /></label><label>参与人<input aria-label="参与人" @bind="Participants" @bind:event="oninput" placeholder="以逗号分隔" /></label></div><label>会议纪要<textarea aria-label="会议纪要" @bind="Minutes" @bind:event="oninput" rows="3"></textarea></label><label>决定项<textarea aria-label="决定项" @bind="Decisions" @bind:event="oninput" rows="2"></textarea></label>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存会议</button></div></section> }
    @if (ActionMeeting is not null) { <section class="task-composer" aria-label="会议行动项"><div class="task-composer__title">为“@ActionMeeting.Title”创建行动项</div><div class="task-composer__fields"><label>行动项标题<input aria-label="行动项标题" @bind="ActionTitle" @bind:event="oninput" /></label><label>负责人<input aria-label="行动项负责人" @bind="ActionOwner" @bind:event="oninput" /></label></div><div class="task-composer__fields"><label>优先级<select aria-label="行动项优先级" @bind="ActionPriorityText"><option value="Low">低</option><option value="Medium">中</option><option value="High">高</option><option value="Critical">紧急</option></select></label><label>参与人<input aria-label="行动项参与人" @bind="ActionParticipants" @bind:event="oninput" /></label></div><div class="task-composer__fields"><label>计划开始<input aria-label="行动项计划开始" @bind="ActionStartText" placeholder="2026-07-21 09:00" /></label><label>计划结束<input aria-label="行动项计划结束" @bind="ActionEndText" placeholder="2026-07-21 18:00" /></label></div><label>行动说明<textarea aria-label="行动说明" @bind="ActionDescription" @bind:event="oninput" rows="2"></textarea></label>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="CloseAction">取消</button><button class="task-primary-button" @onclick="SaveAction">创建行动项</button></div></section> }
    <section class="task-list" aria-live="polite">@foreach (var item in MeetingItems) { var project = ProjectService.List().FirstOrDefault(x => x.Id == item.ProjectId); var actions = MeetingService.ListActionItems(item.Id); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-users"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--open">@TypeLabel(item.MeetingType)</span><span>@(project?.Code ?? "未知项目")</span></div><h2>@item.Title</h2><p>@item.StartsAt.ToString("yyyy-MM-dd HH:mm") 至 @item.EndsAt.ToString("HH:mm") · @(item.LocationOrMode ?? "未设置地点/方式") · 主持 @(item.HostName ?? "未指定")</p><div class="customer-note">参与人：@(item.ParticipantNames ?? "未指定")</div>@if (!string.IsNullOrWhiteSpace(item.Minutes)) { <div class="customer-note">纪要：@item.Minutes</div> }@if (!string.IsNullOrWhiteSpace(item.Decisions)) { <div class="customer-note">决定项：@item.Decisions</div> }<div class="customer-note">行动项：@(actions.Count == 0 ? "暂无" : string.Join("；", actions.Select(x => x.Title + "（" + WorkItemStatusLabel(x.Status) + "）")))</div></div><div class="task-card__actions">@if (CanAction) { <button title="创建行动项" @onclick="() => OpenAction(item)"><i class="fa fa-check-square-o"></i></button> }@if (CanEdit) { <button title="编辑会议" @onclick="() => OpenEdit(item)"><i class="fa fa-pencil"></i></button> }@if (CanEdit && actions.Count == 0) { <button class="danger" title="删除会议" @onclick="() => Remove(item)"><i class="fa fa-trash-o"></i></button> }</div></article> }</section>
</div>

@code {
    private string Keyword = "", ProjectIdText = "", MeetingTypeText = "Internal", Title = "", Host = "", StartText = "", EndText = "", Location = "", Participants = "", Minutes = "", Decisions = "", OtherInfo = "{}";
    private string ActionTitle = "", ActionOwner = "", ActionParticipants = "", ActionPriorityText = "Medium", ActionStartText = "", ActionEndText = "", ActionDescription = "";
    private string? Error; private bool ShowComposer; private PmpProjectMeeting? Editing; private PmpProjectMeeting? ActionMeeting;
    private bool CanCreate => Admin.AuthButton("Pmp/Meeting/Create"); private bool CanEdit => Admin.AuthButton("Pmp/Meeting/Edit"); private bool CanAction => Admin.AuthButton("Pmp/Meeting/ActionItem");
    private IReadOnlyList<PmpProjectMeeting> MeetingItems => MeetingService.List(keyword: Keyword);
    protected override async Task OnInitializedAsync() { await Admin.InitAsync(); if (!Admin.AuthPath("Pmp/Meeting")) Navigation.NavigateTo("/", true); }
    private void OpenCreate() { Close(); ShowComposer = true; }
    private void OpenEdit(PmpProjectMeeting item) { Close(); Editing = item; ShowComposer = true; ProjectIdText = item.ProjectId.ToString(); MeetingTypeText = item.MeetingType.ToString(); Title = item.Title; Host = item.HostName ?? ""; StartText = item.StartsAt.ToString("yyyy-MM-ddTHH:mm"); EndText = item.EndsAt.ToString("yyyy-MM-ddTHH:mm"); Location = item.LocationOrMode ?? ""; Participants = item.ParticipantNames ?? ""; Minutes = item.Minutes ?? ""; Decisions = item.Decisions ?? ""; OtherInfo = item.OtherInfo; }
    private void Close() { ShowComposer = false; Editing = null; Error = null; ProjectIdText = Title = Host = StartText = EndText = Location = Participants = Minutes = Decisions = ""; MeetingTypeText = "Internal"; OtherInfo = "{}"; }
    private void Save() { if (!Guid.TryParse(ProjectIdText, out var projectId) || !DateTime.TryParse(StartText, out var startsAt) || !DateTime.TryParse(EndText, out var endsAt)) { Error = "请选择项目并检查会议时间。"; return; } try { var type = Enum.Parse<PmpProjectMeetingType>(MeetingTypeText); if (Editing is null) MeetingService.Create(projectId, Title, type, startsAt, endsAt, Location, Host, Participants, Minutes, Decisions, OtherInfo); else MeetingService.Edit(Editing, Title, type, startsAt, endsAt, Location, Host, Participants, Minutes, Decisions, OtherInfo); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private void OpenAction(PmpProjectMeeting item) { CloseAction(); Error = null; ActionMeeting = item; ActionStartText = item.StartsAt.ToString("yyyy-MM-ddTHH:mm"); ActionEndText = item.EndsAt.ToString("yyyy-MM-ddTHH:mm"); }
    private void CloseAction() { ActionMeeting = null; Error = null; ActionTitle = ActionOwner = ActionParticipants = ActionStartText = ActionEndText = ActionDescription = ""; ActionPriorityText = "Medium"; }
    private void SaveAction() { if (ActionMeeting is null || !DateTime.TryParse(ActionStartText, out var start) || !DateTime.TryParse(ActionEndText, out var end)) { Error = "请检查行动项计划时间。"; return; } try { MeetingService.CreateActionItem(ActionMeeting.Id, null, ActionTitle, ActionDescription, ActionOwner, ActionParticipants, Enum.Parse<PmpProjectWorkItemPriority>(ActionPriorityText), start, end, "{}"); CloseAction(); } catch (Exception ex) { Error = ex.Message; } }
    private void Remove(PmpProjectMeeting item) { try { MeetingService.Remove(item); } catch (Exception ex) { Error = ex.Message; } }
    private static string TypeLabel(PmpProjectMeetingType value) => value switch { PmpProjectMeetingType.Internal => "内部会议", PmpProjectMeetingType.Customer => "客户会议", PmpProjectMeetingType.Steering => "指导委员会", PmpProjectMeetingType.Review => "评审会议", _ => "其他会议" };
    private static string WorkItemStatusLabel(PmpProjectWorkItemStatus value) => value switch { PmpProjectWorkItemStatus.Draft => "草稿", PmpProjectWorkItemStatus.Open => "待处理", PmpProjectWorkItemStatus.InProgress => "进行中", PmpProjectWorkItemStatus.Completed => "已完成", _ => "已取消" };
}
