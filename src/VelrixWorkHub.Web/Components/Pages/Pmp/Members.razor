@page "/Pmp/Member"
@inject VelrixWorkHub.Application.PmpProjects.PmpProjectMemberService MemberService
@inject VelrixWorkHub.Application.PmpProjects.PmpProjectService ProjectService
@inject VelrixWorkHub.Application.Employees.EmployeeDirectoryService EmployeeDirectoryService
@using VelrixWorkHub.Application.Employees
@using VelrixWorkHub.Domain

<PageTitle>项目成员与角色 - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMP 项目管理 · Pmp/Member</p><h1>项目成员与角色</h1><p class="task-page__intro">维护项目成员、职责和项目主责人，为后续权限范围和协作分工提供基础。</p></div></div>
    <section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索项目成员" @bind="Keyword" @bind:event="oninput" placeholder="搜索成员或角色" /></div><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 添加成员</button></section>
    @if (ShowComposer || Editing is not null)
    {
        <section class="task-composer" aria-label="项目成员编辑"><div class="task-composer__title">@(Editing is null ? "添加项目成员" : "编辑项目成员")</div>
            <div class="task-composer__fields"><label>所属项目<select aria-label="所属项目" @bind="ProjectIdText" disabled="@(Editing is not null)"><option value="">请选择项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select></label><label>项目成员<select aria-label="项目成员" @bind="UserIdText"><option value="">请选择启用人员</option>@foreach (var person in EnabledPeople) { <option value="@person.UserId">@person.DisplayName · @person.Username</option> }</select></label></div>
            <div class="task-composer__fields"><label>角色<input aria-label="成员角色" @bind="RoleName" @bind:event="oninput" placeholder="项目经理、业务负责人" /></label><label>部门<input aria-label="成员部门" value="@(SelectedPerson?.OrganizationName ?? Editing?.DepartmentName ?? "未设置部门")" readonly /></label></div><div class="task-composer__fields"><label><input aria-label="项目主责人" type="checkbox" @bind="IsPrimary" /> 设为项目主责人</label></div>
            @if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存成员</button></div>
        </section>
    }
    <section class="task-list" aria-live="polite">@foreach (var item in MemberService.List(keyword: Keyword)) { var project = ProjectService.List().FirstOrDefault(x => x.Id == item.ProjectId); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-user"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@(item.IsPrimary ? "active" : "planned")">@(item.IsPrimary ? "项目主责" : "项目成员")</span><span>@(project?.Code ?? "未知项目")</span><span>@(item.DepartmentName ?? "未设置部门")</span></div><h2>@item.MemberName</h2><p>@(project?.Name ?? "项目已不存在") · @item.RoleName</p></div><div class="task-card__actions"><button title="设为主责" @onclick="() => MemberService.SetPrimary(item, !item.IsPrimary)"><i class="fa fa-star"></i></button><button title="编辑" @onclick="() => OpenEditor(item)"><i class="fa fa-pencil"></i></button><button class="danger" title="删除" @onclick="() => MemberService.Remove(item)"><i class="fa fa-trash-o"></i></button></div></article> }</section>
</div>
@code {
    private string Keyword = string.Empty, ProjectIdText = string.Empty, UserIdText = string.Empty, RoleName = string.Empty; private bool IsPrimary; private string? Error; private bool ShowComposer; private PmpProjectMember? Editing;
    private IReadOnlyList<EmployeeDirectoryEntry> EnabledPeople => EmployeeDirectoryService.List(status: EmployeeDirectoryStatus.Enabled);
    private EmployeeDirectoryEntry? SelectedPerson => Guid.TryParse(UserIdText, out var userId) ? EnabledPeople.FirstOrDefault(x => x.UserId == userId) : null;
    private void OpenComposer() { Close(); ShowComposer = true; }
    private void OpenEditor(PmpProjectMember x) { Close(); Editing = x; ProjectIdText = x.ProjectId.ToString(); UserIdText = x.UserId?.ToString() ?? string.Empty; RoleName = x.RoleName; IsPrimary = x.IsPrimary; }
    private void Close() { ShowComposer = false; Editing = null; Error = null; ProjectIdText = UserIdText = RoleName = string.Empty; IsPrimary = false; }
    private void Save() { if (!Guid.TryParse(ProjectIdText, out var projectId)) { Error = "请选择所属项目。"; return; } if (!Guid.TryParse(UserIdText, out var userId)) { Error = "请选择启用成员。"; return; } try { if (Editing is null) MemberService.CreateForPerson(projectId, userId, RoleName, IsPrimary); else MemberService.EditForPerson(Editing, userId, RoleName); if (Editing is not null && IsPrimary) MemberService.SetPrimary(Editing, true); Close(); } catch (Exception ex) { Error = ex.Message; } }
}
