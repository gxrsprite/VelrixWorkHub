@page "/Pmp/WorkItem"
@using VelrixWorkHub.Application.PmpProjects
@using VelrixWorkHub.Application.Employees
@using VelrixWorkHub.Domain
@inject AdminBlazor.IAdminContext Admin
@inject NavigationManager Navigation
@inject PmpProjectWorkItemService WorkItemService
@inject PmpProjectService ProjectService
@inject EmployeeDirectoryService DirectoryService

<PageTitle>项目工作项 - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMP 项目管理 · Pmp/WorkItem</p><h1>项目工作项</h1><p class="task-page__intro">独立跟踪项目行动项，不替代 WBS 交付任务或 OA 个人任务。</p></div><div class="task-page__summary"><strong>@Items.Count</strong><span>项工作</span></div></div>
    <section class="task-toolbar customer-toolbar"><label class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索工作项" @bind="Keyword" @bind:event="oninput" placeholder="标题或负责人" /></label>@if (CanCreate) { <button class="task-primary-button" @onclick="OpenCreate"><i class="fa fa-plus"></i> 新建工作项</button> }</section>
    @if (ShowComposer) { <section class="task-composer" aria-label="工作项编辑"><div class="task-composer__title">@(Editing is null ? "新建工作项" : "编辑工作项")</div><div class="task-composer__fields"><label>所属项目<select @bind="ProjectIdText"><option value="">请选择项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select></label><label>父工作项<select @bind="ParentIdText"><option value="">无</option>@foreach (var item in Items.Where(x => Editing is null || x.Id != Editing.Id)) { <option value="@item.Id">@item.Title</option> }</select></label></div><div class="task-composer__fields"><label>标题<input @bind="Title" @bind:event="oninput" /></label><label>负责人<select aria-label="负责人" @bind="OwnerIdText"><option value="">未指定负责人</option>@foreach (var person in People) { <option value="@person.UserId">@person.DisplayName (@person.Username)</option> }</select></label></div><div class="task-composer__fields"><label>参与人<select aria-label="参与人" multiple @bind="ParticipantIdTexts">@foreach (var person in People) { <option value="@person.UserId">@person.DisplayName (@person.Username)</option> }</select></label><label>可见部门<select aria-label="可见部门" multiple @bind="VisibilityOrganizationIdTexts">@foreach (var organization in Organizations) { <option value="@organization.Id">@organization.Name</option> }</select></label></div><div class="task-composer__fields"><label>可见角色<select aria-label="可见角色" multiple @bind="VisibilityRoleIdTexts">@foreach (var role in Roles) { <option value="@role.Id">@role.Name</option> }</select></label><label>优先级<select @bind="PriorityText"><option value="Low">低</option><option value="Medium">中</option><option value="High">高</option><option value="Critical">紧急</option></select></label></div><div class="task-composer__fields"><label>提醒时间<input aria-label="提醒时间" @bind="ReminderTimeText" placeholder="2026-07-21 09:00" /></label><label>计划开始<input @bind="PlannedStartText" placeholder="2026-07-21 09:00" /></label></div><div class="task-composer__fields"><label>计划结束<input @bind="PlannedEndText" placeholder="2026-07-21 18:00" /></label></div><label>说明<textarea @bind="Description" rows="2"></textarea></label>@if (Error is not null) { <div class="task-error">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存</button></div></section> }
    @if (Commenting is not null) { <section class="task-composer" aria-label="工作项批注"><div class="task-composer__title">为“@Commenting.Title”添加批注</div><label>批注内容<textarea aria-label="批注内容" @bind="CommentText" @bind:event="oninput" rows="2"></textarea></label>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="CloseComment">取消</button><button class="task-primary-button" @onclick="SaveComment">添加批注</button></div></section> }
    <section class="task-list">@foreach (var item in Items) { var activities = WorkItemService.ListActivities(item.Id); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-check-square-o"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Status.ToString().ToLowerInvariant()">@StatusLabel(item.Status)</span><span>@PriorityLabel(item.Priority)</span></div><h2>@item.Title</h2><p>@(ProjectService.List().FirstOrDefault(x => x.Id == item.ProjectId)?.Code ?? "未知项目") · @(item.OwnerName ?? "未指定负责人") · 参与人 @(item.ParticipantNames ?? "未指定")</p><div class="customer-note">计划 @(item.PlannedStartAt?.ToString("yyyy-MM-dd HH:mm") ?? "未设置") 至 @(item.PlannedEndAt?.ToString("yyyy-MM-dd HH:mm") ?? "未设置") · 实际 @(item.ActualStartAt?.ToString("yyyy-MM-dd HH:mm") ?? "未开始")</div>@if (IsOverdue(item)) { <div class="task-error">已逾期：计划结束时间已过，工作项仍未结束。</div> }@if (item.VisibilityOrganizationIds.Count > 0) { <div class="customer-note">可见部门：@VisibleOrganizationNames(item)</div> }@if (item.ReminderAt is DateTime reminderAt) { <div class="customer-note">提醒：@reminderAt.ToString("yyyy-MM-dd HH:mm")</div> }@if (!string.IsNullOrWhiteSpace(item.Feedback)) { <div class="customer-note">反馈：@item.Feedback</div> }@if (!string.IsNullOrWhiteSpace(item.CompletionRejectionReason)) { <div class="customer-note">验收驳回：@item.CompletionRejectionReason</div> }<div class="customer-note">活动：@(activities.Count == 0 ? "历史记录从本次启用后开始生成" : string.Join("；", activities.Take(3).Select(ActivityLabel)))</div><AttachmentPanel BusinessType="@nameof(PmpProjectWorkItem)" BusinessId="@item.Id" Actor="@(Admin.User?.Username ?? "system")" /></div><div class="task-card__actions">@if (CanEdit && item.Status is not (PmpProjectWorkItemStatus.PendingApproval or PmpProjectWorkItemStatus.Completed or PmpProjectWorkItemStatus.Cancelled)) { <button title="编辑" @onclick="() => OpenEdit(item)"><i class="fa fa-pencil"></i></button> }@if (CanStatus && NextStatus(item) is PmpProjectWorkItemStatus next) { <button title="推进状态" @onclick="() => Advance(item, next)"><i class="fa fa-forward"></i></button> }@if (CanSubmit && item.Status == PmpProjectWorkItemStatus.InProgress && item.OwnerUserId == CurrentUserId) { <button title="提交验收审批" @onclick="() => SubmitCompletion(item)"><i class="fa fa-paper-plane-o"></i></button> }@if (CanWithdraw && item.Status == PmpProjectWorkItemStatus.PendingApproval && item.OwnerUserId == CurrentUserId) { <button class="danger" title="撤回验收审批" @onclick="() => WithdrawCompletion(item)"><i class="fa fa-undo"></i></button> }@if (CanComment) { <button title="添加批注" @onclick="() => OpenComment(item)"><i class="fa fa-comment-o"></i></button> }@if (item.Status == PmpProjectWorkItemStatus.Draft && CanEdit) { <button class="danger" title="删除" @onclick="() => Remove(item)"><i class="fa fa-trash-o"></i></button> }</div></article> }</section>
</div>

@code {
    private string Keyword = "", ProjectIdText = "", ParentIdText = "", Title = "", OwnerIdText = "", PriorityText = "Medium", PlannedStartText = "", PlannedEndText = "", ReminderTimeText = "", Description = "", OtherInfo = "{}", CommentText = ""; private string[] ParticipantIdTexts = [], VisibilityOrganizationIdTexts = [], VisibilityRoleIdTexts = []; private string? Error; private bool ShowComposer; private PmpProjectWorkItem? Editing; private PmpProjectWorkItem? Commenting;
    private bool CanCreate => Admin.AuthButton("Pmp/WorkItem/Create"); private bool CanEdit => Admin.AuthButton("Pmp/WorkItem/Edit"); private bool CanStatus => Admin.AuthButton("Pmp/WorkItem/Status"); private bool CanComment => Admin.AuthButton("Pmp/WorkItem/Comment"); private bool CanSubmit => Admin.AuthButton("Pmp/WorkItem/Submit"); private bool CanWithdraw => Admin.AuthButton("Pmp/WorkItem/Withdraw"); private Guid CurrentUserId => Admin.User?.Id ?? Guid.Empty;
    private IReadOnlyList<PmpProjectWorkItem> Items => WorkItemService.ListVisible(CurrentUserId, Admin.Roles.Any(x => x.IsAdministrator), keyword: Keyword);
    private IReadOnlyList<EmployeeDirectoryEntry> People => DirectoryService.List();
    private IReadOnlyList<EmployeeDirectoryOrganization> Organizations => DirectoryService.ListOrganizations();
    private IReadOnlyList<EmployeeDirectoryRole> Roles => DirectoryService.ListRoles();
    protected override async Task OnInitializedAsync() { await Admin.InitAsync(); if (!Admin.AuthPath("Pmp/WorkItem")) Navigation.NavigateTo("/", true); }
    private void OpenCreate() { Close(); ShowComposer = true; }
    private void OpenEdit(PmpProjectWorkItem item) { Close(); Editing = item; ShowComposer = true; ProjectIdText = item.ProjectId.ToString(); ParentIdText = item.ParentId?.ToString() ?? ""; Title = item.Title; OwnerIdText = item.OwnerUserId?.ToString() ?? FindPersonId(item.OwnerName) ?? ""; ParticipantIdTexts = item.ParticipantUserIds.Select(x => x.ToString()).ToArray(); VisibilityOrganizationIdTexts = item.VisibilityOrganizationIds.Select(x => x.ToString()).ToArray(); VisibilityRoleIdTexts = item.VisibilityRoleIds.Select(x => x.ToString()).ToArray(); PriorityText = item.Priority.ToString(); PlannedStartText = item.PlannedStartAt?.ToString("yyyy-MM-dd HH:mm") ?? ""; PlannedEndText = item.PlannedEndAt?.ToString("yyyy-MM-dd HH:mm") ?? ""; ReminderTimeText = item.ReminderAt?.ToString("yyyy-MM-dd HH:mm") ?? ""; Description = item.Description ?? ""; OtherInfo = item.OtherInfo; }
    private void Close() { ShowComposer = false; Editing = null; Error = null; ProjectIdText = ParentIdText = Title = OwnerIdText = PlannedStartText = PlannedEndText = ReminderTimeText = Description = ""; ParticipantIdTexts = VisibilityOrganizationIdTexts = VisibilityRoleIdTexts = []; PriorityText = "Medium"; OtherInfo = "{}"; }
    private void Save() { if (!Guid.TryParse(ProjectIdText, out var projectId) || (!string.IsNullOrWhiteSpace(ParentIdText) && !Guid.TryParse(ParentIdText, out _)) || (!string.IsNullOrWhiteSpace(PlannedStartText) && !DateTime.TryParse(PlannedStartText, out _)) || (!string.IsNullOrWhiteSpace(PlannedEndText) && !DateTime.TryParse(PlannedEndText, out _)) || (!string.IsNullOrWhiteSpace(ReminderTimeText) && !DateTime.TryParse(ReminderTimeText, out _)) || ParticipantIdTexts.Any(x => !Guid.TryParse(x, out _)) || VisibilityOrganizationIdTexts.Any(x => !Guid.TryParse(x, out _)) || VisibilityRoleIdTexts.Any(x => !Guid.TryParse(x, out _))) { Error = "请检查项目、父项、人员、部门、角色和计划/提醒时间。"; return; } try { Guid? parent = Guid.TryParse(ParentIdText, out var parentId) ? parentId : null; Guid? owner = Guid.TryParse(OwnerIdText, out var ownerId) ? ownerId : null; var participants = ParticipantIdTexts.Select(Guid.Parse).ToArray(); var visibleOrganizations = VisibilityOrganizationIdTexts.Select(Guid.Parse).ToArray(); var visibleRoles = VisibilityRoleIdTexts.Select(Guid.Parse).ToArray(); DateTime? start = DateTime.TryParse(PlannedStartText, out var startAt) ? startAt : null; DateTime? end = DateTime.TryParse(PlannedEndText, out var endAt) ? endAt : null; DateTime? reminder = DateTime.TryParse(ReminderTimeText, out var reminderAt) ? reminderAt : null; var priority = Enum.Parse<PmpProjectWorkItemPriority>(PriorityText); if (Editing is null) WorkItemService.CreateForPeople(projectId, parent, null, null, Title, Description, owner, participants, priority, start, end, OtherInfo, reminder, visibleOrganizations, visibleRoles); else WorkItemService.EditForPeople(Editing, parent, null, null, Title, Description, owner, participants, priority, start, end, OtherInfo, reminder, visibleOrganizations, visibleRoles); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private void Advance(PmpProjectWorkItem item, PmpProjectWorkItemStatus status) { try { WorkItemService.SetStatus(item, status, null, Admin.User?.Username); } catch (Exception ex) { Error = ex.Message; } }
    private void SubmitCompletion(PmpProjectWorkItem item) { try { WorkItemService.SubmitCompletionAndStartWorkflow(item, CurrentUserId, Admin.User?.Username ?? "system", "已提交验收。"); } catch (Exception ex) { Error = ex.Message; } }
    private void WithdrawCompletion(PmpProjectWorkItem item) { try { WorkItemService.WithdrawCompletionApproval(item, CurrentUserId, Admin.User?.Username ?? "system"); } catch (Exception ex) { Error = ex.Message; } }
    private void OpenComment(PmpProjectWorkItem item) { Error = null; Commenting = item; CommentText = ""; }
    private void CloseComment() { Commenting = null; CommentText = ""; Error = null; }
    private void SaveComment() { if (Commenting is null) return; try { WorkItemService.AddComment(Commenting, CommentText, Admin.User?.Username ?? "system"); CloseComment(); } catch (Exception ex) { Error = ex.Message; } }
    private void Remove(PmpProjectWorkItem item) { try { WorkItemService.Remove(item); } catch (Exception ex) { Error = ex.Message; } }
    private static PmpProjectWorkItemStatus? NextStatus(PmpProjectWorkItem item) => item.Status switch { PmpProjectWorkItemStatus.Draft => PmpProjectWorkItemStatus.Open, PmpProjectWorkItemStatus.Open => PmpProjectWorkItemStatus.InProgress, _ => null };
    private static string StatusLabel(PmpProjectWorkItemStatus value) => value switch { PmpProjectWorkItemStatus.Draft => "草稿", PmpProjectWorkItemStatus.Open => "待处理", PmpProjectWorkItemStatus.InProgress => "进行中", PmpProjectWorkItemStatus.PendingApproval => "验收审批中", PmpProjectWorkItemStatus.Completed => "已完成", _ => "已取消" };
    private static bool IsOverdue(PmpProjectWorkItem item) => item.Status is not (PmpProjectWorkItemStatus.Completed or PmpProjectWorkItemStatus.Cancelled) && item.PlannedEndAt < DateTime.Now;
    private static string PriorityLabel(PmpProjectWorkItemPriority value) => value switch { PmpProjectWorkItemPriority.Low => "低", PmpProjectWorkItemPriority.Medium => "中", PmpProjectWorkItemPriority.High => "高", _ => "紧急" };
    private string? FindPersonId(string? displayName) => string.IsNullOrWhiteSpace(displayName) ? null : People.FirstOrDefault(x => x.DisplayName.Equals(displayName.Trim(), StringComparison.OrdinalIgnoreCase))?.UserId.ToString();
    private string VisibleOrganizationNames(PmpProjectWorkItem item) { var names = Organizations.Where(x => item.VisibilityOrganizationIds.Contains(x.Id)).Select(x => x.Name).ToArray(); return names.Length == 0 ? "已选部门已不存在" : string.Join("、", names); }
    private static string ActivityLabel(PmpProjectWorkItemActivity value) => value.Type switch { PmpProjectWorkItemActivityType.Commented => $"{value.ActorName} 批注：{value.Content}", PmpProjectWorkItemActivityType.StatusChanged => $"{value.ActorName} 将状态变为 {StatusLabel(value.CurrentStatus ?? PmpProjectWorkItemStatus.Draft)}", _ => $"{value.ActorName} 创建工作项" };
}
