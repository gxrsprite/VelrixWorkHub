@page "/Lms/MachineFeature"
@inject VelrixWorkHub.Application.Lms.LmsCustomerMachineService MachineService
@inject VelrixWorkHub.Application.Lms.LmsFeatureService FeatureService
@inject VelrixWorkHub.Application.Lms.LmsFeatureVersionService FeatureVersionService
@inject VelrixWorkHub.Application.Lms.LmsMachineFeatureService MachineFeatureService
@using VelrixWorkHub.Domain

<PageTitle>机台特性 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">LMS · Machine Feature</p><h1>机台特性</h1><p class="task-page__intro">机台特性只能在同客户的授权基线内细化，不能越级扩权。</p></div></div>
<section class="task-toolbar customer-toolbar"><button class="task-primary-button" @onclick="OpenCreate"><i class="fa fa-plus"></i> 新建机台特性</button></section>
@if (Show) { <section class="task-composer"><div class="task-composer__fields"><label>客户机台<select @bind="MachineId"><option value="@Guid.Empty">请选择机台</option>@foreach(var machine in MachineService.List(includeDisabled:false)){<option value="@machine.Id">@machine.MachineCode · @machine.ProductName</option>}</select></label><label>特性版本<select @bind="FeatureVersionId"><option value="@Guid.Empty">请选择特性版本</option>@foreach(var version in MachineVersions){<option value="@version.Id">@VersionLabel(version)</option>}</select></label><label>到期时间（可选）<input type="text" @bind="ExpiresAtText" placeholder="yyyy-MM-dd" /></label></div><label>备注<textarea @bind="Notes"></textarea></label><label>OtherInfo JSON 对象<textarea @bind="OtherInfo"></textarea></label>@if(Error is not null){<div class="task-error">@Error</div>}<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存</button></div></section>}
<section class="task-list">@foreach(var item in MachineFeatureService.List()){var machine=MachineService.List().FirstOrDefault(x=>x.Id==item.CustomerMachineId);var version=FeatureVersionService.List().FirstOrDefault(x=>x.Id==item.FeatureVersionId);<article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status">@(item.Status==LmsMachineFeatureStatus.Active?"启用":"停用")</span><span>@(machine?.MachineCode??"机台已不可用")</span></div><h2>@(version is null?"特性版本已不可用":VersionLabel(version))</h2><p>到期：@(item.ExpiresAt?.ToString("yyyy-MM-dd")??"长期有效")</p></div><div class="task-card__actions"><button title="切换状态" @onclick="()=>MachineFeatureService.SetStatus(item,item.Status==LmsMachineFeatureStatus.Active?LmsMachineFeatureStatus.Disabled:LmsMachineFeatureStatus.Active)"><i class="fa fa-toggle-on"></i></button></div></article>}</section></div>
@code { private bool Show;private Guid MachineId,FeatureVersionId;private string ExpiresAtText="",Notes="",OtherInfo="{}";private string? Error;private IReadOnlyList<LmsFeatureVersion> MachineVersions=>FeatureVersionService.List(includeDisabled:false).Where(x=>x.Scope==LmsFeatureScope.Machine).ToArray();private string VersionLabel(LmsFeatureVersion version){var feature=FeatureService.List().FirstOrDefault(x=>x.Id==version.FeatureId);return $"{feature?.Code??"未知特性"} · v{version.Version} · {version.Level}";}private void OpenCreate(){Close();Show=true;}private void Close(){Show=false;MachineId=FeatureVersionId=Guid.Empty;ExpiresAtText=Notes="";OtherInfo="{}";Error=null;}private void Save(){try{MachineFeatureService.Create(MachineId,FeatureVersionId,string.IsNullOrWhiteSpace(ExpiresAtText)?null:DateTime.Parse(ExpiresAtText),Notes,OtherInfo);Close();}catch(Exception exception){Error=exception.Message;}} }
