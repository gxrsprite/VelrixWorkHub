@page "/Lms/Product"
@inject VelrixWorkHub.Application.Lms.LmsLicenseProductService ProductService
@using VelrixWorkHub.Domain
<PageTitle>许可证产品 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">LMS · Product</p><h1>许可证产品</h1><p class="task-page__intro">维护许可证产品；停用产品不能新建许可证申请，历史记录不受影响。</p></div></div><section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索许可证产品" @bind="Keyword" @bind:event="oninput" placeholder="搜索产品编码或名称" /></div><select aria-label="筛选许可证产品状态" @bind="StatusFilter"><option value="">全部状态</option><option value="Active">启用</option><option value="Disabled">停用</option></select><button class="task-primary-button" @onclick="OpenCreate"><i class="fa fa-plus"></i> 新建产品</button></section>@if(Show){<section class="task-composer"><div class="task-composer__title">@(Editing is null ? "新建产品" : "编辑产品")</div><div class="task-composer__fields"><label>产品编码<input @bind="Code"/></label><label>产品名称<input @bind="Name"/></label></div><label>描述<textarea @bind="Description"></textarea></label>@if(Error is not null){<div class="task-error">@Error</div>}<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存</button></div></section>}<section class="task-list">@foreach(var item in Items){<article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status">@(item.Status==LmsLicenseProductStatus.Active?"启用":"停用")</span><span>@item.Code</span></div><h2>@item.Name</h2><p>@(item.Description??"无描述")</p></div><div class="task-card__actions"><button title="编辑产品" @onclick="()=>OpenEdit(item)"><i class="fa fa-pencil"></i></button><button title="切换状态" @onclick="()=>ProductService.SetStatus(item,item.Status==LmsLicenseProductStatus.Active?LmsLicenseProductStatus.Disabled:LmsLicenseProductStatus.Active)"><i class="fa fa-toggle-on"></i></button></div></article>}</section></div>
@code{private bool Show;private LmsLicenseProduct? Editing;private string Code="",Name="",Description="",OtherInfo="{}",Keyword="",StatusFilter="";private string? Error;private IEnumerable<LmsLicenseProduct> Items=>ProductService.List().Where(x=>(string.IsNullOrWhiteSpace(Keyword)||x.Code.Contains(Keyword,StringComparison.OrdinalIgnoreCase)||x.Name.Contains(Keyword,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(StatusFilter)||x.Status.ToString()==StatusFilter));private void OpenCreate(){Close();Show=true;}private void OpenEdit(LmsLicenseProduct item){Show=true;Editing=item;Code=item.Code;Name=item.Name;Description=item.Description??"";OtherInfo=item.OtherInfo;Error=null;}private void Close(){Show=false;Editing=null;Error=null;Code=Name=Description="";OtherInfo="{}";}private void Save(){try{if(Editing is null)ProductService.Create(Code,Name,Description,OtherInfo);else ProductService.Edit(Editing,Code,Name,Description,OtherInfo);Close();}catch(Exception e){Error=e.Message;}}}
