@page "/Lms/Feature"
@inject VelrixWorkHub.Application.Lms.LmsFeatureService FeatureService
@using VelrixWorkHub.Domain
<PageTitle>许可证特性 - Velrix Work Hub</PageTitle>
<div class="customer-page"><div class="task-page__header"><div><p class="eyebrow">LMS · Feature</p><h1>许可证特性</h1><p class="task-page__intro">维护可授权特性；版本、等级及客户/机台适用范围将在后续切片关联。</p></div></div><section class="task-toolbar customer-toolbar"><button class="task-primary-button" @onclick="()=>Show=true"><i class="fa fa-plus"></i> 新建特性</button></section>@if(Show){<section class="task-composer"><div class="task-composer__fields"><label>特性编码<input @bind="Code"/></label><label>特性名称<input @bind="Name"/></label></div><label>描述<textarea @bind="Description"></textarea></label>@if(Error is not null){<div class="task-error">@Error</div>}<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存</button></div></section>}<section class="task-list">@foreach(var item in FeatureService.List()){<article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span class="task-status">@(item.Status==LmsFeatureStatus.Active?"启用":"停用")</span><span>@item.Code</span></div><h2>@item.Name</h2><p>@(item.Description??"无描述")</p></div><div class="task-card__actions"><button title="切换状态" @onclick="()=>FeatureService.SetStatus(item,item.Status==LmsFeatureStatus.Active?LmsFeatureStatus.Disabled:LmsFeatureStatus.Active)"><i class="fa fa-toggle-on"></i></button></div></article>}</section></div>
@code{private bool Show;private string Code="",Name="",Description="",OtherInfo="{}";private string? Error;private void Close(){Show=false;Error=null;Code=Name=Description="";OtherInfo="{}";}private void Save(){try{FeatureService.Create(Code,Name,Description,OtherInfo);Close();}catch(Exception e){Error=e.Message;}}}
