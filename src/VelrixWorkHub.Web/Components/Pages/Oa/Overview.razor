@page "/Oa/Overview"
@inject IAdminContext Admin
@inject ILogger<Overview> Logger
@inject VelrixWorkHub.Application.Tasks.WorkTaskService TaskService
@inject VelrixWorkHub.Application.Announcements.AnnouncementService AnnouncementService
@inject VelrixWorkHub.Application.Schedules.WorkScheduleService ScheduleService
@inject VelrixWorkHub.Application.Notifications.NotificationService NotificationService
@using VelrixWorkHub.Application.Announcements
@using VelrixWorkHub.Application.Schedules
@using VelrixWorkHub.Application.Tasks
@using VelrixWorkHub.Domain

<PageTitle>OA 工作台 - Velrix Work Hub</PageTitle>

<div class="task-page">
    <div class="task-page__header">
        <div>
            <p class="eyebrow">协同办公 · Oa/Overview</p>
            <h1>OA 工作台</h1>
            <p class="task-page__intro">把个人待办、近期日程、通知和组织公告放在同一个工作入口。</p>
        </div>
        <div class="task-page__summary"><strong>@UnreadNotificationCount</strong><span>条未读通知</span></div>
    </div>

    @if (LoadError is not null)
    {
        <div class="alert alert-warning mt-3" role="alert">@LoadError</div>
    }

    <section class="module-overview-grid" aria-label="协同办公摘要">
        <a class="module-overview-stat" href="Oa/Task"><span>待处理任务</span><strong>@OpenTasks.Count</strong><small>进入我的任务</small></a>
        <a class="module-overview-stat" href="Oa/Task"><span>已逾期任务</span><strong>@OverdueTasks.Count</strong><small>优先安排处理</small></a>
        <a class="module-overview-stat" href="Oa/Schedule"><span>未来七日日程</span><strong>@UpcomingWeekSchedules.Count</strong><small>查看时间安排</small></a>
        <a class="module-overview-stat" href="Oa/Announcement"><span>已发布公告</span><strong>@PublishedAnnouncements.Count</strong><small>查看组织信息</small></a>
    </section>

    <section class="module-overview-grid module-overview-grid--details" aria-label="协同办公工作区">
        <article class="module-overview-panel">
            <div class="module-overview-panel__header"><div><p class="eyebrow">下一步</p><h2>优先任务</h2></div><a href="Oa/Task">全部任务</a></div>
            @if (!OpenTasks.Any()) { <p class="workhub-empty-line">暂时没有待处理任务。</p> }
            else { <ul class="workhub-list">@foreach (var task in OpenTasks.OrderBy(x => x.DueDate ?? DateOnly.MaxValue).Take(5)) { <li><span class="workhub-list__marker"></span><div><strong>@task.Title</strong><small>@TaskDueLabel(task)</small></div></li> }</ul> }
        </article>
        <article class="module-overview-panel">
            <div class="module-overview-panel__header"><div><p class="eyebrow">时间安排</p><h2>未来七日</h2></div><a href="Oa/Schedule">全部日程</a></div>
            @if (!UpcomingWeekSchedules.Any()) { <p class="workhub-empty-line">未来七日没有安排。</p> }
            else { <ul class="workhub-list workhub-list--schedule">@foreach (var schedule in UpcomingWeekSchedules.Take(5)) { <li><time><strong>@schedule.StartTime.ToString("dd")</strong><small>@schedule.StartTime.ToString("MM月")</small></time><div><strong>@schedule.Title</strong><small>@schedule.StartTime.ToString("HH:mm") · @(schedule.Location ?? "未设置地点")</small></div></li> }</ul> }
        </article>
        <article class="module-overview-panel">
            <div class="module-overview-panel__header"><div><p class="eyebrow">组织信息</p><h2>最新公告</h2></div><a href="Oa/Announcement">全部公告</a></div>
            @if (!PublishedAnnouncements.Any()) { <p class="workhub-empty-line">暂时没有已发布公告。</p> }
            else { <ul class="workhub-list">@foreach (var announcement in PublishedAnnouncements.Take(5)) { <li><span class="workhub-list__marker"></span><div><strong>@announcement.Title</strong><small>@announcement.PublishedTime?.ToString("MM月dd日 HH:mm")</small></div></li> }</ul> }
        </article>
    </section>
</div>

@code {
    private IReadOnlyList<WorkTask> OpenTasks { get; set; } = [];
    private IReadOnlyList<WorkTask> OverdueTasks { get; set; } = [];
    private IReadOnlyList<WorkSchedule> UpcomingWeekSchedules { get; set; } = [];
    private IReadOnlyList<Announcement> PublishedAnnouncements { get; set; } = [];
    private int UnreadNotificationCount { get; set; }
    private string? LoadError { get; set; }

    protected override void OnInitialized()
    {
        try
        {
            OpenTasks = TaskService.List(WorkTaskFilter.Open);
            OverdueTasks = TaskService.List(WorkTaskFilter.Overdue);
            UpcomingWeekSchedules = ScheduleService.List(ScheduleFilter.Upcoming)
                .Where(x => x.StartTime < DateTime.Today.AddDays(7))
                .OrderBy(x => x.StartTime)
                .ToArray();
            PublishedAnnouncements = AnnouncementService.List(AnnouncementFilter.Published)
                .OrderByDescending(x => x.PublishedTime)
                .ToArray();
            UnreadNotificationCount = string.IsNullOrWhiteSpace(Admin.User?.Username)
                ? 0
                : NotificationService.UnreadCount(Admin.User.Username);
        }
        catch (Exception exception)
        {
            LoadError = "部分协同摘要暂时不可用，请稍后重试。";
            Logger.LogError(exception, "OA 工作台摘要加载失败");
        }
    }

    private static string TaskDueLabel(WorkTask task) => task.DueDate switch
    {
        null => "暂无截止日期",
        var due when due < DateOnly.FromDateTime(DateTime.Today) => $"已逾期 {due:MM月dd日}",
        var due => $"截止 {due:MM月dd日}"
    };
}
