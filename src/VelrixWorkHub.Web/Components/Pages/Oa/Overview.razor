@page "/Oa/Overview"
@inject IAdminContext Admin
@inject ILogger<Overview> Logger
@inject VelrixWorkHub.Application.Tasks.WorkTaskService TaskService
@inject VelrixWorkHub.Application.Announcements.AnnouncementService AnnouncementService
@inject VelrixWorkHub.Application.Schedules.WorkScheduleService ScheduleService
@inject VelrixWorkHub.Application.Notifications.NotificationService NotificationService
@inject VelrixWorkHub.Web.Localization.UiLocalizationService L
@using VelrixWorkHub.Application.Announcements
@using VelrixWorkHub.Application.Schedules
@using VelrixWorkHub.Application.Tasks
@using VelrixWorkHub.Domain

<PageTitle>@L.Text("OA 工作台") - Velrix Work Hub</PageTitle>

<div class="task-page">
    <div class="task-page__header">
        <div>
            <p class="eyebrow">@L.Text("协同办公 · Oa/Overview")</p>
            <h1>@L.Text("OA 工作台")</h1>
            <p class="task-page__intro">@L.Text("把个人待办、近期日程、通知和组织公告放在同一个工作入口。")</p>
        </div>
        <div class="task-page__summary"><strong>@UnreadNotificationCount</strong><span>@L.Text("条未读通知")</span></div>
    </div>

    @if (LoadError is not null)
    {
        <div class="alert alert-warning mt-3" role="alert">@L.Text(LoadError)</div>
    }

    <section class="module-overview-grid" aria-label="@L.Text("协同办公摘要")">
        <a class="module-overview-stat" href="Oa/Task"><span>@L.Text("待处理任务")</span><strong>@OpenTasks.Count</strong><small>@L.Text("进入我的任务")</small></a>
        <a class="module-overview-stat" href="Oa/Task"><span>@L.Text("已逾期任务")</span><strong>@OverdueTasks.Count</strong><small>@L.Text("优先安排处理")</small></a>
        <a class="module-overview-stat" href="Oa/Schedule"><span>@L.Text("未来七日日程")</span><strong>@UpcomingWeekSchedules.Count</strong><small>@L.Text("查看时间安排")</small></a>
        <a class="module-overview-stat" href="Oa/Announcement"><span>@L.Text("已发布公告")</span><strong>@PublishedAnnouncements.Count</strong><small>@L.Text("查看组织信息")</small></a>
    </section>

    <section class="module-overview-grid module-overview-grid--details" aria-label="@L.Text("协同办公工作区")">
        <article class="module-overview-panel">
            <div class="module-overview-panel__header"><div><p class="eyebrow">@L.Text("下一步")</p><h2>@L.Text("优先任务")</h2></div><a href="Oa/Task">@L.Text("全部任务")</a></div>
            @if (!OpenTasks.Any()) { <p class="workhub-empty-line">@L.Text("暂时没有待处理任务。")</p> }
            else { <ul class="workhub-list">@foreach (var task in OpenTasks.OrderBy(x => x.DueDate ?? DateOnly.MaxValue).Take(5)) { <li><span class="workhub-list__marker"></span><div><strong>@task.Title</strong><small>@TaskDueLabel(task)</small></div></li> }</ul> }
        </article>
        <article class="module-overview-panel">
            <div class="module-overview-panel__header"><div><p class="eyebrow">@L.Text("时间安排")</p><h2>@L.Text("未来七日")</h2></div><a href="Oa/Schedule">@L.Text("全部日程")</a></div>
            @if (!UpcomingWeekSchedules.Any()) { <p class="workhub-empty-line">@L.Text("未来七日没有安排。")</p> }
            else { <ul class="workhub-list workhub-list--schedule">@foreach (var schedule in UpcomingWeekSchedules.Take(5)) { <li><time><strong>@schedule.StartTime.ToString("dd")</strong><small>@ScheduleMonthLabel(schedule.StartTime)</small></time><div><strong>@schedule.Title</strong><small>@schedule.StartTime.ToString("HH:mm") · @(schedule.Location ?? L.Text("未设置地点"))</small></div></li> }</ul> }
        </article>
        <article class="module-overview-panel">
            <div class="module-overview-panel__header"><div><p class="eyebrow">@L.Text("组织信息")</p><h2>@L.Text("最新公告")</h2></div><a href="Oa/Announcement">@L.Text("全部公告")</a></div>
            @if (!PublishedAnnouncements.Any()) { <p class="workhub-empty-line">@L.Text("暂时没有已发布公告。")</p> }
            else { <ul class="workhub-list">@foreach (var announcement in PublishedAnnouncements.Take(5)) { <li><span class="workhub-list__marker"></span><div><strong>@announcement.Title</strong><small>@AnnouncementDateLabel(announcement.PublishedTime)</small></div></li> }</ul> }
        </article>
    </section>
</div>

@code {
    private IReadOnlyList<WorkTask> OpenTasks { get; set; } = [];
    private IReadOnlyList<WorkTask> OverdueTasks { get; set; } = [];
    private IReadOnlyList<WorkSchedule> UpcomingWeekSchedules { get; set; } = [];
    private IReadOnlyList<Announcement> PublishedAnnouncements { get; set; } = [];
    private int UnreadNotificationCount { get; set; }
    private string? LoadError { get; set; }

    protected override void OnInitialized()
    {
        try
        {
            OpenTasks = TaskService.List(WorkTaskFilter.Open);
            OverdueTasks = TaskService.List(WorkTaskFilter.Overdue);
            UpcomingWeekSchedules = ScheduleService.List(ScheduleFilter.Upcoming)
                .Where(x => x.StartTime < DateTime.Today.AddDays(7))
                .OrderBy(x => x.StartTime)
                .ToArray();
            PublishedAnnouncements = AnnouncementService.List(AnnouncementFilter.Published)
                .OrderByDescending(x => x.PublishedTime)
                .ToArray();
            UnreadNotificationCount = string.IsNullOrWhiteSpace(Admin.User?.Username)
                ? 0
                : NotificationService.UnreadCount(Admin.User.Username);
        }
        catch (Exception exception)
        {
            LoadError = "部分协同摘要暂时不可用，请稍后重试。";
            Logger.LogError(exception, "OA 工作台摘要加载失败");
        }
    }

    private string TaskDueLabel(WorkTask task) => task.DueDate switch
    {
        null => L.Text("暂无截止日期"),
        var due when due < DateOnly.FromDateTime(DateTime.Today) => $"{L.Text("已逾期")} {DateLabel(due.Value)}",
        var due => $"{L.Text("截止")} {DateLabel(due.Value)}"
    };

    private string DateLabel(DateOnly date) => L.IsEnglish ? date.ToString("MMM dd") : date.ToString("MM月dd日");
    private string ScheduleMonthLabel(DateTime date) => L.IsEnglish ? date.ToString("MMM") : date.ToString("MM月");
    private string AnnouncementDateLabel(DateTime? date) => date is null ? string.Empty : L.IsEnglish ? date.Value.ToString("MMM dd HH:mm") : date.Value.ToString("MM月dd日 HH:mm");
}
