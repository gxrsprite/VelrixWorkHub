@page "/Pms/Overview"
@inject VelrixWorkHub.Application.PmsProjects.PmsProjectService ProjectService
@inject VelrixWorkHub.Application.PmsProjects.PmsProjectPhaseService PhaseService
@inject VelrixWorkHub.Application.PmsProjects.PmsWbsTaskService WbsService
@inject VelrixWorkHub.Application.PmsProjects.PmsProjectIssueService IssueService
@inject VelrixWorkHub.Application.PmsProjects.PmsEvmService EvmService
@inject VelrixWorkHub.Application.SalesOrders.SalesOrderService SalesOrderService
@inject VelrixWorkHub.Application.Settlements.SettlementService SettlementService
@inject VelrixWorkHub.Application.Customers.CustomerService CustomerService
@inject VelrixWorkHub.Application.Contracts.SalesContractService ContractService
@inject VelrixWorkHub.Web.Localization.UiLocalizationService L
@using VelrixWorkHub.Application.Contracts
@using VelrixWorkHub.Application.PmsProjects
@using VelrixWorkHub.Domain
<PageTitle>@L.Text("项目组合概览") - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">@L.Text("PMS 项目管理 · Pms/Overview")</p><h1>@L.Text("项目组合概览")</h1><p class="task-page__intro">@L.Text("集中查看项目进度、WBS 完成情况、风险问题、EVM 进度绩效和客户合同履约、应收余额。")</p></div></div>
    <section class="task-toolbar customer-toolbar" aria-label="@L.Text("项目组合筛选")"><div class="customer-search"><i class="fa fa-search" aria-hidden="true"></i><input aria-label="@L.Text("搜索项目组合")" @bind="Keyword" @bind:event="oninput" placeholder="@L.Text("搜索项目编号、名称或经理")" /></div><select aria-label="@L.Text("筛选项目客户")" @bind="CustomerFilterText"><option value="">@L.Text("全部客户")</option>@foreach (var customer in CustomerService.List()) { <option value="@customer.Id">@customer.Name</option> }</select><select aria-label="@L.Text("筛选项目状态")" @bind="StatusFilterText"><option value="">@L.Text("全部状态")</option><option value="Draft">@L.Text("草稿")</option><option value="Active">@L.Text("进行中")</option><option value="OnHold">@L.Text("暂停")</option><option value="Completed">@L.Text("已完成")</option><option value="Cancelled">@L.Text("已取消")</option></select></section>
    @{ var summary = Summary(); }
    <section class="task-list" aria-label="@L.Text("项目组合指标")">
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("项目总数")</span><span>PMS</span></div><h2>@summary.ProjectCount</h2></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("进行中项目")</span><span>@L.Text("项目状态")</span></div><h2>@summary.ActiveProjectCount</h2></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("阶段/里程碑")</span><span>@L.Text("交付计划")</span></div><h2>@summary.PhaseCount</h2><p>@L.Text("逾期里程碑") @summary.OverdueMilestoneCount @L.Text("项")</p></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("未关闭风险问题")</span><span>@L.Text("需要跟进")</span></div><h2>@summary.OpenIssueCount</h2><p>@L.Text("其中逾期") @summary.OverdueIssueCount @L.Text("项")</p></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("未完成 WBS")</span><span>@L.Text("交付工作量")</span></div><h2>@summary.IncompleteWbsTaskCount</h2></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("平均 SPI")</span><span>EVM</span></div><h2>@summary.AverageSchedulePerformanceIndex.ToString("N2")</h2><p>@L.Text("客户应收") ¥@summary.ReceivableAmount.ToString("N2")</p></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("有效合同金额")</span><span>@L.Text("CRM 合同")</span></div><h2>¥@summary.ActiveContractAmount.ToString("N2")</h2><p>@L.Text("仅统计生效合同")</p></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("待承接合同金额")</span><span>CRM × ERP</span></div><h2>¥@summary.UnorderedContractAmount.ToString("N2")</h2><p>@L.Text("生效合同减有效关联合同订单")</p></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("高风险项目")</span><span>@L.Text("PMS 交付健康")</span></div><h2>@summary.AtRiskProjectCount</h2><p>@L.Text("逾期节点或进度显著落后")</p></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("需关注项目")</span><span>@L.Text("PMS 交付健康")</span></div><h2>@summary.AttentionProjectCount</h2><p>@L.Text("存在待跟进执行信号")</p></div></article>
        <article class="task-card customer-card"><div class="task-card__body"><div class="task-card__meta"><span>@L.Text("待发货订单")</span><span>PMS × ERP</span></div><h2>@summary.PendingShipmentOrderCount</h2><p>@L.Text("待发货数量") @summary.PendingShipmentQuantity.ToString("N2") · ¥@summary.PendingShipmentAmount.ToString("N2")</p></div></article>
    </section>
    <section class="task-list" aria-label="@L.Text("项目交付健康")">
        @foreach (var item in VisibleProjects(summary))
        {
            <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-heartbeat"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@HealthClass(item.DeliveryHealth.Status)">@HealthLabel(item.DeliveryHealth.Status)</span><span>@item.Project.Code · @item.Project.Name</span></div><p aria-label="@L.Text("交付健康原因")">@(item.DeliveryHealth.Reasons.Count == 0 ? L.Text("暂无待跟进信号") : string.Join("、", item.DeliveryHealth.Reasons))</p></div></article>
        }
    </section>
    <section class="task-list" aria-label="@L.Text("项目组合明细")">
        @foreach (var item in VisibleProjects(summary))
        {
            var customer = item.Project.CustomerId is Guid customerId ? CustomerService.List().FirstOrDefault(x => x.Id == customerId) : null;
            <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-briefcase"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Project.Status.ToString().ToLowerInvariant()">@StatusLabel(item.Project.Status)</span><span>@item.Project.Code</span></div><h2>@item.Project.Name</h2><p>@if (customer is not null) { <a href="/Crm/CustomerLedger/@customer.Id">@customer.Name</a> } else { <span>@L.Text("未关联客户")</span> } · @(item.Project.ManagerName ?? L.Text("未指定经理")) · @item.Project.PlannedStart.ToString("yyyy-MM-dd") @L.Text("至") @item.Project.PlannedEnd.ToString("yyyy-MM-dd")</p><div class="customer-note">@L.Text("阶段") @item.PhaseCount · @L.Text("逾期里程碑") @item.OverdueMilestoneCount · WBS @item.WbsTaskCount · @L.Text("未完成") @item.IncompleteWbsTaskCount · @L.Text("未关闭问题") @item.OpenIssueCount@if (item.OverdueIssueCount > 0) { <span> · @L.Text("逾期问题") @item.OverdueIssueCount</span> } · SPI @item.SchedulePerformanceIndex.ToString("N2")</div><div class="customer-note">@L.Text("合同") ¥@item.ActiveContractAmount.ToString("N2") · @L.Text("已承接") ¥@item.ContractedOrderAmount.ToString("N2") · @L.Text("待承接") ¥@item.UnorderedContractAmount.ToString("N2") · @if (item.Project.CustomerId is Guid portfolioCustomerId) { <a href="@SalesOrderHref(item)">@L.Text("销售订单") @item.SalesOrderCount @L.Text("笔")</a><span> · @L.Text("已发货") @item.ShippedOrderCount @L.Text("笔") · </span><a href="@PendingSalesOrderHref(item)">@L.Text("待发货订单") @item.PendingShipmentOrderCount @L.Text("笔")</a><span> · @L.Text("应收") ¥@item.ReceivableAmount.ToString("N2")</span> } else { <span>@L.Text("未关联销售订单")</span> }</div><div class="customer-note">@L.Text("订单金额") ¥@item.SalesOrderAmount.ToString("N2") · @L.Text("数量已发货") @item.ShippedOrderQuantity.ToString("N2") / @L.Text("待发货") @item.PendingShipmentQuantity.ToString("N2") · @L.Text("已发货金额") ¥@item.ShippedOrderAmount.ToString("N2") · @L.Text("待发货金额") ¥@item.PendingShipmentAmount.ToString("N2") · @L.Text("履约") @item.FulfillmentRate.ToString("0.0")%</div><div class="customer-note"><a href="/Pms/Project?customerId=@item.Project.CustomerId">@L.Text("项目主数据")</a> · <a href="/Pms/Phase?projectId=@item.Project.Id">@L.Text("阶段与里程碑")</a> · <a href="/Pms/Wbs?projectId=@item.Project.Id">WBS</a> · <a href="/Pms/Issue?projectId=@item.Project.Id">@L.Text("风险问题")</a> · <a href="/Pms/Evm?projectId=@item.Project.Id">EVM</a></div></div></article>
        }
    </section>
</div>
@code {
    private string Keyword { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "customerId")] public Guid? CustomerFilterId { get; set; }
    private string CustomerFilterText { get => CustomerFilterId?.ToString() ?? string.Empty; set => CustomerFilterId = Guid.TryParse(value, out var id) ? id : null; }
    private string StatusFilterText { get; set; } = string.Empty;
    private PmsPortfolioSummary Summary() => PmsPortfolioService.Build(DateOnly.FromDateTime(DateTime.Today), ProjectService.List(), PhaseService.List(), WbsService.List(), IssueService.List(), EvmService.List(), SalesOrderService.List(), SettlementService.List(), ContractService.List());
    private IEnumerable<PmsPortfolioProject> VisibleProjects(PmsPortfolioSummary summary) => summary.Projects.Where(x => CustomerFilterId is null || x.Project.CustomerId == CustomerFilterId).Where(x => string.IsNullOrWhiteSpace(Keyword) || x.Project.Code.Contains(Keyword, StringComparison.OrdinalIgnoreCase) || x.Project.Name.Contains(Keyword, StringComparison.OrdinalIgnoreCase) || (x.Project.ManagerName?.Contains(Keyword, StringComparison.OrdinalIgnoreCase) ?? false)).Where(x => !Enum.TryParse<PmsProjectStatus>(StatusFilterText, out var status) || x.Project.Status == status);
    private static string SalesOrderHref(PmsPortfolioProject item) => item.Project.CustomerId is not Guid customerId ? "/Erp/SalesOrder" : item.HasProjectScopedOrders ? $"/Erp/SalesOrder?projectId={item.Project.Id}&activeOnly=true" : $"/Erp/SalesOrder?customerId={customerId}&activeOnly=true";
    private static string PendingSalesOrderHref(PmsPortfolioProject item) => item.Project.CustomerId is not Guid customerId ? "/Erp/SalesOrder?status=Submitted" : item.HasProjectScopedOrders ? $"/Erp/SalesOrder?projectId={item.Project.Id}&activeOnly=true&status=Submitted" : $"/Erp/SalesOrder?customerId={customerId}&activeOnly=true&status=Submitted";
    private static string HealthClass(PmsDeliveryHealthStatus status) => status switch { PmsDeliveryHealthStatus.Healthy => "healthy", PmsDeliveryHealthStatus.Attention => "attention", PmsDeliveryHealthStatus.AtRisk => "atrisk", _ => "attention" };
    private string StatusLabel(PmsProjectStatus status) => status switch { PmsProjectStatus.Draft => L.Text("草稿"), PmsProjectStatus.Active => L.Text("进行中"), PmsProjectStatus.OnHold => L.Text("暂停"), PmsProjectStatus.Completed => L.Text("已完成"), PmsProjectStatus.Cancelled => L.Text("已取消"), _ => status.ToString() };
    private string HealthLabel(PmsDeliveryHealthStatus status) => status switch { PmsDeliveryHealthStatus.Healthy => L.Text("健康"), PmsDeliveryHealthStatus.Attention => L.Text("需关注"), PmsDeliveryHealthStatus.AtRisk => L.Text("高风险"), _ => status.ToString() };
}
