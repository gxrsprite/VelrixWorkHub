@page "/Pms/Delivery"
@using VelrixWorkHub.Application.PmsProjects
@using VelrixWorkHub.Domain
@inject AdminBlazor.IAdminContext Admin
@inject NavigationManager Navigation
@inject PmsDeliveryRecordService DeliveryService
@inject PmsProjectService ProjectService
@inject PmsRequirementService RequirementService
@inject PmsWbsTaskService WbsTaskService

<PageTitle>交付追溯 - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMS 项目管理 · Pms/Delivery</p><h1>交付追溯</h1><p class="task-page__intro">把缺陷、评审结论和发布版本关联到项目、需求与 WBS，并保留状态过程。</p></div><div class="task-page__summary"><strong>@Records.Count</strong><span>条记录</span></div></div>
    <section class="task-toolbar customer-toolbar"><label class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索交付记录" @bind="Keyword" @bind:event="oninput" placeholder="编号、标题或负责人" /></label><select aria-label="交付记录类型筛选" @bind="TypeFilterText"><option value="">全部类型</option>@foreach (var type in Enum.GetValues<PmsDeliveryRecordType>()) { <option value="@type">@TypeLabel(type)</option> }</select>@if (CanCreate) { <button class="task-primary-button" @onclick="OpenCreate"><i class="fa fa-plus"></i> 新建记录</button> }</section>
    @if (ShowComposer) { <section class="task-composer" aria-label="交付记录编辑"><div class="task-composer__title">@(Editing is null ? "新建交付记录" : "编辑交付记录")</div><div class="task-composer__fields"><label>所属项目<select aria-label="交付所属项目" @bind="ProjectIdText" disabled="@(Editing is not null)"><option value="">请选择项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select></label><label>记录类型<select aria-label="交付记录类型" @bind="RecordTypeText"><option value="Defect">缺陷</option><option value="Review">评审</option><option value="Release">发布</option></select></label></div><div class="task-composer__fields"><label>记录编号<input aria-label="交付记录编号" @bind="RecordNo" @bind:event="oninput" placeholder="BUG-001 / REV-001 / REL-1.0" /></label><label>标题<input aria-label="交付记录标题" @bind="Title" @bind:event="oninput" /></label></div><div class="task-composer__fields"><label>关联需求<select aria-label="关联需求" @bind="RequirementIdText"><option value="">不关联需求</option>@foreach (var item in RequirementsForForm) { <option value="@item.Id">@item.RequirementNo · @item.Description</option> }</select></label><label>关联 WBS<select aria-label="关联 WBS" @bind="WbsTaskIdText"><option value="">不关联 WBS</option>@foreach (var item in WbsTasksForForm) { <option value="@item.Id">@item.Title</option> }</select></label></div><div class="task-composer__fields"><label>负责人<input aria-label="交付负责人" @bind="Owner" @bind:event="oninput" /></label><label>发布版本<input aria-label="发布版本" @bind="ReleaseVersion" @bind:event="oninput" placeholder="发布类型必填，例如 1.0.0" /></label></div><label>描述<textarea aria-label="交付描述" @bind="Description" @bind:event="oninput" rows="2"></textarea></label><label>评审结论<textarea aria-label="评审结论" @bind="ReviewConclusion" @bind:event="oninput" rows="2"></textarea></label><label>发布结果<textarea aria-label="发布结果" @bind="ReleaseResult" @bind:event="oninput" rows="2"></textarea></label>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存记录</button></div></section> }
    <section class="task-list" aria-live="polite">@foreach (var item in Records) { var history = DeliveryService.ListHistory(item.Id); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa @(item.Type == PmsDeliveryRecordType.Defect ? "fa-bug" : item.Type == PmsDeliveryRecordType.Review ? "fa-search" : "fa-rocket")"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--open">@TypeLabel(item.Type) · @StatusLabel(item.Status)</span><span>@(ProjectService.List().FirstOrDefault(x => x.Id == item.ProjectId)?.Code ?? "未知项目")</span></div><h2>@item.RecordNo · @item.Title</h2><p>负责人：@(item.OwnerName ?? "未指定") · 需求 @(item.RequirementId is null ? "未关联" : RequirementService.List(item.ProjectId).FirstOrDefault(x => x.Id == item.RequirementId)?.RequirementNo ?? "未知") · WBS @(item.WbsTaskId is null ? "未关联" : WbsTaskService.List(item.ProjectId).FirstOrDefault(x => x.Id == item.WbsTaskId)?.Title ?? "未知")</p>@if (!string.IsNullOrWhiteSpace(item.Description)) { <div class="customer-note">@item.Description</div> }@if (!string.IsNullOrWhiteSpace(item.ReviewConclusion)) { <div class="customer-note">评审结论：@item.ReviewConclusion</div> }@if (!string.IsNullOrWhiteSpace(item.ReleaseVersion)) { <div class="customer-note">发布版本：@item.ReleaseVersion · @(item.ReleaseResult ?? "待填写发布结果")</div> }<div class="customer-note">状态历史：@(history.Count == 0 ? "无" : string.Join("；", history.Take(3).Select(x => StatusLabel(x.Status) + " " + x.OccurredAt.ToString("MM-dd HH:mm"))))</div><AttachmentPanel BusinessType="@nameof(PmsDeliveryRecord)" BusinessId="@item.Id" Actor="@(Admin.User?.Username ?? "system")" /></div><div class="task-card__actions">@if (CanEdit && item.Status is not (PmsDeliveryRecordStatus.Closed or PmsDeliveryRecordStatus.Released or PmsDeliveryRecordStatus.Withdrawn)) { <button title="编辑交付记录" @onclick="() => OpenEdit(item)"><i class="fa fa-pencil"></i></button> }@if (CanStatus) { foreach (var next in NextStatuses(item)) { <button class="@(next is PmsDeliveryRecordStatus.Failed or PmsDeliveryRecordStatus.Withdrawn ? "danger" : "")" title="变更为 @StatusLabel(next)" @onclick="() => Advance(item, next)"><i class="fa fa-forward"></i></button> } }@if (CanEdit && item.Status == PmsDeliveryRecordStatus.New) { <button class="danger" title="删除交付记录" @onclick="() => Remove(item)"><i class="fa fa-trash-o"></i></button> }</div></article> }</section>
</div>

@code {
    private string Keyword = "", TypeFilterText = "", ProjectIdText = "", RequirementIdText = "", WbsTaskIdText = "", RecordNo = "", RecordTypeText = "Defect", Title = "", Owner = "", Description = "", ReviewConclusion = "", ReleaseVersion = "", ReleaseResult = "", OtherInfo = "{}"; private string? Error; private bool ShowComposer; private PmsDeliveryRecord? Editing;
    private bool CanCreate => Admin.AuthButton("Pms/Delivery/Create"); private bool CanEdit => Admin.AuthButton("Pms/Delivery/Edit"); private bool CanStatus => Admin.AuthButton("Pms/Delivery/Status");
    private PmsDeliveryRecordType? TypeFilter => Enum.TryParse<PmsDeliveryRecordType>(TypeFilterText, out var value) ? value : null;
    private IReadOnlyList<PmsDeliveryRecord> Records => DeliveryService.List(keyword: Keyword, type: TypeFilter);
    private Guid? FormProjectId => Guid.TryParse(ProjectIdText, out var id) ? id : null;
    private IReadOnlyList<PmsRequirement> RequirementsForForm => FormProjectId is Guid projectId ? RequirementService.List(projectId) : [];
    private IReadOnlyList<PmsWbsTask> WbsTasksForForm => FormProjectId is Guid projectId ? WbsTaskService.List(projectId) : [];
    protected override async Task OnInitializedAsync() { await Admin.InitAsync(); if (!Admin.AuthPath("Pms/Delivery")) Navigation.NavigateTo("/", true); }
    private void OpenCreate() { Close(); ShowComposer = true; }
    private void OpenEdit(PmsDeliveryRecord item) { Close(); Editing = item; ShowComposer = true; ProjectIdText = item.ProjectId.ToString(); RequirementIdText = item.RequirementId?.ToString() ?? ""; WbsTaskIdText = item.WbsTaskId?.ToString() ?? ""; RecordNo = item.RecordNo; RecordTypeText = item.Type.ToString(); Title = item.Title; Owner = item.OwnerName ?? ""; Description = item.Description ?? ""; ReviewConclusion = item.ReviewConclusion ?? ""; ReleaseVersion = item.ReleaseVersion ?? ""; ReleaseResult = item.ReleaseResult ?? ""; OtherInfo = item.OtherInfo; }
    private void Close() { ShowComposer = false; Editing = null; Error = null; ProjectIdText = RequirementIdText = WbsTaskIdText = RecordNo = Title = Owner = Description = ReviewConclusion = ReleaseVersion = ReleaseResult = ""; RecordTypeText = "Defect"; OtherInfo = "{}"; }
    private void Save() { if (!Guid.TryParse(ProjectIdText, out var projectId) || (!string.IsNullOrWhiteSpace(RequirementIdText) && !Guid.TryParse(RequirementIdText, out _)) || (!string.IsNullOrWhiteSpace(WbsTaskIdText) && !Guid.TryParse(WbsTaskIdText, out _))) { Error = "请选择项目并检查需求或 WBS 引用。"; return; } try { Guid? requirement = Guid.TryParse(RequirementIdText, out var requirementId) ? requirementId : null; Guid? wbs = Guid.TryParse(WbsTaskIdText, out var wbsId) ? wbsId : null; var type = Enum.Parse<PmsDeliveryRecordType>(RecordTypeText); if (Editing is null) DeliveryService.Create(projectId, requirement, wbs, RecordNo, type, Title, Description, Owner, ReviewConclusion, ReleaseVersion, ReleaseResult, OtherInfo, Admin.User?.Username); else DeliveryService.Edit(Editing, requirement, wbs, RecordNo, type, Title, Description, Owner, ReviewConclusion, ReleaseVersion, ReleaseResult, OtherInfo); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private void Advance(PmsDeliveryRecord item, PmsDeliveryRecordStatus status) { try { DeliveryService.SetStatus(item, status, "页面推进", Admin.User?.Username); } catch (Exception ex) { Error = ex.Message; } }
    private void Remove(PmsDeliveryRecord item) { try { DeliveryService.Remove(item); } catch (Exception ex) { Error = ex.Message; } }
    private static IReadOnlyList<PmsDeliveryRecordStatus> NextStatuses(PmsDeliveryRecord item) => (item.Type, item.Status) switch { (PmsDeliveryRecordType.Defect, PmsDeliveryRecordStatus.New) => [PmsDeliveryRecordStatus.InProgress], (PmsDeliveryRecordType.Defect, PmsDeliveryRecordStatus.InProgress) => [PmsDeliveryRecordStatus.Resolved], (PmsDeliveryRecordType.Defect, PmsDeliveryRecordStatus.Resolved) => [PmsDeliveryRecordStatus.Closed], (PmsDeliveryRecordType.Review, PmsDeliveryRecordStatus.New) => [PmsDeliveryRecordStatus.Passed, PmsDeliveryRecordStatus.Failed], (PmsDeliveryRecordType.Release, PmsDeliveryRecordStatus.New) => [PmsDeliveryRecordStatus.Released, PmsDeliveryRecordStatus.Withdrawn], _ => [] };
    private static string TypeLabel(PmsDeliveryRecordType value) => value switch { PmsDeliveryRecordType.Defect => "缺陷", PmsDeliveryRecordType.Review => "评审", _ => "发布" };
    private static string StatusLabel(PmsDeliveryRecordStatus value) => value switch { PmsDeliveryRecordStatus.New => "新建", PmsDeliveryRecordStatus.InProgress => "处理中", PmsDeliveryRecordStatus.Resolved => "已解决", PmsDeliveryRecordStatus.Passed => "通过", PmsDeliveryRecordStatus.Failed => "未通过", PmsDeliveryRecordStatus.Released => "已发布", PmsDeliveryRecordStatus.Withdrawn => "已撤回", _ => "已关闭" };
}
