@page "/Pms/Requirement"
@inject VelrixWorkHub.Application.PmsProjects.PmsRequirementService RequirementService
@inject VelrixWorkHub.Application.PmsProjects.PmsProjectService ProjectService
@inject VelrixWorkHub.Application.Products.ProductService ProductService
@inject AdminBlazor.IAdminContext Admin
@using VelrixWorkHub.Domain
<PageTitle>需求管理 - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMS 项目管理 · Pms/Requirement</p><h1>需求管理</h1><p class="task-page__intro">集中维护需求编号、优先级、提出/完成日期、背景价值和项目关联，支持高亮、与我相关和分页查看。</p></div></div>
    <section class="task-toolbar customer-toolbar" aria-label="需求筛选"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索需求" @bind="Keyword" @bind:event="oninput" placeholder="搜索编号、描述、提出人或负责人" /></div><select aria-label="需求项目筛选" @bind="ProjectFilterText"><option value="">全部项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select><select aria-label="需求状态筛选" @bind="StatusFilterText"><option value="">全部状态</option>@foreach (var status in Enum.GetValues<PmsRequirementStatus>()) { <option value="@status">@StatusLabel(status)</option> }</select><select aria-label="需求优先级筛选" @bind="PriorityFilterText"><option value="">全部优先级</option>@foreach (var priority in Enum.GetValues<PmsRequirementPriority>()) { <option value="@priority">@PriorityLabel(priority)</option> }</select><label class="customer-note"><input type="checkbox" @bind="RelatedOnly" /> 与我相关</label><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建需求</button></section>
    @if (SelectedProject is not null) { <div class="task-context-note" role="status">当前项目：@SelectedProject.Code · @SelectedProject.Name</div> }
    @if (ShowComposer || Editing is not null)
    {
        <section class="task-composer" aria-label="需求编辑"><div class="task-composer__title">@(Editing is null ? "新建需求" : "编辑需求")</div><div class="task-composer__fields"><label>所属项目<select aria-label="需求所属项目" @bind="ProjectIdText" disabled="@(Editing is not null)"><option value="">请选择项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select></label><label>需求编号<input aria-label="需求编号" @bind="RequirementNo" @bind:event="oninput" placeholder="REQ-002" /></label></div><div class="task-composer__fields"><label>提出人<input aria-label="需求提出人" @bind="Proposer" @bind:event="oninput" /></label><label>负责人<input aria-label="需求负责人" @bind="OwnerName" @bind:event="oninput" /></label></div><div class="task-composer__fields"><label>产品<select aria-label="需求产品" @bind="ProductIdText"><option value="">不关联产品</option>@foreach (var product in ProductService.List(status: ProductStatus.Active)) { <option value="@product.Id">@product.Code · @product.Name</option> }</select></label><label>需求类型<select aria-label="需求类型" @bind="RequirementTypeText">@foreach (var type in Enum.GetValues<PmsRequirementType>()) { <option value="@type">@RequirementTypeLabel(type)</option> }</select></label></div><div class="task-composer__fields"><label>优先级<select aria-label="需求优先级" @bind="PriorityText">@foreach (var priority in Enum.GetValues<PmsRequirementPriority>()) { <option value="@priority">@PriorityLabel(priority)</option> }</select></label><label class="customer-note"><input type="checkbox" @bind="IsHighlighted" /> 高亮需求</label></div><div class="task-composer__fields"><label>提出日期<input aria-label="需求提出日期" type="date" @bind="ProposedDate" /></label><label>希望完成日期<input aria-label="希望完成日期" type="date" @bind="DesiredCompletionDate" /></label></div><div class="task-composer__fields"><label>计划完成日期<input aria-label="需求计划完成日期" type="date" @bind="PlannedCompletionDate" /></label><label>基线 ID<input aria-label="需求基线 ID" @bind="BaselineIdText" placeholder="可选 Guid" /></label></div><div class="task-composer__fields"><label class="task-composer__field--full">需求描述<textarea aria-label="需求描述" @bind="Description" rows="3"></textarea></label></div><div class="task-composer__fields"><label class="task-composer__field--full">背景与价值<textarea aria-label="需求背景与价值" @bind="BackgroundValue" rows="3"></textarea></label></div>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存需求</button></div></section>
    }
    <section class="task-list" aria-live="polite"><div class="customer-note">共 @FilteredRequirements().Count 条，当前第 @PageNumber / @PageCount 页 <button class="task-secondary-button" @onclick="PreviousPage" disabled="@(PageNumber <= 1)">上一页</button> <button class="task-secondary-button" @onclick="NextPage" disabled="@(PageNumber >= PageCount)">下一页</button></div>@foreach (var item in PagedRequirements()) { var project = ProjectService.List().FirstOrDefault(x => x.Id == item.ProjectId); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa @(item.IsHighlighted ? "fa-lightbulb-o" : "fa-list-alt")"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Status.ToString().ToLowerInvariant()">@StatusLabel(item.Status)</span><span>@PriorityLabel(item.Priority)</span><span>@item.RequirementNo</span>@if (item.IsHighlighted) { <span>亮灯</span> }</div><h2>@item.Description</h2><p>@(project?.Code ?? "未知项目") · @RequirementTypeLabel(item.RequirementType) · 提出人 @item.Proposer · @(item.OwnerName ?? "未指定负责人")</p><div class="customer-note">提出 @item.ProposedDate.ToString("yyyy-MM-dd") · 希望完成 @(item.DesiredCompletionDate?.ToString("yyyy-MM-dd") ?? "未设置") · 计划完成 @(item.PlannedCompletionDate?.ToString("yyyy-MM-dd") ?? "未设置")</div><div class="customer-note">@(item.BackgroundValue ?? "未填写背景与价值")</div><AttachmentPanel BusinessType="PmsRequirement" BusinessId="@item.Id" Actor="admin" /></div><div class="task-card__actions"><button title="推进需求状态" @onclick="() => Advance(item)"><i class="fa fa-forward"></i></button><button title="编辑需求" @onclick="() => OpenEditor(item)"><i class="fa fa-pencil"></i></button><button class="danger" title="删除需求" @onclick="() => Remove(item)"><i class="fa fa-trash-o"></i></button></div></article> }</section>
</div>
@code {
    [SupplyParameterFromQuery(Name = "projectId")] public Guid? ProjectFilterId { get; set; }
    private string Keyword = string.Empty, ProjectFilterText = string.Empty, StatusFilterText = string.Empty, PriorityFilterText = string.Empty;
    private string ProjectIdText = string.Empty, ProductIdText = string.Empty, BaselineIdText = string.Empty, RequirementNo = string.Empty, Proposer = string.Empty, OwnerName = string.Empty, Description = string.Empty, BackgroundValue = string.Empty, OtherInfo = "{}", PriorityText = nameof(PmsRequirementPriority.Medium), RequirementTypeText = nameof(PmsRequirementType.Functional);
    private DateTime ProposedDate = DateTime.Today, DesiredCompletionDate = DateTime.Today.AddDays(14), PlannedCompletionDate = DateTime.Today.AddDays(21);
    private bool IsHighlighted, RelatedOnly, ShowComposer;
    private string? Error; private PmsRequirement? Editing; private int PageNumber = 1; private const int PageSize = 10;
    private PmsProject? SelectedProject => ProjectFilterId is Guid id ? ProjectService.List().FirstOrDefault(x => x.Id == id) : null;
    private IReadOnlyList<PmsRequirement> FilteredRequirements()
    {
        Guid? projectId = Guid.TryParse(ProjectFilterText, out var selected) ? selected : ProjectFilterId;
        PmsRequirementStatus? status = Enum.TryParse<PmsRequirementStatus>(StatusFilterText, out var parsedStatus) ? parsedStatus : null;
        PmsRequirementPriority? priority = Enum.TryParse<PmsRequirementPriority>(PriorityFilterText, out var parsedPriority) ? parsedPriority : null;
        var query = RequirementService.List(projectId, Keyword, status, priority);
        if (RelatedOnly)
        {
            var current = Admin.User?.Username?.Trim() ?? string.Empty;
            query = query.Where(x => x.Proposer.Equals(current, StringComparison.OrdinalIgnoreCase) || (x.OwnerName?.Equals(current, StringComparison.OrdinalIgnoreCase) ?? false)).ToArray();
        }
        return query;
    }
    private IReadOnlyList<PmsRequirement> PagedRequirements() => FilteredRequirements().Skip((PageNumber - 1) * PageSize).Take(PageSize).ToArray();
    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredRequirements().Count / (double)PageSize));
    private void PreviousPage() { if (PageNumber > 1) PageNumber--; }
    private void NextPage() { if (PageNumber < PageCount) PageNumber++; }
    private void OpenComposer() { Close(); ShowComposer = true; ProjectIdText = ProjectFilterId?.ToString() ?? string.Empty; }
    private void OpenEditor(PmsRequirement item) { Close(); Editing = item; ProjectIdText = item.ProjectId.ToString(); ProductIdText = item.ProductId?.ToString() ?? string.Empty; BaselineIdText = item.BaselineId?.ToString() ?? string.Empty; RequirementNo = item.RequirementNo; Proposer = item.Proposer; OwnerName = item.OwnerName ?? string.Empty; Description = item.Description; BackgroundValue = item.BackgroundValue ?? string.Empty; OtherInfo = item.OtherInfo; PriorityText = item.Priority.ToString(); RequirementTypeText = item.RequirementType.ToString(); IsHighlighted = item.IsHighlighted; ProposedDate = item.ProposedDate.ToDateTime(TimeOnly.MinValue); DesiredCompletionDate = item.DesiredCompletionDate?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today.AddDays(14); PlannedCompletionDate = item.PlannedCompletionDate?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today.AddDays(21); }
    private void Close() { ShowComposer = false; Editing = null; Error = null; ProjectIdText = ProductIdText = BaselineIdText = RequirementNo = Proposer = OwnerName = Description = BackgroundValue = string.Empty; OtherInfo = "{}"; PriorityText = nameof(PmsRequirementPriority.Medium); RequirementTypeText = nameof(PmsRequirementType.Functional); IsHighlighted = false; ProposedDate = DateTime.Today; DesiredCompletionDate = DateTime.Today.AddDays(14); PlannedCompletionDate = DateTime.Today.AddDays(21); }
    private void Save() { if (!Guid.TryParse(ProjectIdText, out var projectId) || !DateOnly.TryParse(ProposedDate.ToString("yyyy-MM-dd"), out var proposed)) { Error = "请选择项目并填写提出日期。"; return; } try { Guid? productId = Guid.TryParse(ProductIdText, out var product) ? product : null; Guid? baselineId = Guid.TryParse(BaselineIdText, out var baseline) ? baseline : null; DateOnly? desired = DesiredCompletionDate == default ? null : DateOnly.FromDateTime(DesiredCompletionDate); DateOnly? planned = PlannedCompletionDate == default ? null : DateOnly.FromDateTime(PlannedCompletionDate); var priority = Enum.Parse<PmsRequirementPriority>(PriorityText); var type = Enum.Parse<PmsRequirementType>(RequirementTypeText); if (Editing is null) RequirementService.Create(projectId, productId, baselineId, RequirementNo, IsHighlighted, Proposer, priority, type, proposed, desired, planned, Description, BackgroundValue, OwnerName, OtherInfo); else RequirementService.Edit(Editing, productId, baselineId, RequirementNo, IsHighlighted, Proposer, priority, type, proposed, desired, planned, Description, BackgroundValue, OwnerName, OtherInfo); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private void Advance(PmsRequirement item) { try { var next = item.Status switch { PmsRequirementStatus.Draft => PmsRequirementStatus.Submitted, PmsRequirementStatus.Submitted => PmsRequirementStatus.Planned, PmsRequirementStatus.Planned => PmsRequirementStatus.InProgress, PmsRequirementStatus.InProgress => PmsRequirementStatus.Completed, PmsRequirementStatus.Completed => PmsRequirementStatus.Closed, PmsRequirementStatus.Rejected => PmsRequirementStatus.Draft, _ => item.Status }; RequirementService.SetStatus(item, next); Error = null; } catch (Exception ex) { Error = ex.Message; } }
    private void Remove(PmsRequirement item) { try { RequirementService.Remove(item); } catch (Exception ex) { Error = ex.Message; } }
    private static string PriorityLabel(PmsRequirementPriority value) => value switch { PmsRequirementPriority.Low => "低", PmsRequirementPriority.Medium => "中", PmsRequirementPriority.High => "高", PmsRequirementPriority.Critical => "紧急", _ => value.ToString() };
    private static string StatusLabel(PmsRequirementStatus value) => value switch { PmsRequirementStatus.Draft => "草稿", PmsRequirementStatus.Submitted => "已提交", PmsRequirementStatus.Planned => "已计划", PmsRequirementStatus.InProgress => "进行中", PmsRequirementStatus.Completed => "已完成", PmsRequirementStatus.Rejected => "已拒绝", PmsRequirementStatus.Closed => "已关闭", _ => value.ToString() };
    private static string RequirementTypeLabel(PmsRequirementType value) => value switch { PmsRequirementType.Functional => "功能", PmsRequirementType.NonFunctional => "非功能", PmsRequirementType.Change => "变更", PmsRequirementType.Defect => "缺陷", PmsRequirementType.Other => "其他", _ => value.ToString() };
}
