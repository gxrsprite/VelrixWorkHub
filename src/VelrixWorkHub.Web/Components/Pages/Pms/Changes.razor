@page "/Pms/Change"
@inject VelrixWorkHub.Application.PmsProjects.PmsProjectChangeService ChangeService
@inject VelrixWorkHub.Application.PmsProjects.PmsProjectService ProjectService
@inject VelrixWorkHub.Application.PmsProjects.PmsProjectBaselineService BaselineService
@inject VelrixWorkHub.Application.Workflow.WorkflowBindingService WorkflowBindingService
@inject VelrixWorkHub.Application.Workflow.WorkflowApprovalService WorkflowApprovalService
@inject IAdminContext Admin
@using VelrixWorkHub.Application.Workflow
@using VelrixWorkHub.Domain
<PageTitle>项目变更 - Velrix Work Hub</PageTitle>
<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">PMS 项目管理 · Pms/Change</p><h1>项目变更</h1><p class="task-page__intro">记录项目范围和计划调整，保留变更原因、影响说明、申请人及审批状态。</p></div></div>
    <section class="task-toolbar customer-toolbar"><div class="customer-search"><i class="fa fa-search"></i><input aria-label="搜索项目变更" @bind="Keyword" @bind:event="oninput" placeholder="搜索变更标题或原因" /></div><button class="task-primary-button" @onclick="OpenComposer"><i class="fa fa-plus"></i> 新建变更</button></section>
    @if (ShowComposer) { <section class="task-composer" aria-label="新建项目变更"><div class="task-composer__title">新建项目变更</div><div class="task-composer__fields"><label>所属项目<select aria-label="变更所属项目" @bind="ProjectIdText"><option value="">请选择项目</option>@foreach (var project in ProjectService.List()) { <option value="@project.Id">@project.Code · @project.Name</option> }</select></label><label>申请人<input aria-label="变更申请人" @bind="Requester" @bind:event="oninput" placeholder="业务负责人" /></label></div><label>变更标题<input aria-label="变更标题" @bind="Title" @bind:event="oninput" placeholder="补充接口联调范围" /></label><label>变更原因<textarea aria-label="变更原因" @bind="Reason" @bind:event="oninput" rows="2"></textarea></label><label>影响说明<textarea aria-label="影响说明" @bind="Impact" @bind:event="oninput" rows="2"></textarea></label>@if (Error is not null) { <div class="task-error" role="alert">@Error</div> }<div class="task-composer__actions"><button class="task-secondary-button" @onclick="Close">取消</button><button class="task-primary-button" @onclick="Save">保存变更</button></div></section> }
    @if (!ShowComposer && Error is not null) { <div class="task-error" role="alert">@Error</div> }
    <section class="task-list" aria-live="polite">@foreach (var item in VisibleChanges) { var project = ProjectService.List().FirstOrDefault(x => x.Id == item.ProjectId); var workflow = WorkflowApprovalService.Latest(WorkflowBindingCodes.ProjectChangeApproval, nameof(PmsProjectChange), item.Id); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-exchange"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Status.ToString().ToLowerInvariant()">@StatusLabel(item.Status)</span><span>@(project?.Code ?? "未知项目")</span><span>@item.CreatedTime.ToString("yyyy-MM-dd")</span></div><h2>@item.Title</h2><p>@(item.RequesterName ?? "未指定申请人") · @item.Reason</p><div class="customer-note">影响：@(item.Impact ?? "未填写") · 审批：@(workflow is null ? "未发起" : workflow.Status switch { WorkflowInstanceStatus.Running => "审批中", WorkflowInstanceStatus.Completed => "已完成", WorkflowInstanceStatus.Rejected => "已拒绝", _ => "已撤回" })</div><AttachmentPanel BusinessType="PmsProjectChange" BusinessId="@item.Id" Actor="admin" /></div><div class="task-card__actions">@if (item.Status == PmsProjectChangeStatus.Proposed && (workflow is null || workflow.Status is WorkflowInstanceStatus.Rejected or WorkflowInstanceStatus.Cancelled)) { <button title="发起变更审批" @onclick="() => StartApproval(item)"><i class="fa fa-send-o"></i></button> } @if ((item.Status == PmsProjectChangeStatus.Proposed && workflow?.Status == WorkflowInstanceStatus.Completed) || item.Status == PmsProjectChangeStatus.Approved) { <button title="推进状态" @onclick="() => Advance(item)"><i class="fa fa-forward"></i></button> }</div></article> }</section>
</div>
@code {
    [SupplyParameterFromQuery(Name = "changeId")] public Guid? ChangeFilterId { get; set; }
    private string Keyword = string.Empty, ProjectIdText = string.Empty, Requester = string.Empty, Title = string.Empty, Reason = string.Empty, Impact = string.Empty; private string? Error; private bool ShowComposer;
    protected override async Task OnInitializedAsync() => await Admin.InitAsync();
    private void OpenComposer() { Error = null; ShowComposer = true; }
    private void Close() { ShowComposer = false; Error = null; ProjectIdText = Requester = Title = Reason = Impact = string.Empty; }
    private IEnumerable<PmsProjectChange> VisibleChanges => ChangeService.List(keyword: Keyword).Where(x => ChangeFilterId is null || x.Id == ChangeFilterId);
    private void Save() { if (!Guid.TryParse(ProjectIdText, out var projectId)) { Error = "请选择项目。"; return; } try { ChangeService.Create(projectId, Title, Reason, Impact, Requester); Close(); } catch (Exception ex) { Error = ex.Message; } }
    private void Advance(PmsProjectChange item) { try { var next = item.Status switch { PmsProjectChangeStatus.Proposed => PmsProjectChangeStatus.Approved, PmsProjectChangeStatus.Approved => PmsProjectChangeStatus.Applied, _ => item.Status }; if (next == item.Status) return; ChangeService.SetStatus(item, next); if (next == PmsProjectChangeStatus.Applied) BaselineService.Create(item.ProjectId, $"变更基线：{item.Title}"); Error = null; } catch (Exception ex) { Error = ex.Message; } }
    private string CurrentActor => Admin.User?.Username?.Trim() ?? string.Empty;
    private void StartApproval(PmsProjectChange item) { try { WorkflowBindingService.StartOrGet(WorkflowBindingCodes.ProjectChangeApproval, nameof(PmsProjectChange), item.Id, startedBy: CurrentActor); Error = null; } catch (Exception ex) { Error = ex.Message; } }
    private static string StatusLabel(PmsProjectChangeStatus status) => status switch { PmsProjectChangeStatus.Proposed => "待评估", PmsProjectChangeStatus.Approved => "已批准", PmsProjectChangeStatus.Rejected => "已驳回", PmsProjectChangeStatus.Applied => "已实施", _ => status.ToString() };
}
