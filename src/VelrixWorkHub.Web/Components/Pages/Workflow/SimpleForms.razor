@page "/Workflow/SimpleForm"
@using System.Text.Json
@using VelrixWorkHub.Application.Employees
@using VelrixWorkHub.Application.SimpleForms
@using VelrixWorkHub.Application.Workflow
@using VelrixWorkHub.Domain
@inject AdminBlazor.IAdminContext Admin
@inject NavigationManager Navigation
@inject SimpleFormService FormService
@inject EmployeeDirectoryService DirectoryService

<PageTitle>简单表单 - Velrix Work Hub</PageTitle>

<div class="customer-page">
    <div class="task-page__header"><div><p class="eyebrow">流程平台 · Workflow/SimpleForm</p><h1>简单表单</h1><p class="task-page__intro">以可视化字段编辑器维护两栏表单；发布版本冻结 JSON Schema，申请按版本快照渲染和流转。</p></div><div class="task-page__summary"><strong>@Definitions.Count</strong><span>个表单定义</span></div></div>
    <section class="task-toolbar customer-toolbar"><button class="task-primary-button" @onclick="OpenDefinition"><i class="fa fa-plus"></i> 新建表单</button></section>

    @if (ShowEditor)
    {
        <section class="task-composer" aria-label="简单表单编辑器">
            <div class="task-composer__title">@(EditingDefinition is null ? "新建简单表单" : $"编辑 {EditingDefinition.Code} 的草稿版本")</div>
            <div class="task-composer__fields"><label>表单编码<input @bind="DefinitionCode" disabled="@(EditingDefinition is not null)" maxlength="64" /></label><label>表单名称<input @bind="DefinitionName" maxlength="200" /></label></div>
            <div class="task-composer__fields"><label>绑定流程编码<input @bind="WorkflowCode" maxlength="64" placeholder="已发布 Workflow 编码" /></label><label>完成事件编码<input @bind="CompletionEventCode" maxlength="64" placeholder="NONE" /></label></div>
            <label>说明<textarea @bind="DefinitionDescription" rows="2" maxlength="2000"></textarea></label>
            <div class="task-section-heading"><h2>字段编辑</h2><span>半宽字段自动两两配对，未配对时自动占满整行</span></div>
            @foreach (var field in Fields)
            {
                <div class="task-composer" @key="field.Id"><div class="task-composer__fields"><label>字段 key<input @bind="field.Key" maxlength="64" /></label><label>显示名称<input @bind="field.Label" maxlength="100" /></label></div><div class="task-composer__fields"><label>控件<select @bind="field.Control"><option value="Text">单行文本</option><option value="MultiLineText">多行文本</option><option value="Select">下拉单选</option><option value="Radio">单选组</option><option value="MultiSelect">多选</option><option value="Checkbox">复选框</option><option value="DepartmentPicker">选部门</option><option value="PersonPicker">选人员</option><option value="ReferencePicker">选引用</option></select></label><label>宽度<select @bind="field.Width"><option value="Half">半宽</option><option value="Full">全宽</option></select></label></div><div class="task-composer__fields"><label>选项（每行 值|标签）<textarea @bind="field.OptionsText" rows="2"></textarea></label><label>引用来源<input @bind="field.Source" placeholder="Department、Person 或受控业务源" /></label></div><label>字段描述<input @bind="field.Description" maxlength="1000" /></label><div class="task-composer__actions"><label class="checkbox-field"><input type="checkbox" @bind="field.Required" /> 必填</label><button class="danger" title="删除字段" @onclick="() => Fields.Remove(field)"><i class="fa fa-trash-o"></i></button></div></div>
            }
            <div class="task-composer__actions"><button class="task-secondary-button" @onclick="AddField"><i class="fa fa-plus"></i> 添加字段</button><button class="task-secondary-button" @onclick="CloseEditor">取消</button><button class="task-primary-button" @onclick="SaveDefinition">保存草稿</button></div>
            @if (Error is not null) { <div class="task-error">@Error</div> }
        </section>
    }

    @if (ActiveSchema is not null)
    {
        <section class="task-composer" aria-label="表单填写"><div class="task-composer__title">填写 @ActiveSchema.Title</div>
            @foreach (var row in ActiveSchema.GetLayoutRows())
            { <div class="task-composer__fields">@foreach (var field in row.Fields) { <label class="@(row.IsFullWidth ? "form-field--full" : "")">@field.Label@if (field.Required) { <span> *</span> }<small>@field.Description</small>@RenderInput(field)</label> }</div> }
            <div class="task-composer__actions"><button class="task-secondary-button" @onclick="CloseSubmission">取消</button><button class="task-primary-button" @onclick="SaveSubmission">保存草稿</button></div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Error) && !ShowEditor) { <div class="task-error">@Error</div> }
    <section class="task-list"><div class="task-section-heading"><h2>表单定义</h2><span>发布版本不可编辑</span></div>@foreach (var definition in Definitions) { var latestDraft = FormService.ListVersions(definition.Id).OrderByDescending(x => x.VersionNumber).FirstOrDefault(x => x.Status == SimpleFormDefinitionVersionStatus.Draft); <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-wpforms"></i></div><div class="task-card__body"><div class="task-card__meta"><span>@definition.Code</span><span>当前发布 V@(definition.PublishedVersionNumber?.ToString() ?? "—")</span></div><h2>@definition.Name</h2><p>@definition.Description</p><div class="customer-note">流程：@definition.WorkflowDefinitionCode · 完成事件：@definition.CompletionEventCode</div></div><div class="task-card__actions">@if (latestDraft is not null) { <button title="编辑草稿" @onclick="() => OpenDraft(definition, latestDraft)"><i class="fa fa-pencil"></i></button><button title="发布表单" @onclick="() => Publish(definition, latestDraft)"><i class="fa fa-send-o"></i></button> } @if (definition.PublishedVersionNumber is not null) { <button title="填写表单" @onclick="() => OpenSubmission(definition)"><i class="fa fa-file-text-o"></i></button> }</div></article> }</section>
    <section class="task-list"><div class="task-section-heading"><h2>我的表单申请</h2></div>@foreach (var item in Submissions) { <article class="task-card customer-card"><div class="customer-avatar"><i class="fa fa-file-text-o"></i></div><div class="task-card__body"><div class="task-card__meta"><span class="task-status customer-status--@item.Status.ToString().ToLowerInvariant()">@item.Status</span><span>@item.DefinitionCode · V@(item.FormVersionNumber)</span></div><h2>@item.ApplicantName</h2><pre class="customer-note">@item.DataJson</pre><SimpleFormAttachmentPanel Submission="@item" ActorUserId="@CurrentUserId" Actor="@CurrentActor" />@if (!string.IsNullOrWhiteSpace(item.RejectionReason)) { <div class="customer-note">驳回原因：@item.RejectionReason</div> }</div><div class="task-card__actions">@if (item.Status is SimpleFormSubmissionStatus.Draft or SimpleFormSubmissionStatus.Rejected) { <button title="提交审批" @onclick="() => Submit(item)"><i class="fa fa-send-o"></i></button> } @if (item.Status is SimpleFormSubmissionStatus.Draft or SimpleFormSubmissionStatus.Submitted) { <button class="danger" title="撤回申请" @onclick="() => Cancel(item)"><i class="fa fa-undo"></i></button> }</div></article> }</section>
</div>

@code {
    private sealed class EditableField { public Guid Id { get; } = Guid.CreateVersion7(); public string Key { get; set; } = "field"; public string Label { get; set; } = "新字段"; public string? Description { get; set; } public string Control { get; set; } = "Text"; public string Width { get; set; } = "Half"; public bool Required { get; set; } public string OptionsText { get; set; } = ""; public string? Source { get; set; } }
    private bool ShowEditor; private SimpleFormDefinition? EditingDefinition; private SimpleFormDefinitionVersion? EditingVersion; private string DefinitionCode = "", DefinitionName = "", DefinitionDescription = "", WorkflowCode = "", CompletionEventCode = "NONE"; private readonly List<EditableField> Fields = []; private string? Error;
    private SimpleFormDefinition? ActiveDefinition; private SimpleFormSchema? ActiveSchema; private readonly Dictionary<string, string> Values = []; private readonly Dictionary<string, bool> Checks = []; private readonly Dictionary<string, HashSet<string>> MultiValues = [];
    private Guid CurrentUserId => Admin.User?.Id ?? Guid.Empty; private string CurrentActor => Admin.User?.Username ?? "";
    private IReadOnlyList<SimpleFormDefinition> Definitions => Admin.User is not null && Admin.AuthPath("Workflow/SimpleForm") ? FormService.ListDefinitions() : []; private IReadOnlyList<SimpleFormSubmission> Submissions => FormService.ListMine(CurrentUserId);
    protected override async Task OnInitializedAsync() { await Admin.InitAsync(); if (!Admin.AuthPath("Workflow/SimpleForm")) Navigation.NavigateTo("/", true); }
    private void AddField() => Fields.Add(new EditableField { Key = $"field_{Fields.Count + 1}" });
    private void OpenDefinition() { EditingDefinition = null; EditingVersion = null; DefinitionCode = DefinitionName = DefinitionDescription = WorkflowCode = ""; CompletionEventCode = "NONE"; Fields.Clear(); AddField(); Error = null; ShowEditor = true; }
    private void OpenDraft(SimpleFormDefinition definition, SimpleFormDefinitionVersion version) { EditingDefinition = definition; EditingVersion = version; DefinitionCode = definition.Code; DefinitionName = definition.Name; DefinitionDescription = definition.Description; WorkflowCode = definition.WorkflowDefinitionCode; CompletionEventCode = definition.CompletionEventCode; Fields.Clear(); var schema = SimpleFormSchema.Parse(version.SchemaJson); foreach (var f in schema.Fields) Fields.Add(new EditableField { Key = f.Key, Label = f.Label, Description = f.Description, Control = f.Control.ToString(), Width = f.Width.ToString(), Required = f.Required, Source = f.Source, OptionsText = string.Join("\n", (f.Options ?? []).Select(x => $"{x.Value}|{x.Label}")) }); Error = null; ShowEditor = true; }
    private void CloseEditor() { ShowEditor = false; Error = null; }
    private string BuildSchemaJson() { var fields = Fields.Select(f => new SimpleFormFieldSchema(f.Key, f.Label, f.Description, Enum.Parse<SimpleFormFieldControl>(f.Control), Enum.Parse<SimpleFormFieldWidth>(f.Width), f.Required, ParseOptions(f.OptionsText), f.Source)).ToArray(); return JsonSerializer.Serialize(new SimpleFormSchema(DefinitionName, fields), JsonSerializationDefaults.CreateWeb()); }
    private static IReadOnlyList<SimpleFormOption> ParseOptions(string text) => text.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Select(x => x.Split('|', 2, StringSplitOptions.TrimEntries)).Select(x => new SimpleFormOption(x[0], x.Length > 1 ? x[1] : x[0])).ToArray();
    private void SaveDefinition() { try { var schema = BuildSchemaJson(); if (EditingDefinition is null) FormService.CreateDefinition(DefinitionCode, DefinitionName, DefinitionDescription, WorkflowCode, CompletionEventCode, schema); else { FormService.SaveDefinition(EditingDefinition, DefinitionName, DefinitionDescription, WorkflowCode, CompletionEventCode); FormService.SaveDraftVersion(EditingVersion!, schema); } CloseEditor(); } catch (Exception ex) { Error = ex.Message; } }
    private void Publish(SimpleFormDefinition definition, SimpleFormDefinitionVersion version) { try { FormService.Publish(definition, version); Error = null; } catch (Exception ex) { Error = ex.Message; } }
    private void OpenSubmission(SimpleFormDefinition definition) { try { var version = FormService.ListVersions(definition.Id).Single(x => x.VersionNumber == definition.PublishedVersionNumber && x.Status == SimpleFormDefinitionVersionStatus.Published); ActiveDefinition = definition; ActiveSchema = SimpleFormSchema.Parse(version.SchemaJson); Values.Clear(); Checks.Clear(); MultiValues.Clear(); foreach (var field in ActiveSchema.Fields) { Values[field.Key] = ""; Checks[field.Key] = false; MultiValues[field.Key] = []; } Error = null; } catch (Exception ex) { Error = ex.Message; } }
    private void CloseSubmission() { ActiveDefinition = null; ActiveSchema = null; Error = null; }
    private void SaveSubmission() { try { if (ActiveDefinition is null || ActiveSchema is null) return; var data = new Dictionary<string, object?>(); foreach (var f in ActiveSchema.Fields) data[f.Key] = f.Control switch { SimpleFormFieldControl.Checkbox => Checks[f.Key], SimpleFormFieldControl.MultiSelect => MultiValues[f.Key].ToArray(), SimpleFormFieldControl.DepartmentPicker or SimpleFormFieldControl.PersonPicker or SimpleFormFieldControl.ReferencePicker => string.IsNullOrWhiteSpace(Values[f.Key]) ? null : new { id = Values[f.Key], label = ReferenceLabel(f, Values[f.Key]) }, _ => Values[f.Key] }; FormService.CreateSubmission(ActiveDefinition.Id, CurrentUserId, CurrentActor, JsonSerializer.Serialize(data, JsonSerializationDefaults.CreateWeb())); CloseSubmission(); } catch (Exception ex) { Error = ex.Message; } }
    private void ToggleMulti(string key, string value, ChangeEventArgs args) { if (args.Value is bool selected && selected) MultiValues[key].Add(value); else MultiValues[key].Remove(value); }
    private string ReferenceLabel(SimpleFormFieldSchema field, string id) => field.Control switch { SimpleFormFieldControl.DepartmentPicker => DirectoryService.ListOrganizations().FirstOrDefault(x => x.Id.ToString() == id)?.Name ?? id, SimpleFormFieldControl.PersonPicker => DirectoryService.List().FirstOrDefault(x => x.UserId.ToString() == id)?.DisplayName ?? id, _ => id };
    private RenderFragment RenderInput(SimpleFormFieldSchema field) => builder => { var sequence = 0; if (field.Control == SimpleFormFieldControl.MultiLineText) { builder.OpenElement(sequence++, "textarea"); builder.AddAttribute(sequence++, "rows", 3); builder.AddAttribute(sequence++, "value", Values[field.Key]); builder.AddAttribute(sequence++, "oninput", EventCallback.Factory.CreateBinder<string>(this, value => Values[field.Key] = value, Values[field.Key])); builder.CloseElement(); } else if (field.Control is SimpleFormFieldControl.Select or SimpleFormFieldControl.Radio or SimpleFormFieldControl.DepartmentPicker or SimpleFormFieldControl.PersonPicker) { builder.OpenElement(sequence++, "select"); builder.AddAttribute(sequence++, "value", Values[field.Key]); builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.CreateBinder<string>(this, value => Values[field.Key] = value, Values[field.Key])); builder.OpenElement(sequence++, "option"); builder.AddAttribute(sequence++, "value", ""); builder.AddContent(sequence++, "请选择"); builder.CloseElement(); if (field.Control == SimpleFormFieldControl.DepartmentPicker) { foreach (var option in DirectoryService.ListOrganizations()) { builder.OpenElement(sequence++, "option"); builder.AddAttribute(sequence++, "value", option.Id.ToString()); builder.AddContent(sequence++, option.Name); builder.CloseElement(); } } else if (field.Control == SimpleFormFieldControl.PersonPicker) { foreach (var option in DirectoryService.List()) { builder.OpenElement(sequence++, "option"); builder.AddAttribute(sequence++, "value", option.UserId.ToString()); builder.AddContent(sequence++, option.DisplayName); builder.CloseElement(); } } else foreach (var option in field.Options ?? []) { builder.OpenElement(sequence++, "option"); builder.AddAttribute(sequence++, "value", option.Value); builder.AddContent(sequence++, option.Label); builder.CloseElement(); } builder.CloseElement(); } else if (field.Control == SimpleFormFieldControl.MultiSelect) { foreach (var option in field.Options ?? []) { builder.OpenElement(sequence++, "label"); builder.OpenElement(sequence++, "input"); builder.AddAttribute(sequence++, "type", "checkbox"); builder.AddAttribute(sequence++, "checked", MultiValues[field.Key].Contains(option.Value)); builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => ToggleMulti(field.Key, option.Value, args))); builder.CloseElement(); builder.AddContent(sequence++, option.Label); builder.CloseElement(); } } else { builder.OpenElement(sequence++, "input"); builder.AddAttribute(sequence++, "type", field.Control == SimpleFormFieldControl.Checkbox ? "checkbox" : "text"); if (field.Control == SimpleFormFieldControl.Checkbox) { builder.AddAttribute(sequence++, "checked", Checks[field.Key]); builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.CreateBinder<bool>(this, value => Checks[field.Key] = value, Checks[field.Key])); } else { builder.AddAttribute(sequence++, "value", Values[field.Key]); builder.AddAttribute(sequence++, "oninput", EventCallback.Factory.CreateBinder<string>(this, value => Values[field.Key] = value, Values[field.Key])); } builder.CloseElement(); } };
    private void Submit(SimpleFormSubmission item) { try { FormService.SubmitAndStartWorkflow(item, CurrentUserId, CurrentActor); Error = null; } catch (Exception ex) { Error = ex.Message; } }
    private void Cancel(SimpleFormSubmission item) { try { FormService.Cancel(item, CurrentUserId, CurrentActor); Error = null; } catch (Exception ex) { Error = ex.Message; } }
}
