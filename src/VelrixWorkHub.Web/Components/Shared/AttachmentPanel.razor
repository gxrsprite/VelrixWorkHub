@using Microsoft.AspNetCore.Components.Forms
@using VelrixWorkHub.Application.Attachments
@using VelrixWorkHub.Domain
@inject AttachmentService AttachmentService
@inject IAttachmentContentStore AttachmentContentStore
@inject IAdminContext Admin

<section class="customer-note attachment-panel" aria-label="附件与版本">
    <div class="attachment-panel__header"><strong>附件 @Attachments.Count</strong><span> · 保留版本、来源与操作审计</span><button type="button" @onclick="ToggleHistory">@(ShowHistory ? "隐藏历史版本" : "显示历史版本")</button></div>
    <InputFile OnChange="Upload" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.txt" />
    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="task-error" role="alert">@Error</div> }
    @if (Attachments.Count > 0)
    {
        <div class="attachment-panel__list">
            @foreach (var item in Attachments)
            {
                <div @key="item.Id" class="attachment-panel__item"><span>V@(item.VersionNumber) · @item.FileName · @FormatSize(item.SizeBytes) · @item.UploadedBy @if (item.Status == BusinessAttachmentStatus.Deleted) { <em>已删除：@item.DeletedReason</em> }</span><span>@if (item.Status == BusinessAttachmentStatus.Active) { <a href="/api/attachments/@item.Id/download">下载</a> } @if (item.Status == BusinessAttachmentStatus.Active) { <button type="button" class="danger" title="删除附件版本" @onclick="() => Delete(item)">删除</button> }</span></div>
            }
        </div>
    }
    @if (Audits.Count > 0)
    {
        <div class="attachment-panel__audit"><strong>操作记录</strong>@foreach (var audit in Audits.Take(8)) { <span>@AuditLabel(audit.Action) · @audit.Actor · @audit.OccurredAt.ToString("yyyy-MM-dd HH:mm")</span> }</div>
    }
</section>

@code {
    [Parameter] public string BusinessType { get; set; } = string.Empty;
    [Parameter] public Guid BusinessId { get; set; }
    [Parameter] public string Actor { get; set; } = "system";
    private bool ShowHistory { get; set; }
    private IReadOnlyList<BusinessAttachment> Attachments { get; set; } = [];
    private IReadOnlyList<AttachmentAuditEntry> Audits { get; set; } = [];
    private string OtherInfo { get; set; } = "{}";
    private string? Error { get; set; }
    private string EffectiveActor => Admin.User?.Username?.Trim() is { Length: > 0 } username ? username : Actor;

    protected override void OnParametersSet() => Load();

    private void Load() { Attachments = BusinessId == Guid.Empty ? [] : AttachmentService.List(BusinessType, BusinessId, ShowHistory); Audits = BusinessId == Guid.Empty ? [] : AttachmentService.Audit(BusinessId); }

    private void ToggleHistory() { ShowHistory = !ShowHistory; Load(); }

    private async Task Upload(InputFileChangeEventArgs args)
    {
        Error = null;
        var file = args.File;
        if (file is null) return;
        try
        {
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            await AttachmentService.UploadAsync(BusinessType, BusinessId, file.Name, file.ContentType, stream, EffectiveActor, AttachmentContentStore, otherInfo: OtherInfo);
            OtherInfo = "{}";
            Load();
        }
        catch (Exception ex) { Error = ex.Message; }
    }

    private void Delete(BusinessAttachment item)
    {
        try { AttachmentService.Delete(item, EffectiveActor, "用户从业务对象附件面板删除"); Load(); }
        catch (Exception ex) { Error = ex.Message; }
    }

    private static string FormatSize(long size) => size switch { < 1024 => $"{size} B", < 1024 * 1024 => $"{size / 1024d:0.0} KB", _ => $"{size / 1024d / 1024d:0.0} MB" };
    private static string AuditLabel(AttachmentAuditAction action) => action switch { AttachmentAuditAction.Uploaded => "上传", AttachmentAuditAction.Downloaded => "下载", AttachmentAuditAction.Deleted => "删除", _ => action.ToString() };
}
