@namespace BootstrapBlazor.Components
@typeparam TItem
@typeparam TValue

<div class="input-table2">
    <div class="input-group">
        <input class="@InputClass" value="@CurrentText" placeholder="@Placeholder" readonly disabled="@Disabled" />
        <SelectTable2 TItem="TItem" TValue="TValue"
                      Items="Items"
                      Value="Value"
                      ValueChanged="OnValueChangedAsync"
                      ValueSelector="ValueSelector"
                      TextSelector="TextSelector"
                      TableHeader="TableHeader"
                      TableRow="TableRow"
                      Title="@Title"
                      ButtonText="@ButtonText"
                      ButtonClass="btn btn-outline-secondary"
                      SizeClass="@SizeClass"
                      SearchPlaceholder="@SearchPlaceholder"
                      ConfirmText="@ConfirmText"
                      CancelText="@CancelText"
                      ClearText="@ClearText"
                      NoDataText="@NoDataText"
                      Disabled="@Disabled"
                      AllowClear="@AllowClear"
                      IsSearchText="@IsSearchText"
                      ColumnCount="@ColumnCount" />
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter, EditorRequired] public Func<TItem, TValue> ValueSelector { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> TextSelector { get; set; } = default!;
    [Parameter] public RenderFragment? TableHeader { get; set; }
    [Parameter] public RenderFragment<TItem>? TableRow { get; set; }
    [Parameter] public string Title { get; set; } = "选择数据";
    [Parameter] public string ButtonText { get; set; } = "选择";
    [Parameter] public string Placeholder { get; set; } = "请选择";
    [Parameter] public string InputClass { get; set; } = "form-control";
    [Parameter] public string SizeClass { get; set; } = "modal-xl";
    [Parameter] public string SearchPlaceholder { get; set; } = "搜索";
    [Parameter] public string ConfirmText { get; set; } = "确定";
    [Parameter] public string CancelText { get; set; } = "取消";
    [Parameter] public string ClearText { get; set; } = "清空";
    [Parameter] public string NoDataText { get; set; } = "暂无数据";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool IsSearchText { get; set; } = true;
    [Parameter] public int ColumnCount { get; set; } = 1;

    private string CurrentText
    {
        get
        {
            var selected = Items.FirstOrDefault(item => EqualityComparer<TValue>.Default.Equals(ValueSelector(item), Value));
            return selected == null ? "" : TextSelector(selected);
        }
    }

    private async Task OnValueChangedAsync(TValue value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
