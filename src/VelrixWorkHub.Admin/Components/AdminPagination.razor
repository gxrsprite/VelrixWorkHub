@namespace BootstrapBlazor.Components

@if (Total > 0)
{
    <div class="@CssClass">
        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm w-auto"
                    value="@PageSize.ToString()"
                    disabled="@Disabled"
                    @onchange="ChangePageSizeAsync">
                @foreach (var size in NormalizedPageSizes)
                {
                    <option value="@size">@size</option>
                }
            </select>
            <span class="text-muted small">@string.Format(TotalText, Total)</span>
        </div>

        @if (MaxPage > 1)
        {
            <nav aria-label="@AriaLabel">
                <ul class="pagination pagination-sm mb-0">
                    <li class="@GetPageItemClass(PageNumber <= 1)">
                        <button type="button" class="page-link" disabled="@(Disabled || PageNumber <= 1)" @onclick="() => ChangePageAsync(1)">@FirstText</button>
                    </li>
                    <li class="@GetPageItemClass(PageNumber <= 1)">
                        <button type="button" class="page-link" disabled="@(Disabled || PageNumber <= 1)" @onclick="() => ChangePageAsync(PageNumber - 1)">@PreviousText</button>
                    </li>
                    @foreach (var pageNumber in VisiblePages)
                    {
                        <li class="page-item @(pageNumber == PageNumber ? "active" : "")">
                            <button type="button" class="page-link" disabled="@Disabled" @onclick="() => ChangePageAsync(pageNumber)">@pageNumber</button>
                        </li>
                    }
                    <li class="@GetPageItemClass(PageNumber >= MaxPage)">
                        <button type="button" class="page-link" disabled="@(Disabled || PageNumber >= MaxPage)" @onclick="() => ChangePageAsync(PageNumber + 1)">@NextText</button>
                    </li>
                    <li class="@GetPageItemClass(PageNumber >= MaxPage)">
                        <button type="button" class="page-link" disabled="@(Disabled || PageNumber >= MaxPage)" @onclick="() => ChangePageAsync(MaxPage)">@LastText</button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@code {
    private static readonly int[] DefaultPageSizes = [10, 20, 30, 50, 100];

    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public EventCallback<int> PageNumberChanged { get; set; }
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public long Total { get; set; }
    [Parameter] public int WindowSize { get; set; } = 7;
    [Parameter] public IEnumerable<int>? PageSizes { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string CssClass { get; set; } = "admin-pagination card-footer d-flex justify-content-between align-items-center gap-2 flex-wrap";
    [Parameter] public string TotalText { get; set; } = "Total {0}";
    [Parameter] public string FirstText { get; set; } = "«";
    [Parameter] public string PreviousText { get; set; } = "‹";
    [Parameter] public string NextText { get; set; } = "›";
    [Parameter] public string LastText { get; set; } = "»";
    [Parameter] public string AriaLabel { get; set; } = "Pagination";

    private int SafePageSize => PageSize <= 0 ? DefaultPageSizes[0] : PageSize;

    private int MaxPage => Math.Max(1, (int)Math.Ceiling((double)Math.Max(0, Total) / SafePageSize));

    private int[] NormalizedPageSizes => (PageSizes ?? DefaultPageSizes)
        .Where(x => x > 0)
        .Append(SafePageSize)
        .Distinct()
        .OrderBy(x => x)
        .ToArray();

    private IReadOnlyList<int> VisiblePages => BuildPageWindow(PageNumber, MaxPage, WindowSize);

    public static IReadOnlyList<int> BuildPageWindow(int pageNumber, int maxPage, int windowSize)
    {
        if (maxPage <= 0)
            return Array.Empty<int>();

        windowSize = Math.Clamp(windowSize, 1, maxPage);
        pageNumber = Math.Clamp(pageNumber, 1, maxPage);

        var half = windowSize / 2;
        var start = pageNumber - half;
        var end = start + windowSize - 1;

        if (start < 1)
        {
            end += 1 - start;
            start = 1;
        }

        if (end > maxPage)
        {
            start = Math.Max(1, start - (end - maxPage));
            end = maxPage;
        }

        return Enumerable.Range(start, end - start + 1).ToArray();
    }

    private async Task ChangePageAsync(int page)
    {
        if (Disabled)
            return;

        var nextPage = Math.Clamp(page, 1, MaxPage);
        if (nextPage == PageNumber)
            return;

        PageNumber = nextPage;
        await PageNumberChanged.InvokeAsync(PageNumber);
        await OnChanged.InvokeAsync();
    }

    private async Task ChangePageSizeAsync(ChangeEventArgs e)
    {
        if (Disabled || !int.TryParse(e.Value?.ToString(), out var size) || size <= 0)
            return;

        PageSize = size;
        PageNumber = 1;
        await PageSizeChanged.InvokeAsync(PageSize);
        await PageNumberChanged.InvokeAsync(PageNumber);
        await OnChanged.InvokeAsync();
    }

    private string GetPageItemClass(bool disabled)
    {
        return $"page-item {(disabled ? "disabled" : "")}";
    }
}
