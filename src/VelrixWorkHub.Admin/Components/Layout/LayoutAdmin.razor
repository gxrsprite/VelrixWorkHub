@inherits LayoutComponentBase
@inject IAdminContext Admin
@inject NavigationManager Navigation

<CascadingValue Value="Admin">
<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="sidebar-brand px-3 py-3">
            <h5 class="mb-0 text-white">@(Admin.Tenant?.Title ?? "AdminBlazor")</h5>
            <small class="text-white-50">管理后台</small>
        </div>
        <nav class="nav flex-column px-2">
            @foreach (var menu in Admin.RoleMenus)
            {
                if (menu.Children?.Count > 0)
                {
                    <div class="nav-section-title px-2 py-2 mt-2">
                        <small class="text-white-50 text-uppercase fw-bold">@menu.Label</small>
                    </div>
                    @foreach (var child in menu.Children.Where(c => c.Type == SysMenuType.菜单))
                    {
                        <NavLink class="nav-link" href="@child.Path" Match="@GetMatch(child.Path)">
                            <i class="fa fa-circle-o me-2"></i> @child.Label
                        </NavLink>
                    }
                }
                else if (menu.Type == SysMenuType.菜单)
                {
                    <NavLink class="nav-link" href="@menu.Path" Match="@GetMatch(menu.Path)">
                        <i class="fa fa-circle-o me-2"></i> @menu.Label
                    </NavLink>
                }
            }
        </nav>
    </aside>
    <main class="admin-main">
        <div class="admin-topbar px-3 py-2 d-flex justify-content-between align-items-center">
            <div></div>
            <div class="d-flex align-items-center">
                @if (Admin.User != null)
                {
                    <span class="me-3">@(Admin.User.Nickname ?? Admin.User.Username)</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">退出</button>
                }
                else
                {
                    <a href="/Login" class="btn btn-sm btn-outline-light">登录</a>
                }
            </div>
        </div>
        <div class="admin-content p-3">
            @Body
        </div>
    </main>
</div>
</CascadingValue>

<style>
.admin-layout { display: flex; min-height: 100vh; }
.admin-sidebar { width: 220px; background: linear-gradient(135deg, var(--main-color-secondary, #1D3A3A) 0%, var(--main-color-primary, #205656) 100%); color: #fff; flex-shrink: 0; overflow-y: auto; }
.admin-main { flex: 1; display: flex; flex-direction: column; background: #f8f9fe; min-width: 0; }
.admin-topbar { background: #fff; border-bottom: 1px solid #e9ecef; min-height: 48px; }
.admin-content { flex: 1; }
.sidebar-brand { border-bottom: 1px solid rgba(255,255,255,0.15); }
.sidebar-brand h5 { color: #fff; }
.nav-link { color: rgba(255,255,255,0.75); padding: 0.5rem 0.75rem; border-radius: 6px; margin-bottom: 2px; font-size: 0.9rem; transition: all 0.15s ease; }
.nav-link:hover { color: #fff; background-color: rgba(255,255,255,0.1); }
.nav-link.active { color: #fff; background-color: rgba(255,255,255,0.2); font-weight: 600; }
.nav-section-title small { color: rgba(255,255,255,0.5) !important; letter-spacing: 0.05em; }
@@media (max-width: 768px) { .admin-sidebar { display: none; } }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        try { await Admin.InitAsync(); }
        catch (Exception ex) { System.Console.WriteLine($"[LayoutAdmin] InitAsync failed: {ex.Message}"); }
        if (Admin.User == null)
        {
            Navigation.NavigateTo("/Login", forceLoad: true);
            return;
        }

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        if (path.StartsWith("Admin/", StringComparison.OrdinalIgnoreCase)
            && !path.Equals("Admin/UserProfile", StringComparison.OrdinalIgnoreCase)
            && !Admin.AuthPath(path))
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private void LogoutAsync()
    {
        Admin.SignOut();
        Navigation.NavigateTo("/api/admin/logout", forceLoad: true);
    }

    private static NavLinkMatch GetMatch(string? path)
    {
        return string.IsNullOrEmpty(path) ? NavLinkMatch.All : NavLinkMatch.Prefix;
    }
}
