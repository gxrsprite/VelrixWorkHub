@page "/Admin/NotificationFailures"
@using VelrixWorkHub.Application.Notifications
@using VelrixWorkHub.Domain
@inject INotificationFailureRepository FailureRepository
@inject INotificationFailureAuditRepository FailureAuditRepository
@inject NotificationFailureRetryService RetryService
@inject IAdminContext Admin
@inject NavigationManager Navigation

<PageTitle>通知失败处置</PageTitle>

<div class="container-fluid p-3">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1">通知失败处置</h5>
                <small class="text-muted">只展示失败元数据，不展示可重放正文；自动 Worker 仍会继续重试。</small>
            </div>
            <div class="d-flex gap-2">
                @if (CanBatchRetry) { <button class="btn btn-primary btn-sm" disabled="@(_selected.Count == 0 || _batchBusy)" @onclick="RetrySelected">批量重试（@_selected.Count）</button> }
                <button class="btn btn-outline-secondary btn-sm" @onclick="Reload">刷新</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") m-3 mb-0">@_message</div>
        }
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                    <thead><tr><th></th><th>接收人</th><th>操作</th><th>去重键</th><th>错误</th><th>重试次数</th><th>最后尝试</th><th>最近处置</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td><input type="checkbox" checked="@_selected.Contains(item.Id)" @onchange="e => Toggle(item.Id, e.Value is true)" disabled="@(!CanBatchRetry || _batchBusy)" /></td>
                            <td>@item.Recipient</td><td>@item.Operation</td><td><code>@item.DedupeKey</code></td><td>@item.Error</td>
                            <td><span class="badge @(item.RetryCount >= 3 ? "bg-danger" : "bg-secondary")">@item.RetryCount</span></td>
                            <td>@(item.LastRetryAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>
                                @if (LatestAudit(item.Id) is { } audit)
                                {
                                    <span class="badge @(audit.Action == "ManualRetrySucceeded" ? "bg-success" : "bg-warning text-dark")">@(audit.Action == "ManualRetrySucceeded" ? "成功" : "失败")</span>
                                    <small class="d-block text-muted">@audit.Actor · @audit.OccurredAt.ToString("MM-dd HH:mm")</small>
                                }
                                else
                                {
                                    <span class="text-muted">自动重试/暂无人工处置</span>
                                }
                            </td>
                            <td><button class="btn btn-sm btn-primary" disabled="@(!CanRetry || _busyId == item.Id)" @onclick="() => Retry(item.Id)">@(_busyId == item.Id ? "处理中" : "手动重试")</button></td>
                        </tr>
                    }
                    @if (_items.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">暂无待处理的通知失败记录</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<PersistedNotificationFailure> _items = [];
    private IReadOnlyList<NotificationFailureAuditEntry> _audits = [];
    private Guid? _busyId;
    private string? _message;
    private bool _isError;
    private bool CanRetry => Admin.AuthButton("Admin/NotificationFailures/Retry");
    private bool CanBatchRetry => Admin.AuthButton("Admin/NotificationFailures/BatchRetry");
    private HashSet<Guid> _selected = [];
    private bool _batchBusy;

    protected override async Task OnInitializedAsync()
    {
        await Admin.InitAsync();
        if (!Admin.AuthPath("Admin/NotificationFailures"))
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        Reload();
    }

    private void Reload()
    {
        _items = FailureRepository.ListPending(200).OrderByDescending(x => x.RetryCount).ThenBy(x => x.OccurredAt).ToArray();
        _audits = FailureAuditRepository.List(take: 500);
        _selected.RemoveWhere(id => !_items.Any(item => item.Id == id));
    }

    private NotificationFailureAuditEntry? LatestAudit(Guid failureId)
        => _audits.Where(item => item.FailureId == failureId).OrderByDescending(item => item.OccurredAt).FirstOrDefault();

    private void Toggle(Guid id, bool selected)
    {
        if (selected) _selected.Add(id); else _selected.Remove(id);
    }

    private void RetrySelected()
    {
        if (_selected.Count == 0) return;
        _batchBusy = true;
        try
        {
            var result = RetryService.RetryMany(_selected, Admin.User?.Username ?? string.Empty, DateTime.Now);
            _isError = result.FailedCount > 0;
            _message = $"批量重试完成：请求 {result.RequestedCount} 条，成功 {result.ResolvedCount} 条，失败 {result.FailedCount} 条。";
            _selected.Clear();
            Reload();
        }
        catch (Exception ex) { _isError = true; _message = ex.Message; }
        finally { _batchBusy = false; }
    }

    private void Retry(Guid id)
    {
        _busyId = id;
        try
        {
            if (!RetryService.Retry(id, DateTime.Now, Admin.User?.Username)) { _isError = true; _message = "失败记录不存在、已处理或重试失败。"; return; }
            _isError = false; _message = "通知已重新投递。"; Reload();
        }
        catch (Exception ex) { _isError = true; _message = ex.Message; }
        finally { _busyId = null; }
    }
}
