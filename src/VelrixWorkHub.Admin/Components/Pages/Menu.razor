@page "/Admin/Menu"


<PageTitle>菜单管理</PageTitle>

<AdminTable2 TItem="SysMenu" PageSize="-1" Title="菜单管理" IsSearchText="false" IsMultiSelect="false"
    IsTree="true" HasChildren="HasChildren" TreeKeySelector="m => m.Id" OnAfterLoad="BuildTreeLevels"
    OnQuery="OnQueryMenu" InitQuery="InitQueryMenu" OnEdit="OnEditMenu" OnSaving="OnSavingMenu" OnRemoving="OnRemovingMenu">
    <TableTh1>名称</TableTh1>
    <TableTd1>
        <span class="@(context.Type == SysMenuType.菜单 ? "fw-bold" : "text-muted")">
            <i class="@(!string.IsNullOrEmpty(context.Icon) ? context.Icon : (context.Type == SysMenuType.按钮 ? "fa fa-circle-o text-muted" : "fa fa-folder-o"))"></i>
            @context.Label
        </span>
    </TableTd1>
    <TableHeader>
        <AdminSortHeader Field="Path">路径</AdminSortHeader>
        <AdminSortHeader Field="Type">类型</AdminSortHeader>
        <AdminSortHeader Field="Sort">排序</AdminSortHeader>
        <AdminSortHeader Field="IsHidden">隐藏</AdminSortHeader>
    </TableHeader>
    <TableRow>
        <td>@context.Path</td>
        <td>@context.Type</td>
        <td>@context.Sort</td>
        <td>@(context.IsHidden ? "是" : "否")</td>
    </TableRow>
    <EditTemplate>
        <div class="row">
            <div class="form-group col-6">
                <label class="form-label">名称</label>
                <input @bind="context.Label" @bind:event="oninput" type="text" class="form-control" maxlength="50" />
            </div>
            <div class="form-group col-6">
                <label class="form-label">路径</label>
                <input @bind="context.Path" @bind:event="oninput" type="text" class="form-control" maxlength="200" />
            </div>
            <div class="form-group col-6">
                <label class="form-label">图标</label>
                <input @bind="context.Icon" @bind:event="oninput" type="text" class="form-control" maxlength="50" placeholder="fa fa-user" />
            </div>
            <div class="form-group col-6">
                <label class="form-label">类型</label>
                <SelectEnum TEnum="SysMenuType" @bind-Value="context.Type" />
            </div>
            <div class="form-group col-6">
                <label class="form-label">排序</label>
                <input @bind="context.Sort" @bind:event="oninput" type="number" class="form-control" />
            </div>
            <div class="form-group col-6">
                <label class="form-label">隐藏</label>
                <Switch @bind-Value="context.IsHidden" />
            </div>
            <div class="form-group col-12">
                <label class="form-label">备注</label>
                <textarea @bind="context.Description" @bind:event="oninput" class="form-control" maxlength="500"></textarea>
            </div>
        </div>
    </EditTemplate>
</AdminTable2>

@code {
    [Inject] IFreeSql fsql { get; set; } = default!;

    private List<SysMenu> _allMenus = new();

    async Task InitQueryMenu(AdminQueryInfo e)
    {
        e.Filters = new AdminFilterInfo[]
        {
            new AdminFilterInfo { Label = "类型", QueryStringName = "Type", Col = 6,
                Options = Enum.GetValues<SysMenuType>().Select(t => new AdminOptions { Label = t.ToString(), Text = t.ToString(), Value = (int)t }).ToArray() },
        };
        await Task.CompletedTask;
    }

    void OnQueryMenu(AdminQueryEventArgs<SysMenu> e)
    {
        var filter = e.Filters[0];
        if (filter.HasValue)
        {
            var type = filter.Value<SysMenuType>();
            e.Select.Where(a => a.Type == type);
        }
    }

    void BuildTreeLevels(List<AdminItem<SysMenu>> items)
    {
        _allMenus = items.Select(i => i.Value).ToList();

        var sorted = new List<AdminItem<SysMenu>>();
        Traverse(Guid.Empty, 1, items, sorted);

        var includedIds = sorted.Select(i => i.Value.Id).ToHashSet();
        foreach (var item in items.Where(i => !includedIds.Contains(i.Value.Id)).OrderBy(i => i.Value.Sort))
        {
            item.Level = 1;
            sorted.Add(item);
        }

        items.Clear();
        items.AddRange(sorted);
    }

    void Traverse(Guid parentId, int level,
        List<AdminItem<SysMenu>> source, List<AdminItem<SysMenu>> result)
    {
        var children = source
            .Where(i => i.Value.ParentId == parentId)
            .OrderBy(i => i.Value.Sort)
            .ToList();

        foreach (var child in children)
        {
            child.Level = level;
            result.Add(child);
            Traverse(child.Value.Id, level + 1, source, result);
        }
    }

    bool HasChildren(SysMenu menu) => _allMenus.Any(m => m.ParentId == menu.Id);

    Task OnEditMenu(SysMenu item) => Task.CompletedTask;

    async Task OnSavingMenu(AdminConfirmEventArgs<SysMenu> e)
    {
        if (string.IsNullOrWhiteSpace(e.Argument.Label))
        {
            e.Cancel = true;
            return;
        }
        await Task.CompletedTask;
    }

    async Task OnRemovingMenu(List<SysMenu> items)
    {
        items.RemoveAll(m => m.IsSystem);
        items.RemoveAll(m => _allMenus.Any(child => child.ParentId == m.Id));
        await Task.CompletedTask;
    }
}
